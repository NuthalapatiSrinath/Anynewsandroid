xt="మధ్యప్రదేశ్‌లోని శివపురి రైల్వే స్టేషన్‌లో ప్రమాదం తప్పింది. రైలు ఎక్కేందుకు ప్రయత్నించిన ఓ మహిళ అదుపుతప్పి రైలు, ప్లాట్‌ఫామ్‌ మధ్య జారిపోయింది. వెంటనే అప్రమత్తమైన ఏఎస్ఐ ఆమెను బయటకు లాగి సురక్షితంగా కాపాడారు. ప్రమాదం నుంచి మహిళ క్షేమంగా బయటపడటంతో అంతా ఊపిరిపీల్చుకున్నారు. ఘటనకు సంబంధించిన దృశ్యాలు సోషల్‌ మీడియాలో వైరల్‌గా మారాయి." resource-id="com.anyNews.anynews:id/half_content_description__" class="android.widget.TextView" package="com.anyNews.anynews" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,1262][1080,2069]" drawing-order="5" hint="" /></node></node></node><node index="1" text="" resource-id="com.anyNews.anynews:id/ll_footer_layout" class="android.widget.LinearLayout" package="com.anyNews.anynews" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,2069][1080,2206]" drawing-order="2" hint=""><node index="0" text="" resource-id="com.anyNews.anynews:id/writer_profile_image" class="android.widget.LinearLayout" package="com.anyNews.anynews" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,2069][102,2206]" drawing-order="1" hint=""><node NAF="true" index="0" text="" resource-id="com.anyNews.anynews:id/writer_profile_pic" class="android.widget.ImageView" package="com.anyNews.anynews" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,2069][102,2206]" drawing-order="1" hint="" /></node><node index="1" text="" resource-id="" class="android.widget.LinearLayout