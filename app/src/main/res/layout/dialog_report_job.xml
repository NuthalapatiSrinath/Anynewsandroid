<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/white"
    android:orientation="vertical"
    android:padding="18dp">

    <TextView
        android:id="@+id/report_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#FF0F172A"
        android:textSize="18sp"
        android:textStyle="bold"
        tools:text="Report Job" />

    <TextView
        android:id="@+id/report_reason_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:textColor="#FF334155"
        android:textSize="13sp"
        tools:text="Please provide a reason…" />

    <EditText
        android:id="@+id/report_reason"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_jobs_input"
        android:gravity="top|start"
        android:hint="Enter your reason here..."
        android:inputType="textMultiLine"
        android:padding="10dp"
        android:textColor="#FF0F172A"
        android:textColorHint="#FF94A3B8"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/report_mobile_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColor="#FF334155"
        android:textSize="13sp"
        tools:text="Mobile number:" />

    <EditText
        android:id="@+id/report_mobile"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_jobs_input"
        android:hint="Enter your mobile number"
        android:inputType="phone"
        android:maxLines="1"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:textColor="#FF0F172A"
        android:textColorHint="#FF94A3B8"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="end"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/report_close"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/bg_jobs_report_close"
            android:gravity="center"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:text="Close"
            android:textColor="#FFFFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/report_submit"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_jobs_report_submit"
            android:gravity="center"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:text="Submit"
            android:textColor="#FFFFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
