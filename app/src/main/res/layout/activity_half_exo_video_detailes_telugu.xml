<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:id="@+id/parent_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/white"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="10"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/relative_half_contents"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="8.5"
                    android:background="@color/white"
                    android:orientation="vertical">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/layoutParentTop"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="#000000">

                        <TextView
                            android:id="@+id/textViewTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_marginTop="16dp"
                            android:layout_marginEnd="8dp"
                            android:letterSpacing="-0.02"
                            android:lineSpacingExtra="5sp"
                            android:text="TextView"
                            android:textColor="@color/colorAccent"
                            android:textSize="18sp"
                            android:visibility="gone"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <RelativeLayout
                            android:id="@+id/exo_play_layout"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <androidx.media3.ui.PlayerView
                                android:id="@+id/normal_video_player"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                app:controller_layout_id="@layout/player_custom_ui"
                                app:default_artwork="@color/black"
                                app:layout_constraintTop_toTopOf="parent"
                                app:resize_mode="fill"
                                app:surface_type="texture_view"
                                app:use_controller="true" />

                            <ImageView
                                android:id="@+id/thaumbnail_for_video"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_centerInParent="true"
                                android:adjustViewBounds="true"
                                android:scaleType="fitXY" />

                            <ProgressBar
                                android:id="@+id/progress_bar_for_video"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_centerInParent="true"
                                android:layout_marginBottom="150dp"
                                android:indeterminateTint="@color/red"
                                android:progressBackgroundTint="@color/red"
                                android:visibility="gone" />

                            <ImageView
                                android:id="@+id/imageViewVideoPlayVideo"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_centerInParent="true"
                                android:clickable="true"
                                android:focusable="true"
                                android:src="@drawable/ic_video_play"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent" />

                            <TextView
                                android:id="@+id/textViewWebUrl"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentStart="true"
                                android:layout_alignParentBottom="true"
                                android:layout_marginLeft="@dimen/_12sdp"
                                android:layout_marginBottom="10dp"
                                android:background="@drawable/url_background"
                                android:padding="5dp"
                                android:text="anws.co/78787878"
                                android:textColor="@color/on_brand_text"
                                android:textSize="8dp" />

                        </RelativeLayout>


                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <!--middle content like comment share-->
                    <LinearLayout
                        android:id="@+id/layoutParentMiddle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="-15dp"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:minHeight="44dp"
                        android:orientation="horizontal"
                        android:visibility="visible">


                        <LinearLayout
                            android:id="@+id/with_out_strips_layout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:clipChildren="false"
                            android:clipToPadding="false"
                            android:gravity="top|end"
                            android:orientation="horizontal"
                            android:paddingEnd="8dp"
                            android:visibility="visible">

                            <View
                                android:layout_width="0dp"
                                android:layout_height="1dp"
                                android:layout_weight="1" />

                            <LinearLayout
                                android:id="@+id/half_image_like_icon"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="12dp"
                                android:clipChildren="false"
                                android:clipToPadding="false"
                                android:gravity="center_horizontal"
                                android:orientation="vertical">

                                <ImageView
                                    android:id="@+id/half_image_like"
                                    android:layout_width="40dp"
                                    android:layout_height="40dp"
                                    android:background="@drawable/bg_action_ring"
                                    android:contentDescription="@string/like_image"
                                    android:padding="9dp"
                                    android:src="@drawable/ic_action_like" />

                                <TextView
                                    android:id="@+id/half_like_count"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="3dp"
                                    android:fontFamily="@font/roboto_medium"
                                    android:gravity="center"
                                    android:textColor="@color/text_color_primary"
                                    android:textSize="11sp"
                                    android:textStyle="bold"
                                    android:visibility="gone" />

                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/half_comment"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="12dp"
                                android:clipChildren="false"
                                android:clipToPadding="false"
                                android:gravity="center_horizontal"
                                android:orientation="vertical">

                                <ImageView
                                    android:id="@+id/half_comment_icon"
                                    android:layout_width="40dp"
                                    android:layout_height="40dp"
                                    android:background="@drawable/bg_action_ring"
                                    android:contentDescription="@string/comment_image"
                                    android:padding="9dp"
                                    android:src="@drawable/ic_action_comment" />

                                <TextView
                                    android:id="@+id/half_comment_count"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="3dp"
                                    android:fontFamily="@font/roboto_medium"
                                    android:gravity="center"
                                    android:textColor="@color/text_color_primary"
                                    android:textSize="11sp"
                                    android:textStyle="bold"
                                    android:visibility="gone" />

                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/half_share__"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="12dp"
                                android:clipChildren="false"
                                android:clipToPadding="false"
                                android:gravity="center_horizontal"
                                android:orientation="vertical">

                                <ImageView
                                    android:id="@+id/share"
                                    android:layout_width="40dp"
                                    android:layout_height="40dp"
                                    android:background="@drawable/bg_action_ring"
                                    android:contentDescription="@string/share_image"
                                    android:padding="9dp"
                                    android:src="@drawable/ic_action_share" />

                                <TextView
                                    android:id="@+id/half_share_count"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="3dp"
                                    android:fontFamily="@font/roboto_medium"
                                    android:gravity="center"
                                    android:textColor="@color/text_color_primary"
                                    android:textSize="11sp"
                                    android:textStyle="bold"
                                    android:visibility="gone" />

                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/report"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="4dp"
                                android:gravity="center_horizontal"
                                android:orientation="vertical">

                                <ImageView
                                    android:id="@+id/video_report"
                                    android:layout_width="40dp"
                                    android:layout_height="40dp"
                                    android:background="@drawable/bg_action_ring"
                                    android:padding="9dp"
                                    android:src="@drawable/ic_action_report" />

                            </LinearLayout>

                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/with_strips_layout"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/ic_half_image_strike_icon"
                            android:orientation="horizontal"
                            android:paddingLeft="@dimen/_15sdp"
                            android:visibility="visible">

                            <ImageView
                                android:id="@+id/with_strips_layout_ic"
                                android:layout_width="30dp"
                                android:layout_height="30dp"
                                android:layout_gravity="center"
                                android:layout_marginStart="1sp"
                                android:src="@drawable/app_share_logo" />

                            <LinearLayout
                                android:layout_width="@dimen/_65sdp"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:layout_marginLeft="5dp"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:background="@drawable/text_bg_red"
                                    android:fontFamily="@font/inter_black"
                                    android:gravity="center"
                                    android:text="ANYNEWS"
                                    android:textColor="@color/colorPrimary"
                                    android:textFontWeight="200"
                                    android:textSize="@dimen/_10sdp" />

                                <TextView
                                    android:id="@+id/textViewStripWebUrl"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:fontFamily="@font/roboto_medium"
                                    android:text="anws.in/934890"
                                    android:textColor="@color/content_title_color"
                                    android:textFontWeight="400"
                                    android:textSize="8dp" />

                            </LinearLayout>


                            <TextView
                                android:id="@+id/strip_text_name"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_marginStart="2sp"
                                android:layout_weight="6"
                                android:fontFamily="@font/roboto_bold"
                                android:gravity="center|left"
                                android:paddingLeft="@dimen/_10sdp"
                                android:text="The Best Regional News App"
                                android:textColor="@color/colorPrimary"
                                android:textSize="@dimen/_12sdp"
                                android:textStyle="bold"
                                android:visibility="visible"
                                tools:ignore="RtlHardcoded">

                            </TextView>

                            <ImageView
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_marginTop="@dimen/ten"
                                android:layout_marginRight="@dimen/ten"
                                android:layout_weight="3"
                                android:gravity="left|center"
                                android:scaleType="fitXY"
                                android:src="@drawable/ic_download_now_icon"
                                android:visibility="gone">

                            </ImageView>

                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/layoutParentTitle"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="4.5">

                        <RelativeLayout
                            android:id="@+id/relativeBottom"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_below="@id/parent_off_image"
                            android:background="@color/white">

                    <TextView
                        android:id="@+id/half_content_title__"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:autoSizePresetSizes="12dp"
                        android:autoSizeTextType="none"
                        android:ellipsize="end"
                        android:fontFamily="@font/sreekrushnadevaraya_regular"
                        android:gravity="start"
                        android:layout_marginTop="-10dp"
                        android:maxLength="400"
                        android:paddingLeft="10dp"
                        android:paddingRight="10dp"
                        android:lineSpacingExtra="-12dp"
                        android:textSize="@dimen/_18sdp"
                        android:textColor="@color/content_title_color"
                        android:textStyle="bold"
                        android:visibility="visible"
                        app:autoSizeMinTextSize="@dimen/_11sdp"
                        app:autoSizeStepGranularity="1sp" />

                            <TextView
                                android:id="@+id/tamil_half_content_title__"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/four"
                                android:layout_marginBottom="@dimen/two"
                                android:autoSizePresetSizes="12dp"
                                android:autoSizeTextType="none"
                                android:ellipsize="end"
                                android:fontFamily="@font/mallannaregular"
                                android:gravity="start"
                                android:letterSpacing="0.01"
                                android:maxLength="400"
                                android:paddingLeft="10dp"
                                android:paddingRight="10dp"
                                android:paddingBottom="2dp"
                                android:text=""
                                android:textColor="@color/content_title_color"
                                android:textSize="@dimen/_12sdp"
                                android:textStyle="bold"
                                android:visibility="gone"
                                app:autoSizeMaxTextSize="@dimen/_13sdp"
                                app:autoSizeMinTextSize="@dimen/_13sdp"
                                app:autoSizeStepGranularity="1sp" />

                            <TextView
                                android:id="@+id/english_half_content_title__"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/four"
                                android:layout_marginBottom="@dimen/two"
                                android:autoSizePresetSizes="12dp"
                                android:autoSizeTextType="none"
                                android:ellipsize="end"
                                android:fontFamily="sans-serif-medium"
                                android:gravity="start"
                                android:letterSpacing="0.01"
                                android:lineSpacingExtra="1sp"
                                android:maxLength="400"
                                android:paddingLeft="10dp"
                                android:paddingRight="10dp"
                                android:paddingBottom="2dp"
                                android:textColor="@color/content_title_color"
                                android:textSize="@dimen/_14sdp"
                                android:textStyle="bold"
                                app:autoSizeMaxTextSize="@dimen/_13sdp"
                                app:autoSizeMinTextSize="@dimen/_13sdp"
                                app:autoSizeStepGranularity="1sp" />

                            <LinearLayout

                                android:id="@+id/layout_date"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_below="@id/half_content_title__"
                                android:autoSizeTextType="none"
                                android:orientation="horizontal">


                            </LinearLayout>


                    <TextView
                        android:id="@+id/half_content_description__"
                        android:layout_width="match_parent"
                        android:layout_height="400dp"
                        android:layout_below="@+id/layout_date"
                        android:ellipsize="end"
                        android:fontFamily="@font/sreekrushnadevaraya_regular"
                        android:gravity="start"
                        android:maxLength="400"
                        android:paddingLeft="10dp"
                        android:paddingRight="10dp"
                        android:layout_marginTop="-6dp"
                        android:paddingBottom="2dp"
                        android:includeFontPadding="true"
                        android:textColor="@color/content_desc_color"
                        android:lineSpacingExtra="-13dp"
                        android:textSize="@dimen/_16sdp"
                        android:visibility="visible" />

                            <TextView
                                android:id="@+id/tamil_half_content_description__"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_below="@+id/tamil_half_content_title__"
                                android:autoSizePresetSizes="12dp"
                                android:autoSizeTextType="none"
                                android:ellipsize="end"
                                android:fontFamily="@font/mallannaregular"
                                android:gravity="start"
                                android:letterSpacing="0.01"
                                android:maxLength="400"
                                android:paddingLeft="10dp"
                                android:paddingRight="10dp"
                                android:paddingBottom="2dp"
                                android:text=""
                                android:textColor="@color/content_desc_color"
                                android:textSize="@dimen/_11sdp"
                                android:visibility="gone"
                                app:autoSizeMaxTextSize="@dimen/_11sdp"
                                app:autoSizeMinTextSize="@dimen/_11sdp"
                                app:autoSizeStepGranularity="1sp" />

                            <TextView
                                android:id="@+id/english_half_content_description__"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_below="@+id/english_half_content_title__"
                                android:autoSizePresetSizes="12dp"
                                android:autoSizeTextType="none"
                                android:ellipsize="end"
                                android:fontFamily="@string/stfEmptyMessage"
                                android:gravity="start"
                                android:letterSpacing="0.01"
                                android:lineSpacingExtra="5sp"
                                android:maxLength="400"
                                android:paddingLeft="10dp"
                                android:paddingRight="10dp"
                                android:paddingBottom="2dp"
                                android:text=""
                                android:textColor="@color/content_desc_color"
                                android:textSize="@dimen/_14sdp"
                                android:textStyle="normal"
                                app:autoSizeMaxTextSize="@dimen/_13sdp"
                                app:autoSizeMinTextSize="@dimen/_13sdp"
                                android:visibility="gone"
                                app:autoSizeStepGranularity="1sp" />


                        </RelativeLayout>


                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/layoutParentDate"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="0.2"
                        android:background="@color/white"
                        android:gravity="start|bottom"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <ImageView
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:layout_gravity="left|center"
                            android:layout_marginLeft="@dimen/_15sdp"
                            android:src="@drawable/timestamp_ic" />

                        <TextView
                            android:id="@+id/textViewPostDate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="left|center"
                            android:layout_marginLeft="@dimen/_5sdp"
                            android:text="12th May 2023"
                            android:textColor="@color/greyish"
                            android:textSize="@dimen/_8sdp"
                            android:textStyle="bold" />
                    </LinearLayout>

                </LinearLayout>


                <LinearLayout
                    android:id="@+id/ll_footer_layout"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_40sdp"
                    android:visibility="visible"
                    android:layout_alignParentBottom="true"
                    android:background="@color/white"
                    android:gravity="start|bottom"
                    android:orientation="horizontal">


                    <LinearLayout
                        android:id="@+id/writer_profile_image"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_gravity="center">

                        <de.hdodenhof.circleimageview.CircleImageView
                            android:id="@+id/writer_profile_pic"
                            android:layout_width="@dimen/_30sdp"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:gravity="left|center"
                        android:layout_marginLeft="5dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/writer_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="left|center"
                            android:textColor="@color/black"
                            android:textSize="@dimen/_8sdp"
                            android:text="pavan kumar"
                            android:textStyle="bold" />


                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingTop="5dp"
                            android:gravity="left|top">


                            <TextView
                                android:id="@+id/writer_designation"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="left|center"
                                android:layout_marginRight="@dimen/_12sdp"
                                android:textColor="@color/black"
                                android:textSize="@dimen/_4sdp"
                                android:text="reporter"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/writer_time"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="left|center"
                                android:textColor="@color/black"
                                android:textSize="@dimen/_4sdp"
                                android:text="4 min ago"
                                android:textStyle="bold" />
                        </LinearLayout>

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/writer_follow"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_marginLeft="@dimen/_10sdp"
                        android:layout_marginRight="@dimen/_10sdp"
                        android:gravity="left|center"
                        android:visibility="visible">

                        <TextView
                            android:id="@+id/test_folloew"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_margin="1dp"
                            android:gravity="center"
                            android:paddingLeft="12dp"
                            android:paddingRight="12dp"
                            android:text="Follow"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintLeft_toLeftOf="parent"
                            app:layout_constraintRight_toRightOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            android:textColor="@color/red_one"
                            android:textSize="@dimen/_6sdp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/writer_follower"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_marginLeft="@dimen/_10sdp"
                        android:layout_marginRight="@dimen/_10sdp"
                        android:gravity="left|center"
                        android:visibility="visible">



                        <TextView
                            android:id="@+id/second_language_name"
                            android:layout_width="wrap_content"
                            android:layout_height="@dimen/_10sdp"
                            android:layout_margin="1dp"
                            android:gravity="center"
                            android:paddingLeft="15dp"
                            android:paddingRight="15dp"
                            android:text="Following"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintLeft_toLeftOf="parent"
                            app:layout_constraintRight_toRightOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            android:textColor="@color/red_one"
                            android:textSize="@dimen/_6sdp"
                            android:textStyle="bold">

                        </TextView>
                    </LinearLayout>


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="@dimen/_10sdp"
                        android:orientation="horizontal"
                        android:gravity="end|center"
                        android:visibility="visible">

                        <LinearLayout
                            android:id="@+id/ll_refer_and_earn_half"
                            android:layout_width="wrap_content"
                            android:paddingLeft="@dimen/_8sdp"
                            android:paddingRight="@dimen/_8sdp"
                            android:paddingTop="@dimen/_2sdp"
                            android:gravity="center"
                            android:background="@drawable/circle_article_location"
                            android:paddingBottom="@dimen/_2sdp"
                            android:layout_height="match_parent">
                            <ImageView
                                android:id="@+id/iv_share_and_earn"
                                android:layout_width="@dimen/_12sdp"
                                android:layout_height="@dimen/_10sdp"
                                android:layout_marginRight="@dimen/_8sdp"
                                android:gravity="center" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:id="@+id/my_feed"
                                android:text=""
                                android:gravity="center"
                                android:textSize="@dimen/_12sdp"
                                android:textColor="@color/black"/>
                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>


            </LinearLayout>

        </LinearLayout>
        <include layout="@layout/share_download_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"/>

    </RelativeLayout>
</LinearLayout>
