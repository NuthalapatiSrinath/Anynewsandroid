<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/wallet_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/rewards_ink"
    android:fitsSystemWindows="false"
    tools:context=".rewards.RewardsWalletActivity">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="36dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="8dp"
                android:paddingTop="6dp"
                android:paddingEnd="16dp"
                android:paddingBottom="6dp">

                <ImageView
                    android:id="@+id/wallet_back"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/cancel"
                    android:padding="8dp"
                    android:src="@drawable/ic_calendar_chevron_left"
                    android:tint="@color/rewards_gold" />

                <TextView
                    android:id="@+id/wallet_top_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_toEndOf="@id/wallet_back"
                    android:fontFamily="@font/sreekrushnadevaraya_regular"
                    android:paddingStart="4dp"
                    android:text="Wallet"
                    android:textColor="@color/rewards_cream"
                    android:textSize="22sp" />
            </RelativeLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:layout_marginEnd="18dp"
                android:background="@drawable/bg_rewards_hero"
                android:orientation="vertical"
                android:padding="22dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/wallet_balance_label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:letterSpacing="0.06"
                        android:text="Balance"
                        android:textAllCaps="true"
                        android:textColor="@color/rewards_gold"
                        android:textSize="11sp" />

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_rewards_crest" />
                </LinearLayout>

                <TextView
                    android:id="@+id/wallet_balance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/sreekrushnadevaraya_regular"
                    android:includeFontPadding="false"
                    android:text="₹0"
                    android:textColor="@color/rewards_gold_bright"
                    android:textSize="48sp" />

                <TextView
                    android:id="@+id/wallet_coins_line"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="0 coins"
                    android:textColor="@color/rewards_gold"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/wallet_rate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="100 coins = ₹1"
                    android:textColor="@color/rewards_cream"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/wallet_withdraw_eta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Credit usually takes 24–48 hours."
                    android:textColor="@color/rewards_cream_muted"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="18dp"
                android:background="@drawable/bg_rewards_card"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:id="@+id/wallet_convert_btn"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_rewards_btn_secondary"
                    android:gravity="center"
                    android:text="Convert coins → ₹"
                    android:textColor="@color/rewards_gold"
                    android:textSize="15sp" />

                <EditText
                    android:id="@+id/wallet_upi"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_rewards_input"
                    android:hint="UPI ID"
                    android:inputType="textEmailAddress"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:textColor="@color/rewards_cream"
                    android:textColorHint="@color/rewards_cream_muted"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/wallet_upi_name"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_rewards_input"
                    android:hint="Account holder name"
                    android:inputType="textPersonName"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:textColor="@color/rewards_cream"
                    android:textColorHint="@color/rewards_cream_muted"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/wallet_save_upi"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_rewards_btn_secondary"
                    android:gravity="center"
                    android:text="Save UPI"
                    android:textColor="@color/rewards_cream"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/wallet_withdraw_amount"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_rewards_input"
                    android:hint="Amount ₹"
                    android:inputType="numberDecimal"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:textColor="@color/rewards_cream"
                    android:textColorHint="@color/rewards_cream_muted"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/wallet_withdraw_btn"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_rewards_btn_primary"
                    android:gravity="center"
                    android:text="Withdraw"
                    android:textColor="@color/rewards_ink_text"
                    android:textSize="15sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/wallet_history_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="22dp"
                android:layout_marginTop="24dp"
                android:layout_marginEnd="18dp"
                android:letterSpacing="0.04"
                android:text="History"
                android:textAllCaps="true"
                android:textColor="@color/rewards_gold"
                android:textSize="11sp" />

            <LinearLayout
                android:id="@+id/wallet_history"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="18dp"
                android:background="@drawable/bg_rewards_card"
                android:orientation="vertical"
                android:paddingTop="4dp"
                android:paddingBottom="4dp" />

            <TextView
                android:id="@+id/wallet_withdrawals_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="22dp"
                android:layout_marginTop="24dp"
                android:layout_marginEnd="18dp"
                android:letterSpacing="0.04"
                android:text="Withdrawals"
                android:textAllCaps="true"
                android:textColor="@color/rewards_gold"
                android:textSize="11sp" />

            <LinearLayout
                android:id="@+id/wallet_withdrawals"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="18dp"
                android:background="@drawable/bg_rewards_card"
                android:orientation="vertical"
                android:paddingTop="4dp"
                android:paddingBottom="4dp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</FrameLayout>
