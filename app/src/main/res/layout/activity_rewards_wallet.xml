<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/wallet_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF8F4EC"
    android:fitsSystemWindows="false"
    tools:context=".rewards.RewardsWalletActivity">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="32dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="14dp"
                android:paddingTop="10dp"
                android:paddingEnd="10dp"
                android:paddingBottom="8dp">

                <ImageView
                    android:id="@+id/wallet_back"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/cancel"
                    android:padding="8dp"
                    android:src="@drawable/ic_calendar_chevron_left"
                    android:tint="#FF1C1917" />

                <TextView
                    android:id="@+id/wallet_top_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_toEndOf="@id/wallet_back"
                    android:fontFamily="@font/sreekrushnadevaraya_regular"
                    android:paddingStart="4dp"
                    android:text="Wallet"
                    android:textColor="#FF1C1917"
                    android:textSize="22sp"
                    android:textStyle="bold" />
            </RelativeLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="14dp"
                android:background="@drawable/bg_rewards_hero"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:id="@+id/wallet_balance_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Balance"
                    android:textAllCaps="true"
                    android:textColor="#FF78716C"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/wallet_balance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/sreekrushnadevaraya_regular"
                    android:text="₹0"
                    android:textColor="#FF1C1917"
                    android:textSize="42sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/wallet_coins_line"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="0 coins"
                    android:textColor="#FFB45309"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/wallet_rate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="100 coins = ₹1"
                    android:textColor="#FF78716C"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/wallet_withdraw_eta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Credit usually takes 24–48 hours."
                    android:textColor="#FFA8A29E"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginTop="14dp"
                android:layout_marginEnd="14dp"
                android:background="@drawable/bg_rewards_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/wallet_convert_btn"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_rewards_btn_secondary"
                    android:gravity="center"
                    android:text="Convert coins → ₹"
                    android:textColor="#FF44403C"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/wallet_upi"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_rewards_input"
                    android:hint="UPI ID"
                    android:inputType="textEmailAddress"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textColor="#FF1C1917"
                    android:textColorHint="#FFA8A29E"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/wallet_save_upi"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_rewards_btn_secondary"
                    android:gravity="center"
                    android:text="Save UPI"
                    android:textColor="#FF44403C"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/wallet_withdraw_amount"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_rewards_input"
                    android:hint="Amount ₹"
                    android:inputType="numberDecimal"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textColor="#FF1C1917"
                    android:textColorHint="#FFA8A29E"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/wallet_withdraw_btn"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_rewards_btn_primary"
                    android:gravity="center"
                    android:text="Withdraw"
                    android:textColor="#FFFFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/wallet_history_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:layout_marginTop="18dp"
                android:layout_marginEnd="18dp"
                android:text="History"
                android:textColor="#FF1C1917"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/wallet_history"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="14dp"
                android:background="@drawable/bg_rewards_card"
                android:orientation="vertical"
                android:padding="8dp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</FrameLayout>
