<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp">

    <ImageView
        android:id="@+id/bookmark_item_image"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:background="#EEEEEE"
        android:contentDescription="@string/bookmarks"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/bookmark_item_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/title_color"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/bookmark_item_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/colorBookmarksInfo"
            android:textSize="12sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/bookmark_item_remove"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:contentDescription="@string/remove_bookmark"
        android:padding="6dp"
        android:src="@drawable/ic_action_bookmark" />
</LinearLayout>
