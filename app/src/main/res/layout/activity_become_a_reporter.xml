<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/profile_hub_scrim"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:paddingBottom="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="12dp">

            <ImageView
                android:id="@+id/become_reporter_back"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/become_a_reporter"
                android:padding="8dp"
                android:src="@drawable/ic_profile_chevron_right"
                android:rotation="180"
                app:tint="@color/profile_way2_menu_text" />

            <TextView
                android:id="@+id/become_reporter_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:includeFontPadding="false"
                android:text="@string/become_a_reporter"
                android:textColor="@color/profile_way2_menu_text"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/become_reporter_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:includeFontPadding="false"
            android:textColor="@color/profile_way2_guest_sub"
            android:textSize="13sp" />

        <!-- Profile card -->
        <LinearLayout
            android:id="@+id/become_reporter_profile_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_reporter_desk_card"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="@string/become_reporter_profile_section"
                android:textColor="@color/profile_way2_menu_text"
                android:textSize="15sp"
                android:textStyle="bold" />

            <FrameLayout
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="14dp">

                <ImageView
                    android:id="@+id/become_reporter_photo"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_profile_icon_circle_dark"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_hub_become_reporter" />
            </FrameLayout>

            <TextView
                android:id="@+id/become_reporter_pick_photo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:includeFontPadding="false"
                android:padding="6dp"
                android:text="@string/become_reporter_add_photo"
                android:textColor="@color/brand_orange"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/become_reporter_name"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_edit_profile_field"
                android:hint="@string/become_reporter_name_hint"
                android:inputType="textPersonName"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="@color/profile_way2_value"
                android:textColorHint="@color/profile_way2_label"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/become_reporter_phone"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_edit_profile_field"
                android:hint="@string/become_reporter_phone_hint"
                android:inputType="phone"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="@color/profile_way2_value"
                android:textColorHint="@color/profile_way2_label"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/become_reporter_email"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_edit_profile_field"
                android:hint="@string/become_reporter_email_hint"
                android:inputType="textEmailAddress"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="@color/profile_way2_value"
                android:textColorHint="@color/profile_way2_label"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/become_reporter_save_profile"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_profile_login_pill"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="@string/become_reporter_save_profile"
                android:textColor="@color/profile_way2_login_text"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Posts section -->
        <LinearLayout
            android:id="@+id/become_reporter_posts_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_reporter_desk_card"
            android:orientation="vertical"
            android:padding="14dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/become_reporter_posts_heading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="@string/become_reporter_posts_section"
                android:textColor="@color/profile_way2_menu_text"
                android:textSize="15sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/become_reporter_posts_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/become_reporter_add_post"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_profile_login_pill"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="@string/become_reporter_submit_article"
                android:textColor="@color/profile_way2_login_text"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Inline compose retired: samples open full PostArticles (applicant mode). -->
        <LinearLayout
            android:id="@+id/become_reporter_compose"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_reporter_desk_card"
            android:orientation="vertical"
            android:padding="14dp"
            android:visibility="gone">

            <EditText
                android:id="@+id/become_reporter_post_title"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_edit_profile_field"
                android:hint="@string/become_reporter_title_hint"
                android:inputType="text"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="@color/profile_way2_value"
                android:textColorHint="@color/profile_way2_label"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/become_reporter_post_body"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_edit_profile_field"
                android:gravity="top"
                android:hint="@string/become_reporter_body_hint"
                android:inputType="textMultiLine"
                android:padding="12dp"
                android:textColor="@color/profile_way2_value"
                android:textColorHint="@color/profile_way2_label"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/become_reporter_pick_post_image"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:includeFontPadding="false"
                android:text="@string/become_reporter_pick_image"
                android:textColor="@color/brand_orange"
                android:textSize="13sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/become_reporter_post_preview"
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_edit_profile_field"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                android:visibility="gone" />

            <TextView
                android:id="@+id/become_reporter_submit_post"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_profile_login_pill"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="@string/become_reporter_submit_article"
                android:textColor="@color/profile_way2_login_text"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/become_reporter_progress"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
