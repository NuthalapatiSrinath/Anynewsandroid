<?xml version="1.0" encoding="utf-8"?>
<!-- Flip 1: raasi grid + full inline phalalu (no more→modal). -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/telugu_calendar_raasi_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="ifContentScrolls"
    android:paddingBottom="72dp">

    <LinearLayout
        android:id="@+id/telugu_calendar_raasi_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="14dp"
        android:paddingEnd="12dp"
        android:paddingBottom="16dp">

        <View
            android:layout_width="match_parent"
            android:layout_height="1.5dp"
            android:layout_marginStart="28dp"
            android:layout_marginEnd="28dp"
            android:background="#F5C542" />

        <!-- Text set at runtime via CalendarRaasiLabels (LanguageID). -->
        <TextView
            android:id="@+id/telugu_calendar_pick_raasi_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:gravity="center"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1.5dp"
            android:layout_marginStart="28dp"
            android:layout_marginEnd="28dp"
            android:background="#F5C542" />

        <GridLayout
            android:id="@+id/telugu_calendar_raasi_grid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:alignmentMode="alignBounds"
            android:columnCount="4"
            android:useDefaultMargins="false" />

        <!-- First-viewport row: 3 lucky chips + know-raasi link (no below-fold lucky panel). -->
        <LinearLayout
            android:id="@+id/telugu_calendar_lucky_know_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/telugu_calendar_lucky_panel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Color chip -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_calendar_lucky_chip"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingStart="4dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="4dp"
                    android:paddingBottom="5dp">

                    <TextView
                        android:id="@+id/telugu_calendar_lucky_color_label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:maxLines="1"
                        android:textColor="#9A9A9A"
                        android:textSize="9sp" />

                    <TextView
                        android:id="@+id/telugu_calendar_lucky_color"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:maxLines="1"
                        android:textColor="#F5C542"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Numbers chip -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_calendar_lucky_chip"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingStart="4dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="4dp"
                    android:paddingBottom="5dp">

                    <TextView
                        android:id="@+id/telugu_calendar_lucky_numbers_label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:maxLines="1"
                        android:textColor="#9A9A9A"
                        android:textSize="9sp" />

                    <TextView
                        android:id="@+id/telugu_calendar_lucky_numbers"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:maxLines="1"
                        android:textColor="#F5C542"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Direction chip -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_calendar_lucky_chip"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingStart="4dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="4dp"
                    android:paddingBottom="5dp">

                    <TextView
                        android:id="@+id/telugu_calendar_lucky_direction_label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:maxLines="1"
                        android:textColor="#9A9A9A"
                        android:textSize="9sp" />

                    <TextView
                        android:id="@+id/telugu_calendar_lucky_direction"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:maxLines="1"
                        android:textColor="#F5C542"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/telugu_calendar_know_raasi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:gravity="end|center_vertical"
                android:maxWidth="112dp"
                android:maxLines="2"
                android:paddingStart="2dp"
                android:paddingTop="4dp"
                android:paddingEnd="2dp"
                android:paddingBottom="4dp"
                android:textColor="#4DA3FF"
                android:textSize="11sp" />

            <!-- Kept for bind/share chrome; heading removed from UI (chips replace panel). -->
            <TextView
                android:id="@+id/telugu_calendar_lucky_heading"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/telugu_calendar_raasi_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/telugu_calendar_raasi_sign_line"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/telugu_calendar_raasi_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Retired title-row share — blinking footer share is on activity root. -->
            <ImageView
                android:id="@+id/telugu_calendar_raasi_share"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@string/telugu_calendar_share_raasi"
                android:src="@drawable/ic_baseline_share_24"
                android:visibility="gone" />

            <!-- Full body — no truncation / no "more". -->
            <TextView
                android:id="@+id/telugu_calendar_raasi_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="4dp"
                android:textColor="#E8E8E8"
                android:textSize="14sp" />

            <!-- Kept for bind; always GONE — full text is inline. -->
            <TextView
                android:id="@+id/telugu_calendar_raasi_more"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <TextView
                android:id="@+id/telugu_calendar_full_jatakam"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/telugu_calendar_flip_indicator_raasi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
