<?xml version="1.0" encoding="utf-8"?>
<!-- After last search result: continue into News / Local / Flash / Daily Updates. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/search_hub_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/feed_shimmer_surface"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">

        <TextView
            android:id="@+id/search_hub_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/search_hub_title"
            android:textColor="@color/colorTextSecondary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/search_hub_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/search_hub_subtitle"
            android:textColor="@color/colorTextSecondary"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/search_hub_main"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="?attr/selectableItemBackground"
                android:gravity="center"
                android:text="@string/search_hub_main_news"
                android:textColor="@color/text_color_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <View
                android:id="@+id/search_hub_div_main"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/feed_shimmer_bone" />

            <TextView
                android:id="@+id/search_hub_local"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="?attr/selectableItemBackground"
                android:gravity="center"
                android:text="@string/search_hub_local_news"
                android:textColor="@color/text_color_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <View
                android:id="@+id/search_hub_div_local"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/feed_shimmer_bone" />

            <TextView
                android:id="@+id/search_hub_flash"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="?attr/selectableItemBackground"
                android:gravity="center"
                android:text="@string/search_hub_flash_news"
                android:textColor="@color/text_color_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="Flash News" />

            <View
                android:id="@+id/search_hub_div_flash"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/feed_shimmer_bone" />

            <TextView
                android:id="@+id/search_hub_daily"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="?attr/selectableItemBackground"
                android:gravity="center"
                android:text="@string/search_hub_daily_updates"
                android:textColor="@color/text_color_primary"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
