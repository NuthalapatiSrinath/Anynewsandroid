<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/background_color"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/full_image_main"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:background="@color/background_color"
        android:layout_height="match_parent">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/background_color">
            <RelativeLayout
                xmlns:android="http://schemas.android.com/apk/res/android"
                xmlns:app="http://schemas.android.com/apk/res-auto"
                xmlns:tools="http://schemas.android.com/tools"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:background="@color/background_color"
                tools:context=".MainActivity">

                <com.anyNews.anynews.Ui.NeomorphFrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:neomorph_shadow_type="outer"
                    app:neomorph_layer_type="hardware"
                    app:neomorph_background_color="@color/background_color"
                    app:neomorph_elevation="0dp"
                    app:neomorph_view_type="rectangular"
                    app:neomorph_shadow_color="#D0D2D5"
                    app:neomorph_highlight_color="@color/neomorph_highlight_color"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <LinearLayout
                        xmlns:android="http://schemas.android.com/apk/res/android"
                        xmlns:app="http://schemas.android.com/apk/res-auto"
                        xmlns:tools="http://schemas.android.com/tools"
                        android:layout_width="match_parent"
                        android:orientation="vertical"
                        android:layout_height="match_parent"
                        tools:context=".Image">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/full_icon_what">

                            <ImageView
                                android:background="@color/background_color"
                                android:id="@+id/image_view"
                                android:layout_marginBottom="6dp"
                                android:layout_width="fill_parent"
                                android:scaleType="fitXY"
                                android:layout_height="fill_parent" />


                        </LinearLayout>

                    </LinearLayout>

                </com.anyNews.anynews.Ui.NeomorphFrameLayout>


            </RelativeLayout>



            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:id="@+id/side_menu"
                android:layout_centerVertical="true"
                android:layout_alignParentRight="true"
                android:gravity="center_horizontal">


                <LinearLayout
                    android:layout_marginTop="@dimen/_150sdp"
                    android:id="@+id/video_side_menu"
                    android:layout_width="60dp"
                    android:layout_height="wrap_content"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"
                    android:layout_marginRight="10dp"
                    android:background="@drawable/transparent"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">


                    <RelativeLayout
                        android:layout_marginBottom="20dp"
                        android:layout_width="40dp"
                        android:layout_height="50dp">
                        <de.hdodenhof.circleimageview.CircleImageView
                            android:layout_width="50dp"
                            android:layout_height="50dp"
                            android:scaleType="centerCrop"
                            android:id="@+id/user_pic"
                            android:src="@drawable/ic_launcher"/>

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_marginRight="10dp"
                            android:layout_height="18dp"
                            android:layout_alignParentEnd="true"
                            android:layout_alignParentBottom="true"
                            android:scaleType="fitCenter"
                            android:id="@+id/varified_btn"
                            android:src="@drawable/ic_add_profile_icon"/>

                    </RelativeLayout>
                    <LinearLayout
                        android:id="@+id/full_image_like"
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:orientation="vertical"
                        android:gravity="center">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_new_like_icon"
                            app:tint="@color/on_brand_text" />
                        <TextView
                            android:id="@+id/like"
                            android:layout_marginTop="@dimen/five"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:shadowColor="@color/black"
                            android:shadowDx="1"
                            android:shadowDy="1"
                            android:shadowRadius="3"
                            android:textColor="@color/on_brand_text"
                            android:textSize="9dp"
                            android:textStyle="bold" />

                    </LinearLayout>


                    <LinearLayout
                        android:id="@+id/full_image_dislike"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:scaleType="fitCenter"
                            app:tint="@color/on_brand_text"
                            android:src="@drawable/ic_new_dislike_icon"/>

                        <TextView
                            android:layout_marginTop="@dimen/five"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:shadowColor="@color/black"
                            android:shadowDx="1"
                            android:shadowDy="1"
                            android:shadowRadius="3"
                            android:textColor="@color/on_brand_text"
                            android:textSize="9dp"
                            android:textStyle="bold" />
                    </LinearLayout>


                    <LinearLayout

                        android:id="@+id/full_image_share"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:scaleType="fitCenter"
                            app:tint="@color/on_brand_text"
                            android:src="@drawable/ic_new_share_icon" />

                        <TextView
                            android:id="@+id/share"
                            android:layout_marginTop="@dimen/five"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:shadowColor="@color/black"
                            android:shadowDx="1"
                            android:shadowDy="1"
                            android:shadowRadius="3"
                            android:textColor="@color/on_brand_text"
                            android:textSize="9dp"
                            android:textStyle="bold" />
                    </LinearLayout>


                    <LinearLayout
                        android:id="@+id/full_image_whatsapp"
                        android:layout_width="wrap_content"
                        android:layout_height="45dp"
                        android:layout_marginTop="20dp"
                        android:layout_marginBottom="@dimen/ten"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <ImageView
                            android:id="@+id/mute_video_player_image"
                            android:layout_width="26dp"
                            android:layout_height="25dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/full_icon_what"
                            app:tint="@color/on_brand_text" />

                        <TextView
                            android:id="@+id/mute_video_player_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/five"
                            android:shadowColor="@color/black"
                            android:shadowDx="1"
                            android:shadowDy="1"
                            android:shadowRadius="3"
                            android:textColor="@color/on_brand_text"
                            android:textSize="9dp"
                            android:textStyle="bold" />
                    </LinearLayout>


                    <LinearLayout
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:layout_marginBottom="@dimen/ten"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic__volume_up" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:shadowColor="@color/black"
                            android:shadowDx="1"
                            android:shadowDy="1"
                            android:shadowRadius="3"
                            android:text="Mute"
                            android:textColor="@color/on_brand_text"
                            android:textSize="9dp"
                            android:textStyle="bold" />
                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>


            <LinearLayout
                android:id="@+id/layout_strip_icon"
                android:layout_width="match_parent"
                android:visibility="gone"
                android:layout_height="40dp"
                android:layout_alignParentBottom="true"
                android:orientation="vertical">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="fitXY"/>



                </LinearLayout>

            </LinearLayout>




        </RelativeLayout>



    </LinearLayout>
</LinearLayout>
