<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rl_survay_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/transparent_white"
    android:gravity="center"
    android:padding="16dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center">

        <androidx.cardview.widget.CardView
            xmlns:Card_View="http://schemas.android.com/apk/res-auto"
            android:layout_width="match_parent"
            android:layout_height="350dp"
            android:id="@+id/card_view_survey"
            android:layout_margin="5dp"
            android:padding="10sp"
            Card_View:cardCornerRadius="5sp"
            Card_View:cardBackgroundColor="@color/transparent_white"
            Card_View:cardElevation="5sp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:id="@+id/rl_question"
                android:layout_margin="5dp"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/tv_survey_question_common"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="@dimen/_20sdp"
                    android:layout_marginVertical="@dimen/_30sdp"
                    android:autoSizePresetSizes="12dp"
                    android:autoSizeTextType="none"
                    android:ellipsize="end"
                    android:fontFamily="@font/robotolighttelugu"
                    android:gravity="center"
                    android:lineSpacingExtra="-8dp"
                    android:maxLength="400"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:paddingBottom="2dp"
                    android:text=""
                    android:textColor="@color/content_title_color"
                    android:textSize="@dimen/_12sdp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    app:autoSizeMaxTextSize="@dimen/_11sdp"
                    app:autoSizeMinTextSize="@dimen/_11sdp"
                    app:autoSizeStepGranularity="1sp" />
                <TextView
                    android:id="@+id/tv_survey_question_tamil"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="@dimen/_30sdp"
                    android:layout_marginBottom="@dimen/two"
                    android:paddingVertical="@dimen/_20sdp"
                    android:autoSizePresetSizes="12dp"
                    android:autoSizeTextType="none"
                    android:ellipsize="end"
                    android:fontFamily="@font/mallannaregular"
                    android:gravity="center"
                    android:letterSpacing="0.01"
                    android:maxLength="400"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:paddingBottom="2dp"
                    android:text=""
                    android:textColor="@color/content_title_color"
                    android:textSize="@dimen/_10sdp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    app:autoSizeMaxTextSize="@dimen/_13sdp"
                    app:autoSizeMinTextSize="@dimen/_13sdp"
                    app:autoSizeStepGranularity="1sp" />
                <TextView
                    android:id="@+id/tv_survey_question_english"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="visible"
                    android:layout_marginVertical="@dimen/_30sdp"
                    android:paddingVertical="@dimen/_20sdp"
                    android:layout_marginBottom="@dimen/two"
                    android:autoSizePresetSizes="12dp"
                    android:autoSizeTextType="none"
                    android:ellipsize="end"
                    android:fontFamily="@font/roboto_bold"
                    android:gravity="center"
                    android:layout_gravity="top"
                    android:letterSpacing="0.01"
                    android:lineSpacingExtra="1sp"
                    android:maxLength="400"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:paddingBottom="2dp"
                    android:text="Question"
                    android:textColor="@color/content_title_color"
                    android:textSize="@dimen/_13sdp"
                    android:textStyle="bold"
                    app:autoSizeMaxTextSize="@dimen/_13sdp"
                    app:autoSizeMinTextSize="@dimen/_13sdp"
                    app:autoSizeStepGranularity="1sp" />


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_50sdp"
                    android:orientation="horizontal"
                    android:layout_marginStart="@dimen/_10sdp"
                    android:layout_marginEnd="@dimen/_10sdp"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:weightSum="1">
                        <com.anyNews.anynews.Ui.NeomorphFrameLayout
                            android:id="@+id/neomorphFrameLayoutYes"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="0.5"
                            app:neomorph_shadow_type="outer"
                            app:neomorph_layer_type="hardware"
                            app:neomorph_background_color="@color/white"
                            app:neomorph_corner_radius="@dimen/neomorph_view_corner_radius"
                            app:neomorph_elevation="@dimen/neomorph_view_elevation"
                            app:neomorph_view_type="rectangular"
                            app:neomorph_shadow_color="#D0D2D5"
                            app:neomorph_highlight_color="@color/neomorph_highlight_color">
                            <TextView
                                android:id="@+id/tv_answer_yes"
                                android:text=""
                                android:gravity="center"
                                android:layout_margin="@dimen/_3sdp"
                                android:background="@drawable/background_button"
                                android:textSize="@dimen/_12sdp"
                                android:fontFamily="@font/roboto_bold"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"/>
                            <TextView
                                android:id="@+id/tv_answer_yes_telugu"
                                android:text=""
                                android:gravity="center"
                                android:visibility="gone"
                                android:layout_margin="@dimen/_3sdp"
                                android:background="@drawable/background_button"
                                android:textSize="@dimen/_18sdp"
                                android:fontFamily="@font/robotolighttelugu"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"/>
                            <TextView
                                android:id="@+id/tv_answer_yes_tamil"
                                android:text=""
                                android:gravity="center"
                                android:visibility="gone"
                                android:layout_margin="@dimen/_3sdp"
                                android:background="@drawable/background_button"
                                android:textSize="@dimen/_12sdp"
                                android:fontFamily="@font/mallannaregular"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"/>
                        </com.anyNews.anynews.Ui.NeomorphFrameLayout>

                    <com.anyNews.anynews.Ui.NeomorphFrameLayout
                        android:id="@+id/neomorphFrameLayoutYesSelected"
                        android:visibility="gone"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="0.5"
                        app:neomorph_shadow_type="outer"
                        app:neomorph_layer_type="hardware"
                        app:neomorph_background_color="#FF2401"
                        app:neomorph_corner_radius="@dimen/neomorph_view_corner_radius"
                        app:neomorph_elevation="@dimen/neomorph_view_elevation"
                        app:neomorph_view_type="rectangular"
                        app:neomorph_shadow_color="#16FF2401"
                        app:neomorph_highlight_color="#ffffff">
                        <TextView
                            android:id="@+id/tv_answer_yes_selected"
                            android:text=""
                            android:gravity="center"
                            android:layout_margin="@dimen/_3sdp"
                            android:textColor="@color/white"
                            android:background="@drawable/red_color"
                            android:textSize="@dimen/_12sdp"
                            android:fontFamily="@font/roboto_bold"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"/>
                    </com.anyNews.anynews.Ui.NeomorphFrameLayout>

                        <com.anyNews.anynews.Ui.NeomorphFrameLayout
                            android:id="@+id/neomorphFrameLayoutNo"
                            android:layout_width="0sp"
                            android:layout_height="match_parent"
                            android:layout_weight="0.5"
                            app:neomorph_shadow_type="outer"
                            app:neomorph_layer_type="hardware"
                            app:neomorph_background_color="@color/white"
                            app:neomorph_corner_radius="@dimen/neomorph_view_corner_radius"
                            app:neomorph_elevation="@dimen/neomorph_view_elevation"
                            app:neomorph_view_type="rectangular"
                            app:neomorph_shadow_color="#D0D2D5"
                            app:neomorph_highlight_color="@color/neomorph_highlight_color">
                            <TextView
                                android:id="@+id/tv_answer_no"
                                android:text=""
                                android:gravity="center"
                                android:layout_margin="@dimen/_3sdp"
                                android:background="@drawable/background_button"
                                android:textSize="@dimen/_12sdp"
                                android:fontFamily="@font/roboto_bold"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"/>
                        </com.anyNews.anynews.Ui.NeomorphFrameLayout>

                    <com.anyNews.anynews.Ui.NeomorphFrameLayout
                        android:id="@+id/neomorphFrameLayoutNoSelected"
                        android:visibility="gone"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="0.5"
                        app:neomorph_shadow_type="outer"
                        app:neomorph_layer_type="hardware"
                        app:neomorph_background_color="#FF2401"
                        app:neomorph_corner_radius="@dimen/neomorph_view_corner_radius"
                        app:neomorph_elevation="@dimen/neomorph_view_elevation"
                        app:neomorph_view_type="rectangular"
                        app:neomorph_shadow_color="#16FF2401"
                        app:neomorph_highlight_color="#ffffff">
                    <TextView
                        android:id="@+id/tv_answer_no_selected"
                        android:text=""
                        android:gravity="center"
                        android:layout_margin="@dimen/_3sdp"
                        android:textColor="@color/white"
                        android:background="@drawable/red_color"
                        android:textSize="@dimen/_12sdp"
                        android:fontFamily="@font/roboto_bold"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"/>
                    </com.anyNews.anynews.Ui.NeomorphFrameLayout>


                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_40sdp"
                    android:id="@+id/ll_percent_layout"
                    android:orientation="horizontal"
                    android:layout_marginStart="@dimen/_10sdp"
                    android:layout_marginEnd="@dimen/_10sdp"
                    android:layout_marginTop="@dimen/_15sdp"
                    android:visibility="invisible"
                    android:weightSum="1">
                    <com.anyNews.anynews.Ui.NeomorphFrameLayout
                        android:id="@+id/neomorphFrameLayoutYesPercent"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="0.5"
                        app:neomorph_shadow_type="outer"
                        app:neomorph_layer_type="hardware"
                        app:neomorph_background_color="#FF2401"
                        app:neomorph_corner_radius="@dimen/neomorph_view_corner_radius"
                        app:neomorph_elevation="@dimen/neomorph_view_elevation"
                        app:neomorph_view_type="rectangular"
                        app:neomorph_shadow_color="#16FF2401"
                        app:neomorph_highlight_color="#ffffff">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:id="@+id/tv_yes_percent"
                            android:textSize="@dimen/_12sdp"
                            android:gravity="center"
                            android:textColor="@color/white"/>

                    </com.anyNews.anynews.Ui.NeomorphFrameLayout>

                    <com.anyNews.anynews.Ui.NeomorphFrameLayout
                        android:id="@+id/neomorphFrameLayoutNoPercent"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="0.5"
                        app:neomorph_shadow_type="outer"
                        app:neomorph_layer_type="hardware"
                        app:neomorph_background_color="#FF2401"
                        app:neomorph_corner_radius="@dimen/neomorph_view_corner_radius"
                        app:neomorph_elevation="@dimen/neomorph_view_elevation"
                        app:neomorph_view_type="rectangular"
                        app:neomorph_shadow_color="#16FF2401"
                        app:neomorph_highlight_color="#ffffff">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:id="@+id/tv_no_percent"
                            android:text=""
                            android:textSize="@dimen/_12sdp"
                            android:gravity="center"
                            android:textColor="@color/white"/>
                    </com.anyNews.anynews.Ui.NeomorphFrameLayout>

                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </RelativeLayout>

</RelativeLayout>