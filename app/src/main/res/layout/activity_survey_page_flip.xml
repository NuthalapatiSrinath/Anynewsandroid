<?xml version="1.0" encoding="utf-8"?>
<!--
  Polling (post_type "survey"): 2-option Yes/No.
  Image on top; dark polished card with options / results below.
-->
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rl_survay_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Hero image (top) -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="4.2"
            android:background="@color/black">

            <ImageView
                android:id="@+id/survey_half_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:adjustViewBounds="true"
                android:contentDescription="@null"
                android:scaleType="fitXY"
                android:src="@drawable/md_btn_selector_ripple_dark" />

            <!-- Like / comment / share / flag — same row as half articles -->
            <include
                layout="@layout/include_half_engagement_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:layout_marginBottom="2dp" />
        </FrameLayout>

        <!-- Dark poll card -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="5.8"
            android:background="@color/black"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="6dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:id="@+id/rl_question"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_poll_card_dark"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="14dp"
                android:paddingBottom="12dp">

                <TextView
                    android:id="@+id/tv_survey_question_english"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/roboto_bold"
                    android:gravity="center"
                    android:letterSpacing="0.01"
                    android:lineSpacingExtra="2sp"
                    android:maxLines="3"
                    android:paddingBottom="10dp"
                    android:textColor="@color/poll_card_question"
                    android:textSize="@dimen/_14sdp"
                    android:textStyle="bold" />

                <!-- Hidden IDs kept for language fallbacks / legacy findViewById -->
                <TextView
                    android:id="@+id/tv_survey_question_common"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />
                <TextView
                    android:id="@+id/tv_survey_question_tamil"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />

                <!-- BEFORE vote -->
                <LinearLayout
                    android:id="@+id/ll_options_layout"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <!-- Yes -->
                    <LinearLayout
                        android:id="@+id/option_row_yes"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:layout_marginBottom="8dp"
                        android:background="@drawable/bg_poll_option_green"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:clickable="true"
                        android:focusable="true">

                        <View
                            android:id="@+id/radio_yes"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:background="@drawable/bg_poll_radio_green" />

                        <TextView
                            android:id="@+id/tv_answer_yes"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:fontFamily="@font/roboto_bold"
                            android:maxLines="2"
                            android:textColor="@color/poll_card_question"
                            android:textSize="@dimen/_14sdp" />
                    </LinearLayout>

                    <!-- No -->
                    <LinearLayout
                        android:id="@+id/option_row_no"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:layout_marginBottom="10dp"
                        android:background="@drawable/bg_poll_option_red"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:clickable="true"
                        android:focusable="true">

                        <View
                            android:id="@+id/radio_no"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:background="@drawable/bg_poll_radio_red" />

                        <TextView
                            android:id="@+id/tv_answer_no"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:fontFamily="@font/roboto_bold"
                            android:maxLines="2"
                            android:textColor="@color/poll_card_question"
                            android:textSize="@dimen/_14sdp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/btn_vote_now_survey"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_poll_vote_now"
                        android:fontFamily="@font/roboto_bold"
                        android:gravity="center"
                        android:text="@string/vote_now"
                        android:textColor="@color/poll_vote_now_text"
                        android:textSize="@dimen/_14sdp"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>

                <!-- AFTER vote — percent only, no vote counts -->
                <LinearLayout
                    android:id="@+id/ll_percent_layout"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <!-- Result Yes (color assigned by rank in code) -->
                    <LinearLayout
                        android:id="@+id/result_row_yes"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:layout_marginBottom="8dp"
                        android:background="@drawable/bg_poll_result_green"
                        android:orientation="vertical"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/badge_yes"
                                android:layout_width="26dp"
                                android:layout_height="26dp"
                                android:background="@drawable/bg_poll_badge_green"
                                android:fontFamily="@font/roboto_bold"
                                android:gravity="center"
                                android:text="1"
                                android:textColor="@color/white"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/tv_yes_label"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:layout_weight="1"
                                android:ellipsize="end"
                                android:fontFamily="@font/roboto_bold"
                                android:maxLines="2"
                                android:textColor="@color/poll_card_question"
                                android:textSize="@dimen/_12sdp" />

                            <TextView
                                android:id="@+id/tv_yes_percent"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/roboto_bold"
                                android:textColor="@color/poll_card_question"
                                android:textSize="@dimen/_18sdp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="6dp"
                            android:layout_marginTop="10dp"
                            android:layout_marginStart="36dp">

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/bg_poll_progress_track" />

                            <View
                                android:id="@+id/yes_percent_fill"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_gravity="start"
                                android:background="@drawable/bg_poll_progress_green" />
                        </FrameLayout>
                    </LinearLayout>

                    <!-- Result No -->
                    <LinearLayout
                        android:id="@+id/result_row_no"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_poll_result_red"
                        android:orientation="vertical"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/badge_no"
                                android:layout_width="26dp"
                                android:layout_height="26dp"
                                android:background="@drawable/bg_poll_badge_red"
                                android:fontFamily="@font/roboto_bold"
                                android:gravity="center"
                                android:text="2"
                                android:textColor="@color/white"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/tv_no_label"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:layout_weight="1"
                                android:ellipsize="end"
                                android:fontFamily="@font/roboto_bold"
                                android:maxLines="2"
                                android:textColor="@color/poll_card_question"
                                android:textSize="@dimen/_12sdp" />

                            <TextView
                                android:id="@+id/tv_no_percent"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/roboto_bold"
                                android:textColor="@color/poll_card_question"
                                android:textSize="@dimen/_18sdp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="6dp"
                            android:layout_marginTop="10dp"
                            android:layout_marginStart="36dp">

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/bg_poll_progress_track" />

                            <View
                                android:id="@+id/no_percent_fill"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_gravity="start"
                                android:background="@drawable/bg_poll_progress_red" />
                        </FrameLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- Legacy stubs kept so old findViewById calls don't NPE during transition -->
                <View android:id="@+id/neomorphFrameLayoutYes" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                <View android:id="@+id/neomorphFrameLayoutNo" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                <View android:id="@+id/neomorphFrameLayoutYesSelected" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                <View android:id="@+id/neomorphFrameLayoutNoSelected" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                <View android:id="@+id/neomorphFrameLayoutYesPercent" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                <View android:id="@+id/neomorphFrameLayoutNoPercent" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                <TextView android:id="@+id/tv_answer_yes_telugu" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                <TextView android:id="@+id/tv_answer_yes_tamil" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                <TextView android:id="@+id/tv_answer_yes_selected" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                <TextView android:id="@+id/tv_answer_no_selected" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                <View android:id="@+id/card_view_survey" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</RelativeLayout>
