<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF8F0"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="10dp"
        android:background="#FFFFFF"
        android:elevation="2dp">

        <ImageButton
            android:id="@+id/birthday_auto_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/anynews"
            android:src="@drawable/ic_profile_chevron_right"
            android:rotation="180"
            app:tint="#222222" />

        <TextView
            android:id="@+id/birthday_auto_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="8dp"
            android:text="@string/birthday_special"
            android:textColor="#1F2937"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/birthday_auto_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/birthday_auto_hint"
                android:textColor="#6B7280"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/birthday_auto_live_preview"
                android:textColor="#374151"
                android:textSize="13sp"
                android:textStyle="bold" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="#FFFFFF"
                android:elevation="2dp"
                android:padding="6dp">

                <com.anyNews.anynews.Ui.BirthdayPosterPreviewView
                    android:id="@+id/birthday_auto_live_preview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/birthday_special" />

                <ImageView
                    android:id="@+id/birthday_auto_server_preview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    android:contentDescription="@string/birthday_special"
                    android:scaleType="fitCenter"
                    android:visibility="gone" />
            </FrameLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/birthday_pick_photo"
                android:textColor="#374151"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/birthday_auto_pick_photo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/birthday_pick_photo" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/birthday_auto_zoom"
                android:textColor="#6B7280"
                android:textSize="12sp" />

            <SeekBar
                android:id="@+id/birthday_auto_zoom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="20"
                android:progress="0" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/birthday_auto_name"
                android:textColor="#374151"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/birthday_auto_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/birthday_auto_name"
                android:inputType="textPersonName|textCapWords"
                android:maxLines="1" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/birthday_auto_address"
                android:textColor="#374151"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/birthday_auto_address"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/birthday_hint_location"
                android:inputType="textCapWords"
                android:maxLines="2" />

            <TextView
                android:id="@+id/birthday_auto_address_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/birthday_auto_address_note"
                android:textColor="#9CA3AF"
                android:textSize="11sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <CheckBox
                    android:id="@+id/birthday_auto_name_bold"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/birthday_auto_name_bold" />

                <CheckBox
                    android:id="@+id/birthday_auto_addr_bold"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/birthday_auto_addr_bold" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/birthday_auto_special"
                android:textColor="#374151"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/birthday_auto_special"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:hint="@string/birthday_auto_special"
                android:inputType="textMultiLine"
                android:maxLength="160"
                android:minLines="3" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/birthday_auto_post_title"
                android:textColor="#374151"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/birthday_auto_post_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/birthday_auto_post_title"
                android:inputType="textCapWords"
                android:maxLines="1" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/birthday_auto_date"
                android:textColor="#374151"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/birthday_auto_pick_date"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/birthday_auto_pick_date" />

            <TextView
                android:id="@+id/birthday_auto_schedule_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="#6B7280"
                android:textSize="12sp" />

            <Button
                android:id="@+id/birthday_auto_submit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="24dp"
                android:backgroundTint="#E63B19"
                android:text="@string/birthday_auto_submit"
                android:textColor="#FFFFFF" />
        </LinearLayout>
    </ScrollView>

    <ProgressBar
        android:id="@+id/birthday_auto_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:indeterminate="true"
        android:visibility="gone" />
</LinearLayout>
