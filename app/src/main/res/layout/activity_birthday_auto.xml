<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/birthday_auto_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF8F0"
    android:fitsSystemWindows="false"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/birthday_auto_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:elevation="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="10dp">

        <ImageButton
            android:id="@+id/birthday_auto_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/anynews"
            android:rotation="180"
            android:src="@drawable/ic_profile_chevron_right"
            app:tint="#222222" />

        <TextView
            android:id="@+id/birthday_auto_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="8dp"
            android:text="@string/birthday_special"
            android:textColor="#1F2937"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <!-- Screen starts at live banner preview (no instructional copy above). -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FFFFFF"
                android:elevation="2dp"
                android:padding="6dp">

                <com.anyNews.anynews.Ui.BirthdayPosterPreviewView
                    android:id="@+id/birthday_auto_live_preview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/birthday_special" />

                <ImageView
                    android:id="@+id/birthday_auto_server_preview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    android:contentDescription="@string/birthday_special"
                    android:scaleType="fitCenter"
                    android:visibility="gone" />
            </FrameLayout>

            <TextView
                android:id="@+id/birthday_auto_pan_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/birthday_auto_pan_hint"
                android:textColor="#E63B19"
                android:textSize="12sp" />

            <!-- Photo controls directly under preview so rotate is never below the fold. -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/birthday_pick_photo"
                android:textColor="#374151"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/birthday_auto_pick_photo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:backgroundTint="#E5E7EB"
                android:text="@string/birthday_pick_photo"
                android:textColor="#1F2937" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/birthday_auto_zoom"
                android:textColor="#6B7280"
                android:textSize="12sp" />

            <SeekBar
                android:id="@+id/birthday_auto_zoom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="20"
                android:progress="0" />

            <TextView
                android:id="@+id/birthday_auto_rotate_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/birthday_auto_rotate"
                android:textColor="#374151"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/birthday_auto_rotate_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/birthday_auto_rotate_hint"
                android:textColor="#6B7280"
                android:textSize="12sp" />

            <LinearLayout
                android:id="@+id/birthday_auto_rotate_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/birthday_auto_rot_0"
                    style="@style/Widget.AppCompat.Button.Borderless"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:backgroundTint="#FEE2E2"
                    android:minWidth="0dp"
                    android:text="0°"
                    android:textColor="#E63B19"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/birthday_auto_rot_90"
                    style="@style/Widget.AppCompat.Button.Borderless"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginHorizontal="4dp"
                    android:layout_weight="1"
                    android:backgroundTint="#F3F4F6"
                    android:minWidth="0dp"
                    android:text="90°"
                    android:textColor="#374151"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/birthday_auto_rot_180"
                    style="@style/Widget.AppCompat.Button.Borderless"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginHorizontal="4dp"
                    android:layout_weight="1"
                    android:backgroundTint="#F3F4F6"
                    android:minWidth="0dp"
                    android:text="180°"
                    android:textColor="#374151"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/birthday_auto_rot_270"
                    style="@style/Widget.AppCompat.Button.Borderless"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:backgroundTint="#F3F4F6"
                    android:minWidth="0dp"
                    android:text="270°"
                    android:textColor="#374151"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/birthday_auto_controls_scroll_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/birthday_auto_controls_scroll_hint"
                android:textColor="#9CA3AF"
                android:textSize="11sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/birthday_auto_name"
                android:textColor="#374151"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/birthday_auto_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/birthday_auto_name"
                android:inputType="textPersonName|textCapWords"
                android:maxLines="1"
                android:textColor="#1F2937"
                android:textColorHint="#6B7280" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/birthday_auto_font_style"
                android:textColor="#6B7280"
                android:textSize="12sp" />

            <Spinner
                android:id="@+id/birthday_auto_name_font"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:popupBackground="#FFFFFF"
                android:spinnerMode="dropdown" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/birthday_auto_font_size"
                android:textColor="#6B7280"
                android:textSize="12sp" />

            <Spinner
                android:id="@+id/birthday_auto_name_size"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:popupBackground="#FFFFFF"
                android:spinnerMode="dropdown" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/birthday_auto_address"
                android:textColor="#374151"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/birthday_auto_address"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/birthday_hint_location"
                android:inputType="textCapWords"
                android:maxLines="2"
                android:textColor="#1F2937"
                android:textColorHint="#6B7280" />

            <TextView
                android:id="@+id/birthday_auto_address_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/birthday_auto_address_note"
                android:textColor="#9CA3AF"
                android:textSize="11sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/birthday_auto_addr_font_style"
                android:textColor="#6B7280"
                android:textSize="12sp"
                android:visibility="gone" />

            <Spinner
                android:id="@+id/birthday_auto_addr_font"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:popupBackground="#FFFFFF"
                android:spinnerMode="dropdown"
                android:visibility="gone" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/birthday_auto_font_size"
                android:textColor="#6B7280"
                android:textSize="12sp" />

            <Spinner
                android:id="@+id/birthday_auto_addr_size"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:popupBackground="#FFFFFF"
                android:spinnerMode="dropdown" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <CheckBox
                    android:id="@+id/birthday_auto_name_bold"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:buttonTint="#1F2937"
                    android:text="@string/birthday_auto_name_bold"
                    android:textColor="#1F2937" />

                <CheckBox
                    android:id="@+id/birthday_auto_addr_bold"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:buttonTint="#1F2937"
                    android:text="@string/birthday_auto_addr_bold"
                    android:textColor="#1F2937" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/birthday_auto_special"
                android:textColor="#374151"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/birthday_auto_special"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:hint="@string/birthday_auto_special"
                android:inputType="textMultiLine"
                android:maxLength="160"
                android:minLines="3"
                android:textColor="#1F2937"
                android:textColorHint="#6B7280" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/birthday_auto_post_title"
                android:textColor="#374151"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/birthday_auto_post_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/birthday_auto_post_title"
                android:inputType="textCapWords"
                android:maxLines="1"
                android:textColor="#1F2937"
                android:textColorHint="#6B7280" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/birthday_auto_date"
                android:textColor="#374151"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/birthday_auto_pick_date"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="#E5E7EB"
                android:text="@string/birthday_auto_pick_date"
                android:textColor="#1F2937" />

            <TextView
                android:id="@+id/birthday_auto_schedule_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="#6B7280"
                android:textSize="12sp" />

            <Button
                android:id="@+id/birthday_auto_submit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:backgroundTint="#E63B19"
                android:text="@string/birthday_auto_submit"
                android:textColor="#FFFFFF" />

            <TextView
                android:id="@+id/birthday_auto_my_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="@string/birthday_auto_my_posts"
                android:textColor="#1F2937"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/birthday_auto_my_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/birthday_auto_my_empty"
                android:textColor="#9CA3AF"
                android:textSize="12sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/birthday_auto_my_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="24dp"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>

    <ProgressBar
        android:id="@+id/birthday_auto_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:indeterminate="true"
        android:visibility="gone" />
</LinearLayout>
