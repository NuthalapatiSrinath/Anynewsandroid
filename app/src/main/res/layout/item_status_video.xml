<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="10dp"
    android:paddingEnd="16dp"
    android:paddingBottom="10dp">

    <FrameLayout
        android:layout_width="88dp"
        android:layout_height="72dp">

        <ImageView
            android:id="@+id/status_video_thumb"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/image_placeholder"
            android:contentDescription="@string/status_videos"
            android:scaleType="centerCrop" />

        <!-- Small play affordance — does not hide the real Special poster. -->
        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center"
            android:alpha="0.92"
            android:background="@drawable/bg_profile_hub_orange_circle"
            android:contentDescription="@null"
            android:padding="6dp"
            android:src="@drawable/ic_hub_status_videos"
            app:tint="@color/on_brand_text" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/status_video_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_special_badge"
            android:paddingStart="8dp"
            android:paddingTop="2dp"
            android:paddingEnd="8dp"
            android:paddingBottom="2dp"
            android:text="@string/special_badge"
            android:textColor="@color/on_brand_text"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/status_video_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/status_list_title"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/status_video_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/status_list_subtitle"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
