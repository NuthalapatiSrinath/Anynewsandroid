<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Activities.StartingActivity">

    <!-- Underlays first: Opening Banner ImageView must be last so FIT_XY
         paint is never covered by net_avilable's black waiting plate. -->
    <LinearLayout
        android:id="@+id/net_avilable"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="visible">

        <TextView
            android:id="@+id/welcome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_40sdp"
            android:gravity="center"
            android:text=""
            android:textColor="@color/red_one"
            android:visibility="gone" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="70dp"
            style="@style/TextStyle4"
            android:text="Loading..."
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/net_not_avilable"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:theme="@style/AppThemeBG"
        android:visibility="gone">
        <include layout="@layout/no_internet_scrren" />
    </LinearLayout>

    <ImageView
        android:id="@+id/logo_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:visibility="gone" />

    <!-- Full-bleed Opening Banner (FIT_XY — all four edges, no crop). Topmost. -->
    <ImageView
        android:id="@+id/logo_image_server"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:adjustViewBounds="false"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:visibility="visible" />
</FrameLayout>
