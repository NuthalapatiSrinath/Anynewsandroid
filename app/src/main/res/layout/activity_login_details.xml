<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/login_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_color"
    android:fitsSystemWindows="true"
    tools:context=".Activities.LoginActivityDetails">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"></View>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1.5"
            android:gravity="center">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/logo_image">

            </ImageView>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/login_detailes"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="6"
            android:gravity="center"
            android:orientation="vertical">


            <soup.neumorphism.NeumorphCardView
                android:layout_width="match_parent"
                android:layout_height="@dimen/_70sdp"
                android:layout_below="@+id/basin_image_view"
                android:layout_marginLeft="@dimen/_20sdp"
                android:layout_marginTop="8dp"
                android:layout_marginRight="@dimen/_20sdp"
                android:scaleType="centerInside"
                app:layout_constraintEnd_toEndOf="parent"
                app:neumorph_backgroundColor="@color/neomorph_background_color"
                app:neumorph_shadowColorDark="@color/neomorph_shadow_color"
                app:neumorph_shadowColorLight="@color/neomorph_highlight_color"
                app:neumorph_shadowElevation="6dp"
                app:neumorph_shapeAppearance="@style/Login_ShapeAppearance"
                app:neumorph_shapeType="pressed"
                app:neumorph_strokeColor="@color/neomorph_shadow_color"
                app:neumorph_strokeWidth="0.5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center">

                    <EditText
                        android:id="@+id/username_et"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@null"
                        android:drawableLeft="@drawable/ic_username_icon"
                        android:drawablePadding="10dp"
                        android:hint="@string/edittext_enter_user_name"
                        android:inputType="text"
                        android:layout_marginLeft="10dp"
                        android:maxLength="30"
                        android:maxLines="1"
                        android:minLines="1"
                        android:lines="1"
                        android:textColor="@color/text_color_primary"
                        android:textColorHint="@color/login_hint_color">

                    </EditText>
                </LinearLayout>


            </soup.neumorphism.NeumorphCardView>


            <soup.neumorphism.NeumorphCardView
                android:layout_width="match_parent"
                android:layout_height="@dimen/_70sdp"
                android:layout_below="@+id/basin_image_view"
                android:layout_marginLeft="@dimen/_20sdp"
                android:layout_marginTop="8dp"
                android:layout_marginRight="@dimen/_20sdp"
                android:scaleType="centerInside"
                android:visibility="visible"
                app:layout_constraintEnd_toEndOf="parent"
                app:neumorph_backgroundColor="@color/neomorph_background_color"
                app:neumorph_shadowColorDark="@color/neomorph_shadow_color"
                app:neumorph_shadowColorLight="@color/neomorph_highlight_color"
                app:neumorph_shadowElevation="6dp"
                app:neumorph_shapeAppearance="@style/Login_ShapeAppearance"
                app:neumorph_shapeType="pressed"
                app:neumorph_strokeColor="@color/neomorph_shadow_color"
                app:neumorph_strokeWidth="0.5dp">

                <LinearLayout

                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center">

                    <EditText
                        android:id="@+id/mobile_et"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@null"
                        android:drawableLeft="@drawable/ic_phone_icon"
                        android:drawablePadding="10dp"
                        android:hint="@string/edittext_enter_phone_number"
                        android:inputType="phone"
                        android:layout_marginLeft="10dp"
                        android:maxLines="1"
                        android:maxLength="10"
                        android:textColor="@color/text_color_primary"
                        android:textColorHint="@color/login_hint_color">

                    </EditText>
                </LinearLayout>

            </soup.neumorphism.NeumorphCardView>
            <soup.neumorphism.NeumorphCardView
                android:layout_width="match_parent"
                android:layout_height="@dimen/_70sdp"
                android:layout_below="@+id/basin_image_view"
                android:layout_marginLeft="@dimen/_20sdp"
                android:layout_marginTop="8dp"
                android:layout_marginRight="@dimen/_20sdp"
                android:scaleType="centerInside"
                android:visibility="visible"
                app:layout_constraintEnd_toEndOf="parent"
                app:neumorph_backgroundColor="@color/neomorph_background_color"
                app:neumorph_shadowColorDark="@color/neomorph_shadow_color"
                app:neumorph_shadowColorLight="@color/neomorph_highlight_color"
                app:neumorph_shadowElevation="6dp"
                app:neumorph_shapeAppearance="@style/Login_ShapeAppearance"
                app:neumorph_shapeType="pressed"
                app:neumorph_strokeColor="@color/neomorph_shadow_color"
                app:neumorph_strokeWidth="0.5dp">

                <LinearLayout

                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center">

                    <EditText
                        android:id="@+id/emailId"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@null"
                        android:drawableLeft="@android:drawable/sym_action_email"
                        android:drawablePadding="10dp"
                        android:drawableTint="@color/login_icon_tint"
                        android:hint="Email Id"
                        android:layout_marginLeft="10dp"
                        android:maxLines="1"
                        android:clickable="false"
                        android:cursorVisible="false"
                        android:focusable="false"
                        android:focusableInTouchMode="false"
                        android:textColor="@color/text_color_primary"
                        android:textColorHint="@color/login_hint_color">

                    </EditText>
                </LinearLayout>

            </soup.neumorphism.NeumorphCardView>

            <LinearLayout
                android:visibility="gone"
                android:id="@+id/sendotpnew"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <soup.neumorphism.NeumorphCardView
                    style="@style/Widget.Neumorph.ImageButton"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/_48sdp"
                    android:layout_below="@+id/basin_image_view"
                    android:gravity="center"
                    android:scaleType="centerInside"
                    android:textSize="@dimen/_15sdp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:neumorph_shadowColorDark="@color/neomorph_shadow_color"
                    app:neumorph_shadowColorLight="@color/neomorph_highlight_color"
                    app:neumorph_shadowElevation="0dp"
                    app:neumorph_shapeType="flat"
                    app:neumorph_strokeColor="@color/brand_orange"
                    app:neumorph_strokeWidth="2dp">


                    <TextView
                        android:id="@+id/otpnew"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@color/brand_orange"
                        android:gravity="center"
                        android:paddingLeft="@dimen/_40sdp"
                        android:paddingRight="@dimen/_40sdp"
                        android:text="Send OTP"
                        android:textColor="@color/on_brand_text"
                        android:textSize="@dimen/_12sdp"
                        android:textStyle="bold"
                        android:visibility="visible">

                    </TextView>

                </soup.neumorphism.NeumorphCardView>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/post_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <soup.neumorphism.NeumorphCardView
                    android:id="@+id/neumorph_next"
                    style="@style/Widget.Neumorph.ImageButton"
                    android:layout_width="wrap_content"
                    android:layout_height="63dp"
                    android:layout_below="@+id/basin_image_view"
                    android:gravity="center"
                    android:scaleType="centerInside"
                    android:text="Next"
                    android:textSize="@dimen/_15sdp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:neumorph_backgroundColor="@color/brand_orange"
                    app:neumorph_shadowColorDark="@color/neomorph_shadow_color"
                    app:neumorph_shadowColorLight="@color/neomorph_highlight_color"
                    app:neumorph_shadowElevation="4dp"
                    app:neumorph_shapeType="flat"
                    app:neumorph_strokeColor="@color/brand_orange"
                    app:neumorph_strokeWidth="2dp">


                    <TextView
                        android:id="@+id/post_login"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@color/brand_orange"
                        android:gravity="center"
                        android:paddingLeft="@dimen/_40sdp"
                        android:paddingRight="@dimen/_40sdp"
                        android:text="Send OTP"
                        android:textColor="@color/on_brand_text"
                        android:textSize="@dimen/_15sdp"
                        android:textStyle="bold">

                    </TextView>


                </soup.neumorphism.NeumorphCardView>
            </LinearLayout>


        </LinearLayout>

        <LinearLayout
            android:visibility="gone"
            android:id="@+id/otp_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="60dp"
            android:orientation="horizontal"
          >

            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="2">

            </View>

            <soup.neumorphism.NeumorphCardView
                style="@style/New.Widget.Neumorph.CardView"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_gravity="center"
                android:layout_marginRight="@dimen/ten"
                app:layout_constraintEnd_toEndOf="parent"
                app:neumorph_shapeAppearance="@style/ShapeAppearance"
                app:neumorph_shapeType="pressed"
                app:neumorph_strokeColor="@color/neomorph_shadow_color"
                app:neumorph_strokeWidth="0.4dp">

                <EditText
                    android:id="@+id/otp_1"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_margin="@dimen/one"
                    android:background="@null"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:gravity="center"
                    android:inputType="number"
                    android:maxLength="1"
                    android:maxLines="1"
                    android:textColor="@color/text_color_primary">

                </EditText>
            </soup.neumorphism.NeumorphCardView>

            <soup.neumorphism.NeumorphCardView

                style="@style/New.Widget.Neumorph.CardView"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_gravity="center"
                android:layout_marginRight="@dimen/ten"
                app:layout_constraintEnd_toEndOf="parent"
                app:neumorph_shapeAppearance="@style/ShapeAppearance"
                app:neumorph_shapeType="pressed"
                app:neumorph_strokeColor="@color/neomorph_shadow_color"
                app:neumorph_strokeWidth="0.4dp">

                <EditText
                    android:id="@+id/otp_2"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_margin="@dimen/one"
                    android:background="@null"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:gravity="center"
                    android:inputType="number"
                    android:maxLength="1"
                    android:maxLines="1"
                    android:textColor="@color/text_color_primary">

                </EditText>
            </soup.neumorphism.NeumorphCardView>

            <soup.neumorphism.NeumorphCardView

                style="@style/New.Widget.Neumorph.CardView"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_gravity="center"
                android:layout_marginRight="@dimen/ten"
                app:layout_constraintEnd_toEndOf="parent"
                app:neumorph_shapeAppearance="@style/ShapeAppearance"
                app:neumorph_shapeType="pressed"
                app:neumorph_strokeColor="@color/neomorph_shadow_color"
                app:neumorph_strokeWidth="0.4dp">

                <EditText
                    android:id="@+id/otp_3"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_margin="@dimen/one"
                    android:background="@null"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:gravity="center"
                    android:inputType="number"
                    android:maxLength="1"
                    android:maxLines="1"
                    android:textColor="@color/text_color_primary">

                </EditText>
            </soup.neumorphism.NeumorphCardView>

            <soup.neumorphism.NeumorphCardView

                style="@style/New.Widget.Neumorph.CardView"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_gravity="center"
                android:layout_marginRight="@dimen/ten"
                app:layout_constraintEnd_toEndOf="parent"
                app:neumorph_shapeAppearance="@style/ShapeAppearance"
                app:neumorph_shapeType="pressed"
                app:neumorph_strokeColor="@color/neomorph_shadow_color"
                app:neumorph_strokeWidth="0.4dp">

                <EditText
                    android:id="@+id/otp_4"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_margin="@dimen/one"
                    android:layout_marginLeft="@dimen/one"
                    android:background="@null"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:gravity="center"
                    android:inputType="number"
                    android:maxLength="1"
                    android:maxLines="1"
                    android:textColor="@color/text_color_primary">

                </EditText>
            </soup.neumorphism.NeumorphCardView>

            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="2">

            </View>
        </LinearLayout>


        <LinearLayout
            android:id="@+id/verify_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="60dp"
            android:gravity="top|center"
            android:visibility="gone">

            <soup.neumorphism.NeumorphCardView
                style="@style/Widget.Neumorph.ImageButton"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/_48sdp"
                android:layout_below="@+id/basin_image_view"
                android:gravity="center"
                android:scaleType="centerInside"
                android:text="Next"
                android:textSize="@dimen/_15sdp"
                app:layout_constraintEnd_toEndOf="parent"
                app:neumorph_shadowColorDark="@color/neomorph_shadow_color"
                app:neumorph_shadowColorLight="@color/neomorph_highlight_color"
                app:neumorph_shadowElevation="0dp"
                app:neumorph_shapeType="flat"
                app:neumorph_strokeColor="@color/brand_orange"
                app:neumorph_strokeWidth="2dp">


                <TextView
                    android:id="@+id/txt_mobile_otp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="We have sent a “4 digit OTP”\nOn +91 9988776655 "
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/otp_submit"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/brand_orange"
                    android:gravity="center"
                    android:paddingLeft="@dimen/_40sdp"
                    android:paddingRight="@dimen/_40sdp"
                    android:text="Verify"
                    android:textColor="@color/on_brand_text"
                    android:textSize="@dimen/_12sdp"
                    android:textStyle="bold"
                    android:visibility="visible">

                </TextView>

            </soup.neumorphism.NeumorphCardView>

        </LinearLayout>

        <LinearLayout
            android:visibility="gone"
            android:id="@+id/resend_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/login_detailes"
            android:layout_marginTop="20dp"
            android:gravity="top|center"
           >

            <soup.neumorphism.NeumorphCardView
                style="@style/Widget.Neumorph.ImageButton"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/_48sdp"
                android:layout_below="@+id/basin_image_view"
                android:gravity="center"
                android:scaleType="centerInside"
                android:text="Next"
                android:textSize="@dimen/_15sdp"
                app:layout_constraintEnd_toEndOf="parent"
                app:neumorph_shadowColorDark="@color/neomorph_shadow_color"
                app:neumorph_shadowColorLight="@color/neomorph_highlight_color"
                app:neumorph_shadowElevation="0dp"
                app:neumorph_shapeType="flat"
                app:neumorph_strokeColor="@color/brand_orange"
                app:neumorph_strokeWidth="2dp">


                <TextView
                    android:id="@+id/txt_resend_otp"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/brand_orange"
                    android:gravity="center"
                    android:paddingLeft="@dimen/_40sdp"
                    android:paddingRight="@dimen/_40sdp"
                    android:text="Resend OTP"
                    android:textColor="@color/on_brand_text"
                    android:textSize="@dimen/_12sdp"
                    android:textStyle="bold"
                    android:visibility="visible">

                </TextView>

            </soup.neumorphism.NeumorphCardView>

        </LinearLayout>


        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="2">

        </View>

    </LinearLayout>


</RelativeLayout>


