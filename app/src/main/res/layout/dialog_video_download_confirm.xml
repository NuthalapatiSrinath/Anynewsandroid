<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_full_video_option_dialog"
    android:orientation="vertical"
    android:paddingTop="18dp">

    <TextView
        android:id="@+id/video_download_confirm_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:text="@string/full_video_option_dialog_title"
        android:textColor="@color/full_video_option_title"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/video_download_confirm_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="14dp"
        android:text="@string/video_download_confirm_message"
        android:textColor="@color/full_video_option_message"
        android:textSize="15sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:background="@color/full_video_option_divider" />

    <TextView
        android:id="@+id/video_download_confirm_ok"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="@string/video_download_confirm_ok"
        android:textColor="@color/full_video_option_action"
        android:textSize="20sp" />

</LinearLayout>
