<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <ImageView
        android:id="@+id/status_page_poster"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <androidx.media3.ui.PlayerView
        android:id="@+id/status_page_exo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        app:show_buffering="when_playing"
        app:use_controller="true" />

    <com.pierfrancescosoffritti.androidyoutubeplayer.core.player.views.YouTubePlayerView
        android:id="@+id/status_page_youtube"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        app:enableAutomaticInitialization="false" />

    <ProgressBar
        android:id="@+id/status_page_progress"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="center"
        android:indeterminateTint="@color/red"
        android:visibility="gone" />

    <!-- Right-side chrome mirrors Special full_video (video_side_menu). -->
    <LinearLayout
        android:id="@+id/status_page_side_menu"
        android:layout_width="60dp"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="10dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/status_page_writer_pic"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginBottom="14dp"
            android:scaleType="centerCrop"
            app:civ_border_color="@color/on_brand_text"
            app:civ_border_width="2dp" />

        <LinearLayout
            android:id="@+id/status_page_like"
            android:layout_width="50dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/status_page_like_icon"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:contentDescription="@string/like_image"
                android:src="@drawable/ic_like_half1" />

            <TextView
                android:id="@+id/status_page_like_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="0"
                android:textColor="@color/on_brand_text"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/status_page_comment"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/status_page_comment_icon"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:contentDescription="@string/comment_image"
                android:src="@drawable/ic_comment_half1" />

            <TextView
                android:id="@+id/status_page_comment_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="0"
                android:textColor="@color/on_brand_text"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/status_page_share"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/status_page_share_icon"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:contentDescription="@string/share_image"
                android:src="@drawable/ic_share_half1" />

            <TextView
                android:id="@+id/status_page_share_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="0"
                android:textColor="@color/on_brand_text"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/status_page_report"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/status_page_report_icon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:contentDescription="@string/report_content"
                android:src="@drawable/ic_action_report" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/report_content"
                android:textColor="@color/on_brand_text"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginEnd="72dp"
        android:background="#99000000"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="20dp">

        <TextView
            android:id="@+id/status_page_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="3"
            android:textColor="@color/on_brand_text"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/status_page_writer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#CCFFFFFF"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/status_page_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#99FFFFFF"
            android:textSize="11sp" />
    </LinearLayout>
</FrameLayout>
