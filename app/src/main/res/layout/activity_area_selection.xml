<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:orientation="vertical"
    android:layout_height="match_parent"
    android:background="@color/whitewithblack">

    <LinearLayout
        android:id="@+id/card_header"
        android:background="@color/background_color"
        android:layout_width="match_parent"
        android:layout_height="52dp">

        <RelativeLayout
            android:background="@color/whitewithblack"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/img_back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginLeft="14dp"
                android:src="@drawable/ic_back_arrow"
                app:tint="@color/black" />

            <TextView
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:lineSpacingExtra="2sp"
                android:text=""
                android:textColor="@color/on_brand_text"
                android:textSize="16sp" />



        </RelativeLayout>

    </LinearLayout>


    <LinearLayout
        android:id="@+id/layout_with_data"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <View
            android:layout_width="match_parent"
            android:layout_weight="0.4"
            android:layout_height="0dp">  </View>

        <LinearLayout

            android:id="@+id/linear"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <TextView
                android:id="@+id/select_language"
                android:gravity="top|center"
                android:textColor="@color/title_color"
                android:textStyle="bold"
                android:textSize="@dimen/_20sdp"
                android:text="Select State"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

            </TextView>

        </LinearLayout>


        <LinearLayout
            android:layout_below="@+id/linear"
            android:layout_width="match_parent"
            android:gravity="center"
            android:layout_height="0dp"
            android:layout_weight="7">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/area_details"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

            </androidx.recyclerview.widget.RecyclerView>

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/layout_with_out_data"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <include layout="@layout/layout_loading"></include>

    </LinearLayout>


</LinearLayout>
