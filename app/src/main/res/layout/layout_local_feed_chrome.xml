<?xml version="1.0" encoding="utf-8"?>
<!-- Mana Zilla local path chrome: district · local label + dropdown to switch Main/Local. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/local_feed_chrome_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#66000000"
    android:clickable="true"
    android:elevation="12dp"
    android:focusable="true"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <ImageButton
            android:id="@+id/local_feed_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_arrowwhite_back" />

        <LinearLayout
            android:id="@+id/local_feed_dropdown_row"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="12dp"
            android:layout_weight="1"
            android:background="@drawable/bg_home_mode_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="10dp">

            <TextView
                android:id="@+id/local_feed_context_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="#FFFFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- Keep legacy ids for any stale findViewById; hidden -->
            <TextView
                android:id="@+id/local_feed_seg_local"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/local_feed_seg_district"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <View
                android:id="@+id/local_feed_thumb"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <FrameLayout
                android:id="@+id/local_feed_pill"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <!-- Dropdown: switch Main News ↔ Local district -->
            <ImageView
                android:id="@+id/local_feed_dropdown_icon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginStart="8dp"
                android:contentDescription="Switch feed"
                android:src="@drawable/ic_local_feed_dropdown" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
