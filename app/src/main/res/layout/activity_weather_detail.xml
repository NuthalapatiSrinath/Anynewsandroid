<?xml version="1.0" encoding="utf-8"?>
<!-- Weather detail — match admin WeatherPreview (dark + orange accent). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/weather_detail_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF0B0B0D"
    android:fitsSystemWindows="false">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/weather_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="ifContentScrolls">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="32dp">

            <!-- Header: back | title | share -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="12dp"
                android:paddingTop="10dp"
                android:paddingEnd="12dp"
                android:paddingBottom="4dp">

                <ImageView
                    android:id="@+id/weather_back"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/cancel"
                    android:padding="8dp"
                    android:src="@drawable/ic_calendar_chevron_left"
                    android:tint="#FFFF6A1A" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/weather_top_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/weather_title"
                        android:textColor="#FFFF6A1A"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/weather_top_subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/weather_subtitle"
                        android:textColor="#FF94A3B8"
                        android:textSize="10sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/weather_share"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/local_update_share"
                    android:padding="9dp"
                    android:src="@drawable/ic_baseline_share_24"
                    android:tint="#FFFF6A1A" />
            </RelativeLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingBottom="8dp">

                <!-- Hero: fixed ~200dp so alert + 3-day fit on first viewport -->
                <FrameLayout
                    android:id="@+id/weather_hero"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:layout_marginTop="4dp">

                    <ImageView
                        android:id="@+id/weather_hero_image"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/weather_hero_sun" />

                    <View
                        android:id="@+id/weather_hero_scrim"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_weather_hero_scrim" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:paddingStart="12dp"
                        android:paddingTop="10dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="10dp">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentStart="true"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/weather_location"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textColor="#FFFFFFFF"
                                    android:textSize="14sp"
                                    android:textStyle="bold"
                                    tools:text="📍 అనకాపల్లి" />

                                <TextView
                                    android:id="@+id/weather_region"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textColor="#B3FFFFFF"
                                    android:textSize="10sp"
                                    tools:text="ఆంధ్రప్రదేశ్, భారత్" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:gravity="end"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="చివరి నవీకరణ"
                                    android:textColor="#BFFFFFFF"
                                    android:textSize="9sp" />

                                <TextView
                                    android:id="@+id/weather_updated"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textColor="#E6FFFFFF"
                                    android:textSize="9sp"
                                    android:textStyle="bold"
                                    tools:text="ఈరోజూ 10:30 AM" />
                            </LinearLayout>
                        </RelativeLayout>

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_marginTop="8dp"
                            android:layout_weight="1">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentStart="true"
                                android:layout_centerVertical="true"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/weather_temp"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:includeFontPadding="false"
                                    android:textColor="#FFFFFFFF"
                                    android:textSize="42sp"
                                    android:textStyle="bold"
                                    tools:text="31°C" />

                                <TextView
                                    android:id="@+id/weather_condition"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textColor="#E6FFFFFF"
                                    android:textSize="13sp"
                                    tools:text="పాక్షిక మేఘావృతం" />

                                <TextView
                                    android:id="@+id/weather_feels"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:textColor="#CCFFFFFF"
                                    android:textSize="10sp"
                                    tools:text="అనుభూతి: 34°C  గరిష్టం: 32°C  కనిష్టం: 25°C" />
                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/weather_stats_box"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"
                                android:background="@drawable/bg_local_update_glass"
                                android:orientation="vertical"
                                android:paddingStart="10dp"
                                android:paddingTop="8dp"
                                android:paddingEnd="10dp"
                                android:paddingBottom="8dp">

                                <TextView
                                    android:id="@+id/weather_humidity"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textColor="#E6FFFFFF"
                                    android:textSize="10sp"
                                    tools:text="తేమ 62%" />

                                <TextView
                                    android:id="@+id/weather_wind"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textColor="#E6FFFFFF"
                                    android:textSize="10sp"
                                    tools:text="గాలి వేగం 14 km/h" />

                                <TextView
                                    android:id="@+id/weather_wind_dir"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textColor="#E6FFFFFF"
                                    android:textSize="10sp"
                                    tools:text="గాలి దిశ SW" />

                                <TextView
                                    android:id="@+id/weather_visibility"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textColor="#E6FFFFFF"
                                    android:textSize="10sp"
                                    tools:text="దృష్టి దూరం 10 km" />
                            </LinearLayout>
                        </RelativeLayout>
                    </LinearLayout>
                </FrameLayout>

                <!-- Alert -->
                <LinearLayout
                    android:id="@+id/weather_alert"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_local_update_card"
                    android:orientation="vertical"
                    android:paddingStart="12dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="వాతావరణ సూచన"
                        android:textColor="#FF6EE7B7"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/weather_alert_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="#D9FFFFFF"
                        android:textSize="11sp"
                        tools:text="ఈరోజు భారీ వర్షాలు లేవు." />
                </LinearLayout>

                <!-- 3-day -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:text="రాబోయే 3 రోజులు"
                        android:textColor="#FFFFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/weather_forecast_7day_btn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingStart="8dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="0dp"
                        android:paddingBottom="4dp"
                        android:text="7 రోజుల ఫోరకాస్ట్ ›"
                        android:textColor="#FFFF6A1A"
                        android:textSize="10sp" />
                </RelativeLayout>

                <LinearLayout
                    android:id="@+id/weather_forecast_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal"
                    android:weightSum="3" />

                <!-- Hourly -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="24 గంటల వివరాలు"
                    android:textColor="#FFFFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:overScrollMode="never"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/weather_hourly_row"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <!-- Sun -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="సూర్యోదయం &amp; సూర్యాస్తమయం"
                    android:textColor="#FFFFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_local_update_card"
                    android:orientation="horizontal"
                    android:padding="14dp"
                    android:weightSum="2">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="సూర్యోదయం"
                            android:textColor="#FF94A3B8"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/weather_sunrise"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#FFFFFFFF"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            tools:text="05:59 AM" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="సూర్యాస్తమయం"
                            android:textColor="#FF94A3B8"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/weather_sunset"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#FFFFFFFF"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            tools:text="06:23 PM" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/weather_source"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:textColor="#FF64748B"
                    android:textSize="10sp"
                    tools:text="Source: OpenWeather" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</FrameLayout>
