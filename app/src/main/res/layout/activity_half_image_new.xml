<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/parent_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical">


    <RelativeLayout
        android:id="@+id/layoutMain"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/relative_half_contents"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/white"
            android:orientation="vertical">

                <RelativeLayout
                    android:id="@+id/layoutImageHeight"
                    android:layout_width="match_parent"
                    android:layout_height="340dp"
                    android:background="@color/image_placeholder">
                    <RelativeLayout
                        android:id="@+id/galleryImageLayout"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:visibility="gone">
                        <androidx.viewpager.widget.ViewPager
                            android:id="@+id/viewpager"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent" />
                        <LinearLayout
                            android:id="@+id/dotIndicatior"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_alignParentBottom="true"
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:layout_marginBottom="@dimen/_10sdp">

                            <LinearLayout
                                android:id="@+id/video_side_menu"
                                android:layout_width="@dimen/_150sdp"
                                android:layout_height="@dimen/_26sdp"
                                android:gravity="center"
                                android:background="@drawable/gallery_strip"
                                android:orientation="vertical"
                                android:visibility="visible">

                                <com.tbuonomo.viewpagerdotsindicator.WormDotsIndicator
                                    android:id="@+id/indicator"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    app:dotsColor="@color/colorPrimary"
                                    app:dotsCornerRadius="8dp"
                                    app:dotsSize="12dp"
                                    app:dotsSpacing="4dp"
                                    app:dotsStrokeColor="@color/white"
                                    app:dotsWidthFactor="2.5" />
                            </LinearLayout>

                        </LinearLayout>

                    </RelativeLayout>

                    <ImageView
                        android:id="@+id/new_half_image"
                        android:layout_width="match_parent"
                        android:layout_height="340dp"
                        android:background="@color/image_placeholder"
                        android:scaleType="fitXY" />

                    <TextView
                        android:id="@+id/textViewWebUrl"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_alignParentBottom="true"
                        android:layout_marginLeft="@dimen/_12sdp"
                        android:layout_marginBottom="10dp"
                        android:background="@drawable/url_background"
                        android:padding="5dp"
                        android:textColor="@color/on_brand_text"
                        android:textSize="8dp" />
                </RelativeLayout>

            <!--middle content like comment share-->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-15dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:minHeight="44dp"
                android:orientation="horizontal"
                android:visibility="visible">


                <LinearLayout
                    android:id="@+id/with_out_strips_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:gravity="center_vertical|end"
                    android:orientation="horizontal"
                    android:paddingEnd="8dp"
                    android:visibility="visible">

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <LinearLayout
                        android:id="@+id/half_image_like_icon"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:layout_marginEnd="8dp"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:gravity="center">

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:clipChildren="false"
                            android:clipToPadding="false">

                            <ImageView
                                android:id="@+id/half_image_like"
                                android:layout_width="35dp"
                                android:layout_height="35dp"
                                android:layout_gravity="center"
                                android:background="@drawable/white_oval"
                                android:contentDescription="@string/like_image"
                                android:padding="7dp"
                                android:src="@drawable/ic_action_like" />

                            <TextView
                                android:id="@+id/half_like_count"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="bottom|end"
                                android:layout_marginEnd="-3dp"
                                android:layout_marginBottom="-3dp"
                                android:background="@drawable/bg_engagement_count_badge"
                                android:elevation="4dp"
                                android:fontFamily="@font/roboto_medium"
                                android:gravity="center"
                                android:minWidth="14dp"
                                android:minHeight="14dp"
                                android:paddingStart="2dp"
                                android:paddingEnd="2dp"
                                android:textColor="@color/engagement_badge_text"
                                android:textSize="9sp"
                                android:textStyle="bold"
                                android:visibility="gone" />

                        </FrameLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/half_comment"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:layout_marginEnd="8dp"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:gravity="center">

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:clipChildren="false"
                            android:clipToPadding="false">

                            <ImageView
                                android:id="@+id/half_comment_icon"
                                android:layout_width="35dp"
                                android:layout_height="35dp"
                                android:layout_gravity="center"
                                android:background="@drawable/white_oval"
                                android:contentDescription="@string/comment_image"
                                android:padding="7dp"
                                android:src="@drawable/ic_action_comment" />

                            <TextView
                                android:id="@+id/half_comment_count"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="bottom|end"
                                android:layout_marginEnd="-3dp"
                                android:layout_marginBottom="-3dp"
                                android:background="@drawable/bg_engagement_count_badge"
                                android:elevation="4dp"
                                android:fontFamily="@font/roboto_medium"
                                android:gravity="center"
                                android:minWidth="14dp"
                                android:minHeight="14dp"
                                android:paddingStart="2dp"
                                android:paddingEnd="2dp"
                                android:textColor="@color/engagement_badge_text"
                                android:textSize="9sp"
                                android:textStyle="bold"
                                android:visibility="gone" />

                        </FrameLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/half_share"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:layout_marginEnd="8dp"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:gravity="center">

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:clipChildren="false"
                            android:clipToPadding="false">

                            <ImageView
                                android:id="@+id/half_share_icon"
                                android:layout_width="35dp"
                                android:layout_height="35dp"
                                android:layout_gravity="center"
                                android:background="@drawable/white_oval"
                                android:contentDescription="@string/share_image"
                                android:padding="7dp"
                                android:src="@drawable/ic_action_share" />

                            <TextView
                                android:id="@+id/half_share_count"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="bottom|end"
                                android:layout_marginEnd="-3dp"
                                android:layout_marginBottom="-3dp"
                                android:background="@drawable/bg_engagement_count_badge"
                                android:elevation="4dp"
                                android:fontFamily="@font/roboto_medium"
                                android:gravity="center"
                                android:minWidth="14dp"
                                android:minHeight="14dp"
                                android:paddingStart="2dp"
                                android:paddingEnd="2dp"
                                android:textColor="@color/engagement_badge_text"
                                android:textSize="9sp"
                                android:textStyle="bold"
                                android:visibility="gone" />

                        </FrameLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/report"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:layout_marginEnd="4dp"
                        android:gravity="center">

                        <ImageView
                            android:id="@+id/report_icon"
                            android:layout_width="35dp"
                            android:layout_height="35dp"
                            android:background="@drawable/white_oval"
                            android:padding="7dp"
                            android:src="@drawable/ic_action_report" />

                    </LinearLayout>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/with_strips_layout"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:paddingLeft="@dimen/_15sdp"
                    android:visibility="visible">

                    <ImageView
                        android:id="@+id/with_strips_layout_ic"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_gravity="center"
                        android:layout_marginStart="1sp"
                        android:src="@drawable/app_share_logo"
                        />

                        <LinearLayout
                            android:layout_width="@dimen/_65sdp"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_marginLeft="5dp"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/colorPrimary"
                                android:text="ANYNEWS"
                                android:layout_gravity="center"
                                android:gravity="center"
                                android:textFontWeight="200"
                                android:background="@drawable/text_bg_red"
                                android:fontFamily="@font/inter_black"
                                android:textSize="@dimen/_10sdp"/>
                            <TextView
                                android:id="@+id/textViewStripWebUrl"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="anws.in/934890"
                                android:fontFamily="@font/roboto_medium"
                                android:textSize="8dp"
                                android:textFontWeight="400"
                                android:layout_gravity="center"
                                android:textColor="@color/content_title_color"
                                />

                        </LinearLayout>




                    <TextView
                        android:id="@+id/strip_text_name"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="2sp"
                        android:layout_weight="6"
                        android:paddingLeft="@dimen/_10sdp"
                        android:fontFamily="@font/roboto_bold"
                        android:gravity="center|left"
                        android:text="The Best Regional News App"
                        android:textColor="@color/colorPrimary"
                        android:textSize="@dimen/_12sdp"
                        android:textStyle="bold"
                        android:visibility="visible"
                        tools:ignore="RtlHardcoded">

                    </TextView>
                    <ImageView
                        android:id="@+id/app_download_logo"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginTop="@dimen/ten"
                        android:layout_marginRight="@dimen/ten"
                        android:layout_weight="3"
                        android:gravity="left|center"
                        android:scaleType="fitXY"
                        android:visibility="gone">

                    </ImageView>

                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutParentTitle"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="4.5">

                <RelativeLayout
                    android:id="@+id/relativeBottom"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_below="@id/parent_off_image"
                    android:background="@color/white">

                    <TextView
                        android:id="@+id/half_content_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/four"
                        android:autoSizePresetSizes="12dp"
                        android:autoSizeTextType="none"
                        android:ellipsize="end"
                        android:fontFamily="@font/robotolighttelugu"
                        android:gravity="start"
                        android:lineSpacingExtra="-8dp"
                        android:maxLength="400"
                        android:paddingLeft="10dp"
                        android:paddingRight="10dp"
                        android:paddingBottom="2dp"
                        android:text=""
                        android:textColor="@color/content_title_color"
                        android:textSize="@dimen/_16sdp"
                        android:textStyle="bold"
                        android:visibility="gone"
                        app:autoSizeMaxTextSize="@dimen/_11sdp"
                        app:autoSizeMinTextSize="@dimen/_11sdp"
                        app:autoSizeStepGranularity="1sp" />

                    <TextView
                        android:id="@+id/tamil_half_content_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/four"
                        android:layout_marginBottom="@dimen/two"
                        android:autoSizePresetSizes="12dp"
                        android:autoSizeTextType="none"
                        android:ellipsize="end"
                        android:fontFamily="@font/mallannaregular"
                        android:gravity="start"
                        android:letterSpacing="0.01"
                        android:maxLength="400"
                        android:paddingLeft="10dp"
                        android:paddingRight="10dp"
                        android:paddingBottom="2dp"
                        android:text=""
                        android:textColor="@color/content_title_color"
                        android:textSize="@dimen/_13sdp"
                        android:textStyle="bold"
                        android:visibility="gone"
                        app:autoSizeMaxTextSize="@dimen/_13sdp"
                        app:autoSizeMinTextSize="@dimen/_13sdp"
                        app:autoSizeStepGranularity="1sp" />

                    <TextView
                        android:id="@+id/english_half_content_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/four"
                        android:layout_marginBottom="@dimen/two"
                        android:autoSizePresetSizes="12dp"
                        android:autoSizeTextType="none"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="start"
                        android:letterSpacing="0.01"
                        android:lineSpacingExtra="1sp"
                        android:maxLength="400"
                        android:paddingLeft="10dp"
                        android:paddingRight="10dp"
                        android:paddingBottom="2dp"
                        android:textColor="@color/content_title_color"
                        android:textSize="@dimen/_14sdp"
                        android:textStyle="bold"
                        app:autoSizeMaxTextSize="@dimen/_13sdp"
                        app:autoSizeMinTextSize="@dimen/_13sdp"
                        app:autoSizeStepGranularity="1sp" />

                    <LinearLayout

                        android:id="@+id/layout_date"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/half_content_title"
                        android:autoSizeTextType="none"
                        android:orientation="horizontal">


                    </LinearLayout>

                    <TextView
                        android:id="@+id/half_content_description"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_400sdp"
                        android:layout_below="@+id/layout_date"
                        android:ellipsize="end"
                        android:fontFamily="@font/robotolighttelugu"
                        android:gravity="start"
                        android:lineSpacingExtra="-7dp"
                        android:maxLength="400"
                        android:paddingLeft="10dp"
                        android:paddingRight="10dp"
                        android:paddingBottom="2dp"
                        android:text=""
                        android:textColor="@color/content_desc_color"
                        android:textSize="@dimen/_13sdp"
                        android:visibility="visible" />

                    <TextView
                        android:id="@+id/tamil_half_content_description"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/tamil_half_content_title"
                        android:ellipsize="end"
                        android:fontFamily="@font/mallannaregular"
                        android:gravity="start"
                        android:letterSpacing="0.01"
                        android:paddingLeft="10dp"
                        android:paddingRight="10dp"
                        android:paddingBottom="2dp"
                        android:text=""
                        android:textColor="@color/content_desc_color"
                        android:textSize="@dimen/_13sdp"
                        android:visibility="gone"
                        app:autoSizeMaxTextSize="@dimen/_11sdp"
                        app:autoSizeMinTextSize="@dimen/_11sdp"
                        app:autoSizeStepGranularity="1sp" />

                    <TextView
                        android:id="@+id/english_half_content_description"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/english_half_content_title"
                        android:autoSizePresetSizes="12dp"
                        android:autoSizeTextType="none"
                        android:ellipsize="end"
                        android:fontFamily="@font/mallannaregular"
                        android:gravity="start"
                        android:letterSpacing="0.01"
                        android:lineSpacingExtra="5sp"
                        android:maxLength="400"
                        android:visibility="visible"
                        android:paddingLeft="10dp"
                        android:paddingRight="10dp"
                        android:paddingBottom="2dp"
                        android:text=""
                        android:textColor="@color/content_desc_color"
                        android:textSize="@dimen/_14sdp"
                        android:textStyle="normal"
                        app:autoSizeMaxTextSize="@dimen/_13sdp"
                        app:autoSizeMinTextSize="@dimen/_13sdp"
                        app:autoSizeStepGranularity="1sp" />


                </RelativeLayout>



            </LinearLayout>
            <LinearLayout
                android:id="@+id/layoutParentDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/white"
                android:visibility="gone"
                android:paddingBottom="@dimen/_3sdp"
                android:paddingTop="@dimen/_3sdp"
                android:orientation="horizontal">
                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_gravity="left|center"
                    android:layout_marginLeft="@dimen/_15sdp"
                    android:src="@drawable/timestamp_ic"/>
                <TextView
                    android:id="@+id/textViewPostDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="left|center"
                    android:text="12th May 2023"
                    android:textColor="@color/greyish"
                    android:textSize="@dimen/_8sdp"
                    android:layout_marginLeft="@dimen/_5sdp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>



        <LinearLayout
            android:id="@+id/ll_footer_layout"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_40sdp"
            android:visibility="visible"
            android:layout_alignParentBottom="true"
            android:background="@color/white"
            android:gravity="start|bottom"
            android:orientation="horizontal">


            <LinearLayout
                android:id="@+id/writer_profile_image"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="center">

                <de.hdodenhof.circleimageview.CircleImageView
                    android:id="@+id/writer_profile_pic"
                    android:layout_width="@dimen/_30sdp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="left|center"
                android:layout_marginLeft="5dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/writer_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="left|center"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_8sdp"
                    android:text="pavan kumar"
                    android:textStyle="bold" />


                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingTop="5dp"
                    android:gravity="left|top">


                    <TextView
                        android:id="@+id/writer_designation"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="left|center"
                        android:layout_marginRight="@dimen/_12sdp"
                        android:textColor="@color/black"
                        android:textSize="@dimen/_4sdp"
                        android:text="reporter"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/writer_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="left|center"
                        android:textColor="@color/black"
                        android:textSize="@dimen/_4sdp"
                        android:text="4 min ago"
                        android:textStyle="bold" />
                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/writer_follow"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginLeft="@dimen/_10sdp"
                android:layout_marginRight="@dimen/_10sdp"
                android:gravity="left|center"
                android:visibility="visible">

                    <TextView
                        android:id="@+id/test_folloew"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="1dp"
                        android:gravity="center"
                        android:paddingLeft="12dp"
                        android:paddingRight="12dp"
                        android:text="Follow"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintRight_toRightOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        android:textColor="@color/red_one"
                        android:textSize="@dimen/_6sdp"
                        android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/writer_follower"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginLeft="@dimen/_10sdp"
                android:layout_marginRight="@dimen/_10sdp"
                android:gravity="left|center"
                android:visibility="visible">



                    <TextView
                        android:id="@+id/second_language_name"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/_10sdp"
                        android:layout_margin="1dp"
                        android:gravity="center"
                        android:paddingLeft="15dp"
                        android:paddingRight="15dp"
                        android:text="Following"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintRight_toRightOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        android:textColor="@color/red_one"
                        android:textSize="@dimen/_6sdp"
                        android:textStyle="bold">

                    </TextView>
            </LinearLayout>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginEnd="@dimen/_10sdp"
                android:orientation="horizontal"
                android:gravity="end|center"
                android:visibility="visible">

                        <LinearLayout
                            android:id="@+id/ll_refer_and_earn_half"
                            android:layout_width="wrap_content"
                            android:paddingLeft="@dimen/_8sdp"
                            android:paddingRight="@dimen/_8sdp"
                            android:paddingTop="@dimen/_2sdp"
                             android:gravity="center"
                            android:background="@drawable/circle_article_location"
                            android:paddingBottom="@dimen/_2sdp"
                            android:layout_height="match_parent">
                            <ImageView
                                android:id="@+id/iv_share_and_earn"
                                android:layout_width="@dimen/_12sdp"
                                android:layout_height="@dimen/_10sdp"
                                android:layout_marginRight="@dimen/_8sdp"
                                android:gravity="center" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:id="@+id/my_feed"
                                android:text=""
                                android:gravity="center"
                                android:textSize="@dimen/_12sdp"
                                android:textColor="@color/black"/>
                        </LinearLayout>

            </LinearLayout>

        </LinearLayout>


    </RelativeLayout>

</LinearLayout>
