<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:layout_gravity="center"
    android:padding="@dimen/_15sdp"
    android:background="@color/whitewithblack"
    android:gravity="center|top">
    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_launcher"
        android:layout_marginTop="@dimen/_80sdp"/>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/anynews"
        android:textStyle="bold"
        android:layout_marginTop="@dimen/_6sdp"
        android:textSize="@dimen/_14sdp"
        android:textColor="@color/red_one"/>
    <TextView
        android:id="@+id/textViewRatingTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/content_desc_color"
        android:textSize="@dimen/_14sdp"
        android:gravity="center"
        android:text="@string/enjoying_anynews_leave_a_play_review"
        android:layout_marginTop="@dimen/_15sdp"/>
    <TextView
        android:id="@+id/textViewRatSubTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/text_color_primary"
        android:textSize="@dimen/_16sdp"
        android:gravity="center"
        android:visibility="gone"
        android:textStyle="bold"
        android:layout_marginTop="@dimen/_15sdp"
        android:text="@string/thankyou_for_your_feedback"/>

    <!-- CTA opens Google Play In-App Review (no in-app star picker). -->
    <Button
        android:id="@+id/buttonAppSubmit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:layout_marginTop="@dimen/_25sdp"
        android:background="@color/whitewithblack"
        android:textColor="@color/red"
        android:paddingTop="@dimen/_5sdp"
        android:paddingBottom="@dimen/_5sdp"
        android:paddingLeft="@dimen/_25sdp"
        android:paddingRight="@dimen/_25sdp"
        android:text="@string/rate_on_google_play" />

</LinearLayout>
