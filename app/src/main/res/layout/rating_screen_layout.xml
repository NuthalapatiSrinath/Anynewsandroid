<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:layout_gravity="center"
    android:padding="@dimen/_15sdp"
    android:background="@color/white"
    android:gravity="center|top">
    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_launcher"
        android:layout_marginTop="@dimen/_80sdp"/>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/anynews"
        android:textStyle="bold"
        android:layout_marginTop="@dimen/_6sdp"
        android:textSize="@dimen/_14sdp"
        android:textColor="@color/red_one"/>
    <TextView
        android:id="@+id/textViewRatingTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#80000000"
        android:textSize="@dimen/_14sdp"
        android:gravity="center"
        android:text="@string/if_you_like_the_app_please_rate_us_nwith_5_star"
        android:layout_marginTop="@dimen/_15sdp"/>
    <TextView
        android:id="@+id/textViewRatSubTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#000000"
        android:textSize="@dimen/_16sdp"
        android:gravity="center"
        android:visibility="gone"
        android:textStyle="bold"
        android:layout_marginTop="@dimen/_15sdp"
        android:text="@string/thankyou_for_your_feedback"/>

    <RatingBar
        android:id="@+id/ratingBarApp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:rating="0"
        android:stepSize="1"
        android:layout_marginTop="@dimen/_25sdp"
        android:theme="@style/RatingBar"/>
    <EditText
        android:id="@+id/editTextAppReview"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_75sdp"
        android:background="@drawable/reactangle_box_comment"
        android:gravity="left|top"
        android:scrollbars="none"
        android:maxLength="80"
        android:visibility="gone"
        android:paddingTop="1dp"
        android:paddingStart="2dp"
        android:hint="Please give your feedback..."
        android:text=""/>
    <Button
        android:id="@+id/buttonAppSubmit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:layout_marginTop="@dimen/_15sdp"
        android:background="@color/white"
        android:textColor="@color/red"
        android:paddingTop="@dimen/_5sdp"
        android:visibility="gone"
        android:paddingBottom="@dimen/_5sdp"
        android:paddingLeft="@dimen/_25sdp"
        android:paddingRight="@dimen/_25sdp"
        android:text="SUBMIT" />

</LinearLayout>