<?xml version="1.0" encoding="utf-8"?>
<LinearLayout android:orientation="vertical"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">


    <RelativeLayout
        android:id="@+id/magzine_relative_slider"
        android:layout_width="match_parent"
        android:layout_height="match_parent">


        <androidx.viewpager.widget.ViewPager
            android:id="@+id/magzine_viewPager_data"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="bottom"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingStart="40dp"
            android:paddingLeft="40dp"
            android:paddingTop="60dp"
            android:paddingEnd="30dp"
            android:paddingRight="30dp"
            android:paddingBottom="80dp" />
        <!-- Blue blink Share (ic_share_full): bottom-right on magazine posts.
             Footer Calendar replaced the old center Share slot. -->
        <ImageView
            android:id="@+id/imageViewShare"
            android:src="@drawable/ic_share_full"
            android:layout_above="@+id/magzine_ll_dots"
            android:layout_alignParentEnd="true"
            android:padding="12dp"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:visibility="gone"
            android:contentDescription="@string/share_more_options"
            android:scaleType="centerInside"
            android:layout_marginStart="@dimen/eight"
            android:layout_marginTop="@dimen/eight"
            android:layout_marginEnd="@dimen/eight"
            android:layout_marginBottom="@dimen/eight" />


        <!-- Play Store gallery_strip + WormDots (same as image_gallery / half gallery) -->
        <LinearLayout
            android:id="@+id/magzine_ll_dots"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_marginBottom="@dimen/_10sdp"
            android:gravity="center"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="@dimen/_150sdp"
                android:layout_height="@dimen/_32sdp"
                android:gravity="center"
                android:background="@drawable/gallery_strip"
                android:orientation="vertical"
                android:visibility="visible">

                <com.tbuonomo.viewpagerdotsindicator.WormDotsIndicator
                    android:id="@+id/magzine_indicator"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    app:dotsColor="@color/colorPrimary"
                    app:dotsCornerRadius="8dp"
                    app:dotsSize="12dp"
                    app:dotsSpacing="4dp"
                    app:dotsStrokeColor="@color/white"
                    app:dotsWidthFactor="2.5" />
            </LinearLayout>

        </LinearLayout>

        <!-- Multi-image coach above magazine dots; once until first swipe -->
        <TextView
            android:id="@+id/gallery_swipe_left_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_above="@+id/magzine_ll_dots"
            android:layout_centerHorizontal="true"
            android:layout_marginBottom="4dp"
            android:background="@drawable/bg_gallery_dots_pill"
            android:gravity="center"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="@string/gallery_swipe_left_hint"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            android:visibility="gone" />

<include layout="@layout/share_download_layout"/>

    </RelativeLayout>

</LinearLayout>