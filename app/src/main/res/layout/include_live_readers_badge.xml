<?xml version="1.0" encoding="utf-8"?>
<!-- Way2News-style live readers: LIVE first (left), then dark count. Parent positions bottom-right. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/live_readers_badge"
    android:layout_width="wrap_content"
    android:layout_height="22dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:background="@drawable/bg_live_readers_live"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="5dp"
        android:paddingEnd="6dp">

        <ImageView
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_live_readers_bolt" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:text="LIVE"
            android:textAllCaps="true"
            android:textColor="#FFFFFFFF"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/live_readers_count_text"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:background="@drawable/bg_live_readers_count"
        android:fontFamily="sans-serif-medium"
        android:gravity="center_vertical"
        android:includeFontPadding="false"
        android:paddingStart="8dp"
        android:paddingEnd="7dp"
        android:textColor="#FFFFFFFF"
        android:textSize="10sp"
        android:maxLines="1" />
</LinearLayout>
