<?xml version="1.0" encoding="utf-8"?>
<!--
  Survey (post_type "survey_poll"): multi-option (2–4).
  Image on top; dark polished card with options / results below.
-->
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rl_survay_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="4.0"
            android:background="@color/black">

            <ImageView
                android:id="@+id/polling_half_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:adjustViewBounds="true"
                android:contentDescription="@null"
                android:scaleType="fitXY"
                android:src="@drawable/md_btn_selector_ripple_dark" />

            <!-- Like / comment / share / flag — same row as half articles -->
            <include
                layout="@layout/include_half_engagement_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:layout_marginBottom="2dp" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="6.0"
            android:background="@color/black"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="6dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:id="@+id/rl_question"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_poll_card_dark"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="12dp"
                android:paddingBottom="10dp">

                <TextView
                    android:id="@+id/tv_polling_question"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/roboto_bold"
                    android:gravity="center"
                    android:letterSpacing="0.01"
                    android:lineSpacingExtra="2sp"
                    android:maxLines="3"
                    android:paddingBottom="8dp"
                    android:textColor="@color/poll_card_question"
                    android:textSize="@dimen/_13sdp"
                    android:textStyle="bold" />

                <!-- BEFORE vote -->
                <LinearLayout
                    android:id="@+id/ll_options_layout"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/option_row_A"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:layout_marginBottom="6dp"
                        android:background="@drawable/bg_poll_option_green"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:clickable="true"
                        android:focusable="true">

                        <View
                            android:id="@+id/radio_A"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:background="@drawable/bg_poll_radio_green" />

                        <TextView
                            android:id="@+id/tv_answer_A"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:fontFamily="@font/roboto_bold"
                            android:maxLines="2"
                            android:textColor="@color/poll_card_question"
                            android:textSize="@dimen/_12sdp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/option_row_B"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:layout_marginBottom="6dp"
                        android:background="@drawable/bg_poll_option_red"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:clickable="true"
                        android:focusable="true">

                        <View
                            android:id="@+id/radio_B"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:background="@drawable/bg_poll_radio_red" />

                        <TextView
                            android:id="@+id/tv_answer_B"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:fontFamily="@font/roboto_bold"
                            android:maxLines="2"
                            android:textColor="@color/poll_card_question"
                            android:textSize="@dimen/_12sdp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/option_row_C"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:layout_marginBottom="6dp"
                        android:background="@drawable/bg_poll_option_blue"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:clickable="true"
                        android:focusable="true">

                        <View
                            android:id="@+id/radio_C"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:background="@drawable/bg_poll_radio_blue" />

                        <TextView
                            android:id="@+id/tv_answer_C"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:fontFamily="@font/roboto_bold"
                            android:maxLines="2"
                            android:textColor="@color/poll_card_question"
                            android:textSize="@dimen/_12sdp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/option_row_D"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:layout_marginBottom="8dp"
                        android:background="@drawable/bg_poll_option_orange"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:clickable="true"
                        android:focusable="true">

                        <View
                            android:id="@+id/radio_D"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:background="@drawable/bg_poll_radio_orange" />

                        <TextView
                            android:id="@+id/tv_answer_D"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:fontFamily="@font/roboto_bold"
                            android:maxLines="2"
                            android:textColor="@color/poll_card_question"
                            android:textSize="@dimen/_12sdp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/btn_vote_now_polling"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_poll_vote_now"
                        android:fontFamily="@font/roboto_bold"
                        android:gravity="center"
                        android:text="@string/vote_now"
                        android:textColor="@color/poll_vote_now_text"
                        android:textSize="@dimen/_13sdp"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>

                <!-- AFTER vote — percent only -->
                <LinearLayout
                    android:id="@+id/ll_percent_layout"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <!-- Result A -->
                    <LinearLayout
                        android:id="@+id/result_row_A"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:layout_marginBottom="6dp"
                        android:background="@drawable/bg_poll_result_green"
                        android:orientation="vertical"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/badge_A"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:background="@drawable/bg_poll_badge_green"
                                android:fontFamily="@font/roboto_bold"
                                android:gravity="center"
                                android:text="1"
                                android:textColor="@color/white"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/tv_result_label_A"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1"
                                android:ellipsize="end"
                                android:fontFamily="@font/roboto_bold"
                                android:maxLines="2"
                                android:textColor="@color/poll_card_question"
                                android:textSize="@dimen/_11sdp" />

                            <TextView
                                android:id="@+id/polling_A"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/roboto_bold"
                                android:textColor="@color/poll_card_question"
                                android:textSize="@dimen/_16sdp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="5dp"
                            android:layout_marginTop="8dp"
                            android:layout_marginStart="32dp">

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/bg_poll_progress_track" />

                            <View
                                android:id="@+id/option_fill_A"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_gravity="start"
                                android:background="@drawable/bg_poll_progress_green" />
                        </FrameLayout>
                    </LinearLayout>

                    <!-- Result B -->
                    <LinearLayout
                        android:id="@+id/result_row_B"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:layout_marginBottom="6dp"
                        android:background="@drawable/bg_poll_result_red"
                        android:orientation="vertical"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/badge_B"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:background="@drawable/bg_poll_badge_red"
                                android:fontFamily="@font/roboto_bold"
                                android:gravity="center"
                                android:text="2"
                                android:textColor="@color/white"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/tv_result_label_B"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1"
                                android:ellipsize="end"
                                android:fontFamily="@font/roboto_bold"
                                android:maxLines="2"
                                android:textColor="@color/poll_card_question"
                                android:textSize="@dimen/_11sdp" />

                            <TextView
                                android:id="@+id/polling_B"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/roboto_bold"
                                android:textColor="@color/poll_card_question"
                                android:textSize="@dimen/_16sdp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="5dp"
                            android:layout_marginTop="8dp"
                            android:layout_marginStart="32dp">

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/bg_poll_progress_track" />

                            <View
                                android:id="@+id/option_fill_B"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_gravity="start"
                                android:background="@drawable/bg_poll_progress_red" />
                        </FrameLayout>
                    </LinearLayout>

                    <!-- Result C -->
                    <LinearLayout
                        android:id="@+id/result_row_C"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:layout_marginBottom="6dp"
                        android:background="@drawable/bg_poll_result_blue"
                        android:orientation="vertical"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/badge_C"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:background="@drawable/bg_poll_badge_blue"
                                android:fontFamily="@font/roboto_bold"
                                android:gravity="center"
                                android:text="3"
                                android:textColor="@color/white"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/tv_result_label_C"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1"
                                android:ellipsize="end"
                                android:fontFamily="@font/roboto_bold"
                                android:maxLines="2"
                                android:textColor="@color/poll_card_question"
                                android:textSize="@dimen/_11sdp" />

                            <TextView
                                android:id="@+id/polling_C"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/roboto_bold"
                                android:textColor="@color/poll_card_question"
                                android:textSize="@dimen/_16sdp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="5dp"
                            android:layout_marginTop="8dp"
                            android:layout_marginStart="32dp">

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/bg_poll_progress_track" />

                            <View
                                android:id="@+id/option_fill_C"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_gravity="start"
                                android:background="@drawable/bg_poll_progress_blue" />
                        </FrameLayout>
                    </LinearLayout>

                    <!-- Result D -->
                    <LinearLayout
                        android:id="@+id/result_row_D"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_poll_result_orange"
                        android:orientation="vertical"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/badge_D"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:background="@drawable/bg_poll_badge_orange"
                                android:fontFamily="@font/roboto_bold"
                                android:gravity="center"
                                android:text="4"
                                android:textColor="@color/white"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/tv_result_label_D"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1"
                                android:ellipsize="end"
                                android:fontFamily="@font/roboto_bold"
                                android:maxLines="2"
                                android:textColor="@color/poll_card_question"
                                android:textSize="@dimen/_11sdp" />

                            <TextView
                                android:id="@+id/polling_D"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/roboto_bold"
                                android:textColor="@color/poll_card_question"
                                android:textSize="@dimen/_16sdp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="5dp"
                            android:layout_marginTop="8dp"
                            android:layout_marginStart="32dp">

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/bg_poll_progress_track" />

                            <View
                                android:id="@+id/option_fill_D"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_gravity="start"
                                android:background="@drawable/bg_poll_progress_orange" />
                        </FrameLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- Legacy stubs for old FlipperAdapter findViewById during transition -->
                <View android:id="@+id/card_view_survey" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                <View android:id="@+id/neomorphFrameLayoutA" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                <View android:id="@+id/neomorphFrameLayoutB" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                <View android:id="@+id/neomorphFrameLayoutC" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                <View android:id="@+id/neomorphFrameLayoutD" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                <View android:id="@+id/select_neomorphFrameLayoutA" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                <View android:id="@+id/select_neomorphFrameLayoutB" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                <View android:id="@+id/select_neomorphFrameLayoutC" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                <View android:id="@+id/select_neomorphFrameLayoutD" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                <View android:id="@+id/select_option_fill_A" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                <View android:id="@+id/select_option_fill_B" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                <View android:id="@+id/select_option_fill_C" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                <View android:id="@+id/select_option_fill_D" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                <TextView android:id="@+id/select_tv_answer_A" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                <TextView android:id="@+id/select_tv_answer_B" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                <TextView android:id="@+id/select_tv_answer_C" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                <TextView android:id="@+id/select_tv_answer_D" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                <TextView android:id="@+id/select_polling_A" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                <TextView android:id="@+id/select_polling_B" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                <TextView android:id="@+id/select_polling_C" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                <TextView android:id="@+id/select_polling_D" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                <View android:id="@+id/ll_A" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                <View android:id="@+id/ll_B" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                <View android:id="@+id/ll_C" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                <View android:id="@+id/ll_D" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                <View android:id="@+id/select_ll_A" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                <View android:id="@+id/select_ll_B" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                <View android:id="@+id/select_ll_C" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                <View android:id="@+id/select_ll_D" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</RelativeLayout>
