                                        android:textStyle="bold"
                                        android:fontFamily="@font/robotolighttelugu"
                                        android:layout_width="0dp"
                                        android:layout_weight="0.2"
                                        android:layout_height="match_parent"/>
                                </LinearLayout>
                            </com.anyNews.anynews.Ui.NeomorphFrameLayout>
                            <com.anyNews.anynews.Ui.NeomorphFrameLayout
                                android:id="@+id/select_neomorphFrameLayoutD"
                                android:layout_width="match_parent"
                                android:layout_height="0dp"
                                android:layout_weight="0.5"
                                app:neomorph_shadow_type="outer"
                                app:neomorph_layer_type="hardware"
                                app:neomorph_background_color="#42ae4d"
                                app:neomorph_corner_radius="@dimen/neomorph_view_corner_radius"
                                app:neomorph_elevation="@dimen/neomorph_view_elevation"
                                app:neomorph_view_type="rectangular"
                                app:neomorph_shadow_color="#70cf79"
                                android:visibility="gone"
