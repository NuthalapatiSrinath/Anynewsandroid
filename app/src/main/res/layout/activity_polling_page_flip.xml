                                app:neomorph_layer_type="hardware"
                                app:neomorph_background_color="@color/white"
                                app:neomorph_corner_radius="@dimen/neomorph_view_corner_radius"
                                app:neomorph_elevation="@dimen/neomorph_view_elevation"
                                app:neomorph_view_type="rectangular"
                                app:neomorph_shadow_color="#D0D2D5"
                                app:neomorph_highlight_color="#ffffff">
                                <LinearLayout
                                    android:id="@+id/ll_B"
                                    android:layout_width="match_parent"
                                    android:orientation="horizontal"
                                    android:background="@drawable/background_button"
                                    android:layout_height="match_parent">
                                    <TextView
                                        android:id="@+id/tv_answer_B"
