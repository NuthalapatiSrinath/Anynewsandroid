                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:id="@+id/card_view_survey"
                    Card_View:cardCornerRadius="5sp"
                    Card_View:cardBackgroundColor="@color/white"
                    Card_View:cardElevation="0sp">

