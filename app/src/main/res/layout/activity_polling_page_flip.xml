                                    android:layout_height="match_parent">
                                    <TextView
                                        android:id="@+id/select_tv_answer_D"
                                        android:gravity="center"
                                        android:layout_margin="@dimen/_3sdp"
                                        android:textSize="@dimen/_13sdp"
