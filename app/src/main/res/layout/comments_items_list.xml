<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/background_color">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:id="@+id/layoutImage"
            android:layout_width="wrap_content"
            android:layout_centerVertical="true"
            android:layout_gravity="top|center"
            android:layout_height="wrap_content">
            <soup.neumorphism.NeumorphCardView
                style="@style/New.Widget.Neumorph.FloatingActionButton"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:scaleType="fitXY">
                <de.hdodenhof.circleimageview.CircleImageView
                    android:id="@+id/circular_image"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_launcher" />
            </soup.neumorphism.NeumorphCardView>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutComment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/five"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@+id/imageViewReport"
            android:layout_toEndOf="@+id/layoutImage"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/layoutCommentTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/person_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="left"
                    android:layout_weight="8"
                    android:text="Akkisetty Narasimha Rao"
                    android:textSize="@dimen/_12sdp"
                    android:textStyle="normal" />

                <TextView
                    android:id="@+id/comment_time"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center"
                    android:layout_weight="2"
                    android:gravity="center"
                    android:text="3 min"
                    android:textSize="@dimen/_8sdp"
                    android:textStyle="normal" />
            </LinearLayout>


            <TextView
                android:id="@+id/comment_details"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="left"
                android:layout_marginBottom="@dimen/two"
                android:text="Akkisetty Narasimha Raofjrelgnegjgntpjgn eroggj reorb reperoirejepogeipo reigjrgorigroin  ijgigjt"
                android:textSize="@dimen/_9sdp"
                android:textStyle="normal" />
        </LinearLayout>

        <ImageView
            android:id="@+id/imageViewReport"
            android:layout_width="@dimen/_24sdp"
            android:layout_height="@dimen/_24sdp"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:layout_marginLeft="@dimen/_10sdp"
            android:layout_marginRight="@dimen/_10sdp"
            android:src="@drawable/ic_menu_block_report" />

    </RelativeLayout>

    <View
        android:layout_marginLeft="@dimen/_15sdp"
        android:layout_marginRight="@dimen/_15sdp"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/warm_grey_16">

    </View>
</LinearLayout>