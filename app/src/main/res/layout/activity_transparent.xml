<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Activities.Transparent">

    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#c5d607"
        android:orientation="vertical">

        <Button
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:background="@null"
            android:padding="30dp"
            android:text="100% Transparent Background"
            android:textColor="#048dc9" />

        <Button
            android:layout_width="fill_parent"
            android:layout_height="@dimen/_30sdp"
            android:layout_marginBottom="16dp"
            android:layout_marginTop="16dp"
            android:background="#20000000"
            android:padding="30dp"
            android:text="80% Transparent Background"
            android:textColor="#048dc9" />

        <Button
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:background="#50000000"
            android:padding="30dp"
            android:text="50% Transparent Background"
            android:textColor="#fff" />

        <Button
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:layout_marginTop="16dp"
            android:background="#80000000"
            android:padding="30dp"
            android:text="20% Transparent Background"
            android:textColor="#fff" />

    </LinearLayout>
</RelativeLayout>