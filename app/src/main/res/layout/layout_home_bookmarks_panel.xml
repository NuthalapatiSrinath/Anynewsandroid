<?xml version="1.0" encoding="utf-8"?>
<!-- In-place bookmarks list shown when top toggle selects Bookmarks (online + offline). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/home_bookmarks_panel"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_color"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:paddingTop="48dp"
    android:visibility="gone">

    <TextView
        android:id="@+id/home_bookmarks_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="4dp"
        android:text="@string/bookmarks_offline_hint"
        android:textColor="@color/colorBookmarksInfo"
        android:textSize="12sp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/home_bookmarks_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="16dp" />

    <TextView
        android:id="@+id/home_bookmarks_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:padding="24dp"
        android:text="@string/no_bookmarks"
        android:textColor="@color/colorBookmarksInfo"
        android:textSize="16sp"
        android:visibility="gone" />
</LinearLayout>
