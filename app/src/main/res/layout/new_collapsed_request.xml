<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true">

        <RelativeLayout
            android:id="@+id/relativeView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginLeft="5dp">

            <ImageView
                android:id="@+id/imageViewIcon"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:visibility="gone"
                android:layout_centerVertical="true"
                android:src="@mipmap/ic_launcher" />


            <TextView
                android:id="@+id/notification_titleTEL"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@+id/imageViewIcon"
                android:fontFamily="@font/robotolighttelugu"
                android:maxLines="3"
                android:text="AnyNews"
                android:textSize="@dimen/_14sdp"
                android:textColor="@color/black"
                android:visibility="visible" />
            <TextView
                android:id="@+id/notification_titleE"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@+id/imageViewIcon"
                android:fontFamily="sans-serif"
                android:maxLines="3"
                android:text="AnyNews"
                android:textSize="@dimen/_14sdp"
                android:textColor="@color/black"
                android:visibility="gone" />
            <TextView
                android:id="@+id/notification_titleTa"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@+id/imageViewIcon"
                android:fontFamily="@font/mallannaregular"
                android:maxLines="3"
                android:textSize="@dimen/_14sdp"
                android:textColor="@color/black"
                android:text="AnyNews"
                android:visibility="gone"/>

        </RelativeLayout>



    </RelativeLayout>


</RelativeLayout>