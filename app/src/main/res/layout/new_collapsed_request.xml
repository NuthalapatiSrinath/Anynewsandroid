<?xml version="1.0" encoding="utf-8"?>
<!-- Compact tray row: [article/brand LEFT] | headline | empty right (no largeIcon) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notification_root_collapsed"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="0dp"
    android:paddingTop="2dp"
    android:paddingEnd="2dp"
    android:paddingBottom="2dp">

    <ImageView
        android:id="@+id/imageViewIcon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="10dp"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/app_share_logo"
        android:visibility="gone" />

    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1">

        <TextView
            android:id="@+id/notification_titleTEL"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/robotolighttelugu"
            android:maxLines="3"
            android:text="AnyNews"
            android:textColor="@color/black"
            android:textSize="@dimen/_13sdp"
            android:visibility="visible" />

        <TextView
            android:id="@+id/notification_titleE"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:maxLines="3"
            android:text="AnyNews"
            android:textColor="@color/black"
            android:textSize="@dimen/_13sdp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/notification_titleTa"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/mallannaregular"
            android:maxLines="3"
            android:text="AnyNews"
            android:textColor="@color/black"
            android:textSize="@dimen/_13sdp"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Kept for R.id stability; always GONE in MyFirebaseMessagingService. -->
    <ImageView
        android:id="@+id/notificationThumb"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="@null"
        android:visibility="gone" />
</LinearLayout>
