<?xml version="1.0" encoding="utf-8"?>
<!-- Way2-style job card: logo, title, time, description, salary + report/share/call. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_jobs_card"
    android:elevation="2dp"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Header: logo + title + time -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/job_logo"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_jobs_logo"
            android:contentDescription="@null"
            android:padding="3dp"
            android:scaleType="centerCrop"
            tools:src="@drawable/jobs_company_01" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/job_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="#FF0F172A"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="పుల్కా &amp; రోటీ మేకర్" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_jobs_clock"
                    android:tint="#FF94A3B8" />

                <TextView
                    android:id="@+id/job_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:textColor="#FF94A3B8"
                    android:textSize="11sp"
                    tools:text="Yesterday" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Description (phone links applied in code) -->
    <TextView
        android:id="@+id/job_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:lineSpacingExtra="2dp"
        android:textColor="#FF334155"
        android:textSize="13sp"
        tools:text="Job description with phone…" />

    <!-- Dashed divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_jobs_dashed_line"
        android:layerType="software" />

    <!-- Footer: salary + actions -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp">

        <TextView
            android:id="@+id/job_salary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@id/job_actions"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingEnd="8dp"
            android:textColor="#FF0F172A"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="₹ 20,000 - 30,000/-" />

        <LinearLayout
            android:id="@+id/job_actions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/job_report"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_jobs_action_btn"
                android:contentDescription="@null"
                android:padding="8dp"
                android:src="@drawable/ic_jobs_warning" />

            <ImageView
                android:id="@+id/job_share"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_jobs_action_btn"
                android:contentDescription="@null"
                android:padding="8dp"
                android:src="@drawable/ic_jobs_share_arrow" />

            <ImageView
                android:id="@+id/job_call"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_jobs_call_btn"
                android:contentDescription="@null"
                android:padding="9dp"
                android:src="@drawable/ic_jobs_call"
                android:tint="#FFFFFFFF" />
        </LinearLayout>
    </RelativeLayout>
</LinearLayout>
