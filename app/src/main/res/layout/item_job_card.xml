<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_jobs_card"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/job_logo"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_jobs_logo"
            android:contentDescription="@null"
            android:padding="4dp"
            android:scaleType="centerCrop"
            tools:src="@drawable/jobs_company_01" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/job_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#FFFFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="Software Developer" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/job_company"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#FF94A3B8"
                    android:textSize="12sp"
                    tools:text="Tata Consultancy Services" />

                <ImageView
                    android:id="@+id/job_verified"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginStart="4dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_jobs_verified"
                    android:visibility="gone"
                    tools:visibility="visible" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="11dp"
                    android:layout_height="11dp"
                    android:src="@drawable/ic_jobs_pin"
                    android:tint="#FF64748B" />

                <TextView
                    android:id="@+id/job_location"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="3dp"
                    android:textColor="#FF94A3B8"
                    android:textSize="11sp"
                    tools:text="Hyderabad" />

                <ImageView
                    android:layout_width="11dp"
                    android:layout_height="11dp"
                    android:layout_marginStart="10dp"
                    android:src="@drawable/ic_jobs_briefcase"
                    android:tint="#FF64748B" />

                <TextView
                    android:id="@+id/job_experience"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="3dp"
                    android:textColor="#FF94A3B8"
                    android:textSize="11sp"
                    tools:text="2-5 Yrs" />

                <TextView
                    android:id="@+id/job_salary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:textColor="#FF4ADE80"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    tools:text="₹ 6 - 10 LPA" />
            </LinearLayout>

            <TextView
                android:id="@+id/job_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="4dp"
                android:textColor="#FF64748B"
                android:textSize="10sp"
                tools:text="3h క్రితం" />
        </LinearLayout>

        <ImageView
            android:id="@+id/job_bookmark"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@null"
            android:padding="5dp"
            android:src="@drawable/ic_jobs_bookmark"
            android:tint="#FF64748B" />
    </LinearLayout>

    <TextView
        android:id="@+id/job_new_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|top"
        android:background="@drawable/bg_jobs_new_ribbon"
        android:paddingStart="8dp"
        android:paddingTop="2dp"
        android:paddingEnd="8dp"
        android:paddingBottom="2dp"
        android:text="NEW"
        android:textColor="#FFFFFFFF"
        android:textSize="9sp"
        android:textStyle="bold"
        android:visibility="gone"
        tools:visibility="visible" />
</FrameLayout>
