<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_color"
    android:fitsSystemWindows="true"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/ll_main"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/card_header"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@color/background_color">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/background_color">

                <ImageView
                    android:id="@+id/img_back"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginLeft="14dp"
                    android:src="@drawable/ic_back_arrow"
                    app:tint="@color/black" />

                <TextView
                    android:id="@+id/title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerHorizontal="true"
                    android:layout_centerVertical="true"
                    android:lineSpacingExtra="2sp"
                    android:text=""
                    android:textColor="@color/white"
                    android:textSize="16sp" />


            </RelativeLayout>

        </LinearLayout>


        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/_12sdp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="left|center"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/login_detailes"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="3"
                    android:gravity="left|center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txt_select_language"
                        style="@style/TextStyle16"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/_15sdp"
                        android:text="News Headline"
                        android:textSize="@dimen/_13sdp"
                        android:textStyle="normal" />

                    <soup.neumorphism.NeumorphCardView
                        android:id="@+id/user_name"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_below="@+id/basin_image_view"
                        android:layout_marginTop="8dp"
                        android:scaleType="centerInside"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:neumorph_shadowColorDark="#DFDDDD"
                        app:neumorph_shadowColorLight="#FFFFFF"
                        app:neumorph_shadowElevation="6dp"
                        app:neumorph_shapeAppearance="@style/ShapeAppearance"
                        app:neumorph_shapeType="basin"
                        app:neumorph_strokeColor="@color/design_default_color_on_primary"
                        app:neumorph_strokeWidth="0.1dp">

                        <EditText
                            android:id="@+id/edt_news_headlines"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@null"
                            android:gravity="top|left"
                            android:hint="@string/edittext_title_hint"
                            android:longClickable="false"
                            android:maxLength="80"
                            android:maxLines="3"
                            android:paddingLeft="@dimen/ten"
                            android:paddingTop="10dp"

                            android:paddingEnd="@dimen/ten"
                            android:textColor="@color/warm_grey"
                            android:textColorHint="@color/whitesren"
                            android:textIsSelectable="false">

                        </EditText>


                    </soup.neumorphism.NeumorphCardView>


                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="4"
                    android:gravity="left|center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/news_descrip"
                        style="@style/TextStyle16"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/_10sdp"
                        android:text="News Description"
                        android:textSize="@dimen/_13sdp"
                        android:textStyle="normal" />

                    <soup.neumorphism.NeumorphCardView
                        style="@style/Widget.Neumorph.ImageButton"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_below="@+id/basin_image_view"
                        android:layout_marginTop="8dp"
                        android:scaleType="centerInside"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:neumorph_shadowColorDark="#DFDDDD"
                        app:neumorph_shadowColorLight="#FFFFFF"
                        app:neumorph_shadowElevation="4dp"
                        app:neumorph_shapeAppearance="@style/ShapeAppearance"
                        app:neumorph_shapeType="basin"
                        app:neumorph_strokeColor="@color/design_default_color_on_primary"
                        app:neumorph_strokeWidth="0.1dp">

                        <EditText

                            android:id="@+id/edt_news_description"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@null"
                            android:gravity="top|left"
                            android:hint="@string/edittext_discription_hint"
                            android:longClickable="false"
                            android:maxLength="400"
                            android:minLines="3"
                            android:paddingLeft="@dimen/ten"
                            android:paddingTop="10dp"
                            android:paddingEnd="@dimen/ten"
                            android:paddingRight="@dimen/ten"
                            android:textColorHint="@color/whitesren"
                            android:textIsSelectable="false">

                        </EditText>


                    </soup.neumorphism.NeumorphCardView>


                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="2.4"
                    android:gravity="left|center"
                    android:orientation="vertical">

                    <TextView
                        style="@style/TextStyle16"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/_10sdp"
                        android:text="News Image"
                        android:textSize="@dimen/_15sdp"
                        android:textStyle="normal"
                        android:visibility="gone" />


                    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
                        xmlns:app="http://schemas.android.com/apk/res-auto"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_80sdp"
                        android:background="@color/background_color"
                        android:orientation="vertical">


                        <com.anyNews.anynews.Ui.NeomorphFrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintLeft_toLeftOf="parent"
                            app:layout_constraintRight_toRightOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:neomorph_background_color="@color/white"
                            app:neomorph_corner_radius="10dp"
                            app:neomorph_elevation="5dp"
                            app:neomorph_highlight_color="@color/neomorph_highlight_color"
                            app:neomorph_layer_type="hardware"
                            app:neomorph_shadow_color="#D0D2D5"
                            app:neomorph_shadow_type="outer"
                            app:neomorph_view_type="rectangular">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:orientation="horizontal">

                                <com.anyNews.anynews.Ui.NeomorphFrameLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:layout_margin="@dimen/two"
                                    app:layout_constraintBottom_toBottomOf="parent"
                                    app:layout_constraintLeft_toLeftOf="parent"
                                    app:layout_constraintRight_toRightOf="parent"
                                    app:layout_constraintTop_toTopOf="parent"
                                    app:neomorph_background_color="@color/payment_history_border"
                                    app:neomorph_corner_radius="10dp"
                                    app:neomorph_elevation="0dp"
                                    app:neomorph_highlight_color="@color/neomorph_highlight_color"
                                    app:neomorph_layer_type="hardware"
                                    app:neomorph_shadow_color="#D0D2D5"
                                    app:neomorph_shadow_type="outer"
                                    app:neomorph_view_type="rectangular">

                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:gravity="center"
                                        android:orientation="horizontal">

                                        <com.anyNews.anynews.Ui.NeomorphFrameLayout
                                            android:layout_width="match_parent"
                                            android:layout_height="match_parent"
                                            android:layout_margin="0.7dp"
                                            app:layout_constraintBottom_toBottomOf="parent"
                                            app:layout_constraintLeft_toLeftOf="parent"
                                            app:layout_constraintRight_toRightOf="parent"
                                            app:layout_constraintTop_toTopOf="parent"
                                            app:neomorph_background_color="@color/payment_history_background"
                                            app:neomorph_corner_radius="10dp"
                                            app:neomorph_elevation="0dp"
                                            app:neomorph_highlight_color="@color/neomorph_highlight_color"
                                            app:neomorph_layer_type="hardware"
                                            app:neomorph_shadow_color="#D0D2D5"
                                            app:neomorph_shadow_type="outer"
                                            app:neomorph_view_type="rectangular">


                                            <LinearLayout
                                                android:id="@+id/img_upload_photo_total"
                                                android:layout_width="match_parent"
                                                android:layout_height="match_parent"
                                                android:gravity="center"
                                                android:orientation="horizontal">

                                                <LinearLayout
                                                    android:layout_width="0dp"
                                                    android:layout_height="match_parent"
                                                    android:layout_weight="7"
                                                    android:gravity="left|center"
                                                    android:orientation="vertical">

                                                    <TextView
                                                        android:id="@+id/upload_image"
                                                        android:layout_width="match_parent"
                                                        android:layout_height="match_parent"
                                                        android:layout_marginLeft="@dimen/_10sdp"
                                                        android:gravity="left|center"
                                                        android:text="Upload Image"
                                                        android:textColor="@color/whitesren"
                                                        android:textSize="@dimen/_16sdp"
                                                        android:textStyle="normal">


                                                    </TextView>

                                                </LinearLayout>

                                                <LinearLayout
                                                    android:layout_width="0dp"
                                                    android:layout_height="match_parent"
                                                    android:layout_weight="3"
                                                    android:gravity="center"
                                                    android:orientation="vertical">



                                                    <ImageView
                                                        android:visibility="visible"
                                                        android:id="@+id/img_upload_photo"
                                                        android:layout_width="50dp"
                                                        android:layout_height="100dp"
                                                        android:layout_gravity="center"
                                                        android:src="@drawable/ic_new_image_icon">

                                                    </ImageView>

                                                    <ProgressBar
                                                        android:visibility="gone"
                                                        android:paddingLeft="@dimen/_25sdp"
                                                        android:paddingRight="@dimen/_25sdp"
                                                        android:id="@+id/image_upload_progress_bar"
                                                        android:layout_margin="@dimen/three"
                                                        style="?android:attr/progressBarStyleLarge"
                                                        android:layout_width="wrap_content"
                                                        android:layout_height="wrap_content"
                                                        app:layout_constraintBottom_toBottomOf="parent"
                                                        app:layout_constraintLeft_toLeftOf="parent"
                                                        app:layout_constraintRight_toRightOf="parent"
                                                        app:layout_constraintTop_toTopOf="parent" />

                                                </LinearLayout>


                                            </LinearLayout>

                                        </com.anyNews.anynews.Ui.NeomorphFrameLayout>

                                    </LinearLayout>

                                </com.anyNews.anynews.Ui.NeomorphFrameLayout>

                            </LinearLayout>


                        </com.anyNews.anynews.Ui.NeomorphFrameLayout>
                    </LinearLayout>


                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1.6"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <androidx.appcompat.widget.AppCompatCheckBox
                            android:id="@+id/checked_terms_conditions"
                            style="@style/TextStyle23"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@+id/relative_news_description"
                            android:layout_marginLeft="31dp"
                            android:layout_marginTop="16dp"
                            android:text=" I agree to terms &amp; conditions"
                            android:textSize="12sp">

                        </androidx.appcompat.widget.AppCompatCheckBox>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:id="@+id/tv_agree_view"
                            android:layout_marginTop="16dp"
                            android:visibility="visible"
                            android:layout_toRightOf="@id/checked_terms_conditions"
                            android:padding="5dp"
                            android:text="(View)"
                            android:textColor="@color/red" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center">

                        <soup.neumorphism.NeumorphCardView
                            android:id="@+id/neumorph_next"
                            style="@style/Widget.Neumorph.ImageButton"
                            android:layout_width="wrap_content"
                            android:layout_height="60dp"
                            android:layout_below="@+id/basin_image_view"
                            android:gravity="center"
                            android:scaleType="centerInside"
                            android:text="Next"
                            android:textSize="@dimen/_15sdp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:neumorph_shadowColorDark="#F2DFDFDF"
                            app:neumorph_shadowColorLight="#FFFFFF"
                            app:neumorph_shadowElevation="4dp"
                            app:neumorph_shapeType="flat"
                            app:neumorph_strokeColor="#FF2401"
                            app:neumorph_strokeWidth="2dp">

                            <LinearLayout
                                android:id="@+id/btn_upload"
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:orientation="horizontal">


                                <TextView
                                    android:visibility="visible"
                                    android:id="@+id/post_button"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:background="#FF4027"
                                    android:gravity="center"
                                    android:paddingLeft="@dimen/_40sdp"
                                    android:paddingRight="@dimen/_40sdp"
                                    android:text="Post"
                                    android:textColor="@color/white"
                                    android:textSize="@dimen/_15sdp"
                                    android:textStyle="bold">

                                </TextView>
                                <ProgressBar
                                    android:visibility="gone"
                                    android:paddingLeft="@dimen/_25sdp"
                                    android:paddingRight="@dimen/_25sdp"
                                    android:id="@+id/progressBarLarge"
                                    android:layout_margin="@dimen/three"
                                    style="?android:attr/progressBarStyleLarge"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    app:layout_constraintBottom_toBottomOf="parent"
                                    app:layout_constraintLeft_toLeftOf="parent"
                                    app:layout_constraintRight_toRightOf="parent"
                                    app:layout_constraintTop_toTopOf="parent" />
                            </LinearLayout>


                        </soup.neumorphism.NeumorphCardView>
                    </LinearLayout>


                </LinearLayout>

            </LinearLayout>


        </RelativeLayout>
    </LinearLayout>

</ScrollView><!--

    -->


