<?xml version="1.0" encoding="utf-8"?>
<com.google.android.gms.ads.nativead.NativeAdView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/native_ad_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/backgroundBG"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_centerInParent="true"
        android:layout_gravity="center"
        android:padding="5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/background"
            android:layout_width="match_parent"
            android:layout_height="380dp"
            android:layout_centerInParent="true"
            android:layout_gravity="center"
            android:padding="5dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <RelativeLayout
                android:id="@+id/rl_top"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_margin="@dimen/anynews_no_size"
                android:layout_marginTop="@dimen/anynews_no_margin"
                app:layout_constraintBottom_toTopOf="@id/middle"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:id="@+id/iv_ad_view_blur"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#121212"
                    android:scaleType="fitXY" />

                <com.google.android.gms.ads.nativead.MediaView
                    android:id="@+id/media_view"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:layout_alignParentTop="true"
                    android:background="#121212"
                    android:layout_gravity="bottom"
                    android:layout_marginStart="@dimen/anynews_no_size"
                    android:layout_marginTop="@dimen/anynews_no_size"
                    android:layout_marginEnd="@dimen/anynews_no_size"
                    android:layout_marginBottom="@dimen/anynews_no_size"
                    android:visibility="visible" />
            </RelativeLayout>


            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/middle"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="@dimen/anynews_small_margin"
                app:layout_constraintBottom_toTopOf="@+id/textView_body_googleads"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/rl_top">

                <androidx.constraintlayout.widget.ConstraintLayout

                    android:layout_width="@dimen/anynews_no_size"
                    android:layout_height="@dimen/anynews_no_size"
                    android:orientation="horizontal"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:id="@+id/icon"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="@dimen/anynews_default_margin"
                        android:layout_marginTop="@dimen/anynews_no_margin"
                        android:layout_marginEnd="@dimen/anynews_no_margin"
                        android:layout_marginBottom="@dimen/anynews_no_margin"
                        android:layout_weight="0"
                        android:scaleType="fitCenter"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintDimensionRatio="H,1:1"
                        app:layout_constraintEnd_toStartOf="@id/content"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/content"
                        android:layout_width="@dimen/anynews_no_size"
                        android:layout_height="@dimen/anynews_no_size"
                        android:layout_marginStart="@dimen/anynews_default_margin"
                        android:layout_marginLeft="@dimen/anynews_default_margin"
                        android:orientation="vertical"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/icon"
                        app:layout_constraintTop_toTopOf="parent">

                        <LinearLayout
                            android:id="@+id/headline"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/anynews_no_size"
                            android:layout_weight="0.5"
                            android:background="@android:color/transparent"
                            android:gravity="left"
                            android:orientation="horizontal"
                            app:layout_constraintBottom_toTopOf="@+id/row_two"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent">

                            <TextView
                                android:id="@+id/primary"
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:layout_marginStart="@dimen/anynews_no_margin"
                                android:layout_marginTop="@dimen/anynews_no_margin"
                                android:layout_marginEnd="@dimen/anynews_no_margin"
                                android:layout_marginBottom="@dimen/anynews_no_margin"
                                android:lines="1"
                                android:textColor="@color/anynews_gray"
                                android:textSize="@dimen/anynews_text_size_large"
                                android:textStyle="bold"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toEndOf="parent"
                                app:layout_constraintTop_toTopOf="parent" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/row_two"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/anynews_no_size"
                            android:layout_weight="0.5"
                            android:orientation="horizontal"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/headline">

                            <TextView
                                android:id="@+id/ad_notification_view"
                                android:layout_width="@dimen/anynews_ad_indicator_width"
                                android:layout_height="@dimen/anynews_ad_indicator_height"
                                android:layout_marginStart="@dimen/anynews_no_margin"
                                android:layout_marginTop="@dimen/anynews_ad_indicator_top_margin"
                                android:layout_marginEnd="@dimen/anynews_default_margin"
                                android:background="@drawable/anynews_rounded_corners_shape"
                                android:gravity="center"
                                android:text="Ad"
                                android:textColor="@color/anynews_ad_green"
                                android:textSize="@dimen/anynews_ad_indicator_text_size"
                                android:textStyle="bold"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent" />

                            <RatingBar
                                android:id="@+id/rating_bar"
                                style="?android:attr/ratingBarStyleSmall"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/anynews_no_margin"
                                android:layout_marginTop="@dimen/anynews_no_margin"
                                android:layout_marginEnd="@dimen/anynews_no_margin"
                                android:layout_marginBottom="@dimen/anynews_no_margin"
                                android:background="@android:color/transparent"
                                android:lines="1"
                                android:numStars="5"
                                android:stepSize="0.1"
                                android:textColor="@color/anynews_gray"
                                android:textSize="@dimen/anynews_text_size_small"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toEndOf="@id/ad_notification_view"
                                app:layout_constraintTop_toTopOf="parent">

                            </RatingBar>

                            <TextView
                                android:id="@+id/secondary"
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:layout_marginStart="@dimen/anynews_no_margin"
                                android:layout_marginTop="@dimen/anynews_no_margin"
                                android:layout_marginEnd="@dimen/anynews_no_margin"
                                android:layout_marginBottom="@dimen/anynews_no_margin"
                                android:background="@color/form_surface_elevated"
                                android:gravity="top"
                                android:lines="1"
                                android:textColor="@color/anynews_gray"
                                android:textSize="@dimen/anynews_text_size_small"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toEndOf="@id/ad_notification_view"
                                app:layout_constraintTop_toTopOf="parent" />

                        </LinearLayout>


                    </androidx.constraintlayout.widget.ConstraintLayout>


                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <TextView
                android:id="@+id/textView_body_googleads"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/anynews_no_size"
                android:layout_marginBottom="@dimen/anynews_small_margin"
                android:maxLines="3"
                android:paddingStart="@dimen/anynews_default_margin"
                android:paddingLeft="@dimen/anynews_default_margin"
                android:paddingBottom="@dimen/anynews_default_margin"
                app:layout_constraintBottom_toTopOf="@+id/cta"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/middle" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/cta"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_46sdp"
                android:layout_marginLeft="5dp"
                android:layout_marginRight="5dp"
                android:background="@color/anynews_blue"
                android:gravity="center"
                android:lines="1"
                android:textColor="@color/on_brand_text"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHeight_min="35dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/textView_body_googleads" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.gms.ads.nativead.NativeAdView>

