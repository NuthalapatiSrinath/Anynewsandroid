<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/gallery_layout">

    <RelativeLayout
        android:id="@+id/scrren_icon"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.viewpager.widget.ViewPager
            android:id="@+id/viewpager"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:id="@+id/image_gallary_scrip"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_alignParentBottom="true"
            android:background="@drawable/ic_half_image_strike_icon"
            android:visibility="gone">

            <ImageView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="@dimen/three"
                android:layout_weight="1.5"
                android:src="@drawable/ic_logo_strip_icon">

            </ImageView>

            <TextView
                android:id="@+id/strip_text_name"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="7"
                android:gravity="center"
                android:text=" "
                android:textColor="@color/on_brand_text"
                android:textSize="@dimen/_12sdp"
                android:textStyle="bold"
                android:visibility="visible">

            </TextView>

            <ImageView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginTop="@dimen/six"
                android:layout_marginRight="@dimen/ten"
                android:layout_weight="3"
                android:gravity="left|center"
                android:scaleType="fitXY"
                android:src="@drawable/ic_download_now_icon">

            </ImageView>


        </LinearLayout>

        <RelativeLayout
            android:id="@+id/relativeLayoutShareOpt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:background="@drawable/reactangle_top_radius"
            android:padding="@dimen/_10sdp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent">

            <TextView
                android:id="@+id/textViewShare"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_marginTop="@dimen/_10sdp"
                android:text="@string/share"
                android:textColor="@color/black"
                android:textSize="@dimen/_16sdp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/imageViewShareClose"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_marginTop="@dimen/_10sdp"
                android:src="@drawable/ic_black_close_icon" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/textViewShare"
                android:layout_marginTop="@dimen/_20sdp">

                <ImageView
                    android:id="@+id/imageViewShareSingle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:src="@drawable/ic_share_credit_card" />

                <TextView
                    android:id="@+id/textViewSinglePage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerHorizontal="true"
                    android:layout_centerVertical="true"
                    android:layout_toEndOf="@+id/imageViewShareSingle"
                    android:paddingStart="@dimen/_5sdp"
                    android:text="@string/single_page"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_12sdp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:layout_centerHorizontal="true"
                    android:layout_centerVertical="true"
                    android:gravity="center"
                    android:text="@string/or"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_12sdp" />

                <ImageView
                    android:id="@+id/imageViewShareAll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:layout_toStartOf="@+id/textViewAllPage"
                    android:paddingRight="@dimen/_5sdp"
                    android:src="@drawable/ic_share_all" />

                <TextView
                    android:id="@+id/textViewAllPage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerHorizontal="true"
                    android:layout_centerVertical="true"
                    android:text="@string/total_magazine"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_12sdp" />


            </RelativeLayout>
        </RelativeLayout>

    </RelativeLayout>

    <LinearLayout
        android:id="@+id/dotIndicatior"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_marginBottom="@dimen/_10sdp">

        <LinearLayout
            android:id="@+id/video_side_menu"
            android:layout_width="@dimen/_150sdp"
            android:layout_height="@dimen/_32sdp"
            android:gravity="center"
            android:background="@drawable/gallery_strip"
            android:orientation="vertical"
            android:visibility="visible">

            <com.tbuonomo.viewpagerdotsindicator.WormDotsIndicator
                android:id="@+id/indicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                app:dotsColor="@color/colorPrimary"
                app:dotsCornerRadius="8dp"
                app:dotsSize="12dp"
                app:dotsSpacing="4dp"
                app:dotsStrokeColor="@color/white"
                app:dotsWidthFactor="2.5" />
        </LinearLayout>

    </LinearLayout>
    <!-- Magazines/Special glow galleries: blue blink Share bottom-right (above footer).
         Normal News galleries keep this GONE. Same asset as Calendar / full_image. -->
    <ImageView
        android:id="@+id/image_gallary_share"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="end|bottom"
        android:layout_marginEnd="@dimen/_20sdp"
        android:layout_marginBottom="64dp"
        android:visibility="gone"
        android:contentDescription="@string/share_more_options"
        android:padding="12dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_share_full"/>


</FrameLayout>