<?xml version="1.0" encoding="utf-8"?>
<!-- Jobs hub — dark navy UI matching Jobs mock. Banner is clean image; text overlays in code. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/jobs_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF060B18"
    android:fitsSystemWindows="false"
    tools:context=".Activities.JobsPageActivity">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="28dp">

            <!-- Header -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="10dp"
                android:paddingTop="8dp"
                android:paddingEnd="10dp"
                android:paddingBottom="6dp">

                <ImageView
                    android:id="@+id/jobs_back"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/cancel"
                    android:padding="8dp"
                    android:src="@drawable/ic_calendar_chevron_left"
                    android:tint="#FFFFFFFF" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingStart="44dp"
                    android:paddingEnd="44dp">

                    <TextView
                        android:id="@+id/jobs_top_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/sreekrushnadevaraya_regular"
                        android:gravity="center"
                        android:textColor="#FFFFFFFF"
                        android:textSize="22sp"
                        tools:text="ఉద్యోగాలు" />

                    <View
                        android:layout_width="56dp"
                        android:layout_height="4dp"
                        android:layout_marginTop="2dp"
                        android:background="@drawable/bg_jobs_title_flourish" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/jobs_share"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/local_update_share"
                    android:padding="9dp"
                    android:src="@drawable/ic_baseline_share_24"
                    android:tint="#FFFFFFFF" />
            </RelativeLayout>

            <!-- Clean top banner + optional overlay title -->
            <FrameLayout
                android:id="@+id/jobs_banner_frame"
                android:layout_width="match_parent"
                android:layout_height="118dp"
                android:layout_marginStart="14dp"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="14dp">

                <ImageView
                    android:id="@+id/jobs_banner_image"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop"
                    android:src="@drawable/jobs_top_banner" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="14dp"
                    android:gravity="end"
                    android:orientation="vertical"
                    android:paddingStart="8dp">

                    <TextView
                        android:id="@+id/jobs_banner_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:shadowColor="#88000000"
                        android:shadowDx="0"
                        android:shadowDy="1"
                        android:shadowRadius="3"
                        android:textColor="#FFFFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        tools:text="మీ కలల ఉద్యోగం" />

                    <TextView
                        android:id="@+id/jobs_banner_subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:shadowColor="#88000000"
                        android:shadowDx="0"
                        android:shadowDy="1"
                        android:shadowRadius="2"
                        android:textColor="#FFE2E8F0"
                        android:textSize="11sp"
                        tools:text="వెతకండి.. అప్లై చేయండి.. సాధించండి!" />
                </LinearLayout>
            </FrameLayout>

            <!-- Search + Filter -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_jobs_search"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_jobs_search"
                        android:tint="#FF94A3B8" />

                    <EditText
                        android:id="@+id/jobs_search"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:hint="Search…"
                        android:imeOptions="actionSearch"
                        android:inputType="text"
                        android:maxLines="1"
                        android:textColor="#FFFFFFFF"
                        android:textColorHint="#FF64748B"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/jobs_filter_btn"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_jobs_filter"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_jobs_filter"
                        android:tint="#FFE2E8F0" />

                    <TextView
                        android:id="@+id/jobs_filter_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:textColor="#FFE2E8F0"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        tools:text="ఫిల్టర్" />
                </LinearLayout>
            </LinearLayout>

            <!-- Categories — edge-to-edge horizontal chips (no More/మరిన్ని) -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/jobs_categories"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <!-- Stats -->
            <LinearLayout
                android:id="@+id/jobs_stats_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginTop="14dp"
                android:layout_marginEnd="10dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="4dp">

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:contentDescription="@null"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_jobs_total" />

                    <TextView
                        android:id="@+id/jobs_stat_total_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center"
                        android:textColor="#FF94A3B8"
                        android:textSize="10sp"
                        tools:text="మొత్తం ఉద్యోగాలు" />

                    <TextView
                        android:id="@+id/jobs_stat_total"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#FF60A5FA"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        tools:text="0" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="4dp">

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:contentDescription="@null"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_jobs_companies" />

                    <TextView
                        android:id="@+id/jobs_stat_companies_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center"
                        android:textColor="#FF94A3B8"
                        android:textSize="10sp"
                        tools:text="కంపెనీలు" />

                    <TextView
                        android:id="@+id/jobs_stat_companies"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#FF4ADE80"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        tools:text="0" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="4dp">

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:contentDescription="@null"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_jobs_locations" />

                    <TextView
                        android:id="@+id/jobs_stat_locations_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center"
                        android:textColor="#FF94A3B8"
                        android:textSize="10sp"
                        tools:text="స్థలాలు" />

                    <TextView
                        android:id="@+id/jobs_stat_locations"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#FFFB923C"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        tools:text="0" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="4dp">

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:contentDescription="@null"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_jobs_new" />

                    <TextView
                        android:id="@+id/jobs_stat_new_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center"
                        android:textColor="#FF94A3B8"
                        android:textSize="10sp"
                        tools:text="కొత్త ఉద్యోగాలు" />

                    <TextView
                        android:id="@+id/jobs_stat_new"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#FFA78BFA"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        tools:text="0" />

                    <TextView
                        android:id="@+id/jobs_stat_new_sub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#FF64748B"
                        android:textSize="9sp"
                        tools:text="ఈ రోజు" />
                </LinearLayout>
            </LinearLayout>

            <!-- Latest jobs header -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="14dp">

                <TextView
                    android:id="@+id/jobs_list_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:textColor="#FFFFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="తాజా ఉద్యోగాలు" />

                <TextView
                    android:id="@+id/jobs_sort_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/bg_jobs_filter"
                    android:paddingStart="10dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="5dp"
                    android:textColor="#FFCBD5E1"
                    android:textSize="11sp"
                    tools:text="తాజాగా" />
            </RelativeLayout>

            <LinearLayout
                android:id="@+id/jobs_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />

            <TextView
                android:id="@+id/jobs_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="28dp"
                android:textColor="#FF64748B"
                android:textSize="13sp"
                android:visibility="gone"
                tools:text="No jobs posted yet"
                tools:visibility="visible" />

            <LinearLayout
                android:id="@+id/jobs_see_more"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginStart="14dp"
                android:layout_marginTop="14dp"
                android:layout_marginEnd="14dp"
                android:background="@drawable/bg_jobs_cta"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_jobs_briefcase"
                    android:tint="#FFFFFFFF" />

                <TextView
                    android:id="@+id/jobs_see_more_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textColor="#FFFFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="ఉద్యోగాలు చూడండి" />

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="6dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_calendar_chevron_right"
                    android:tint="#FFFFFFFF" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</FrameLayout>
