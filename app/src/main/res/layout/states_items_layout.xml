<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="175dp"
  >

    <com.anyNews.anynews.Ui.NeomorphFrameLayout
        android:visibility="gone"
        android:id="@+id/states_neomorphFrameLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/five"
        android:clickable="true"
        android:focusable="true"
        app:neomorph_shadow_type="outer"
        app:neomorph_layer_type="hardware"
        app:neomorph_background_color="@color/chip_background"
        app:neomorph_corner_radius="20dp"
        app:neomorph_elevation="5dp"
        app:neomorph_view_type="rectangular"
        app:neomorph_shadow_color="#D0D2D5"
        app:neomorph_highlight_color="@color/neomorph_highlight_color"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:gravity="center"
            android:layout_height="match_parent">

            <com.anyNews.anynews.Ui.NeomorphFrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="2dp"
                app:neomorph_shadow_type="outer"
                app:neomorph_layer_type="hardware"
                app:neomorph_background_color="@color/chip_background"
                app:neomorph_corner_radius="20dp"
                app:neomorph_elevation="0dp"
                app:neomorph_view_type="rectangular"
                app:neomorph_shadow_color="#D0D2D5"
                app:neomorph_highlight_color="@color/neomorph_highlight_color"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent">


                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:gravity="center"
                    android:layout_height="match_parent">





                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="0dp"
                        android:layout_weight="5"
                        android:gravity="center"
                        android:layout_height="match_parent">

                        <LinearLayout
                            android:orientation="vertical"
                            android:layout_width="match_parent"
                            android:gravity="center"
                            android:layout_height="match_parent">

                            <ImageView
                                android:id="@+id/state_landmark"
                                android:layout_width="match_parent"
                                android:layout_height="0dp"
                                android:layout_weight="3"
                                android:layout_marginTop="@dimen/ten"
                                android:adjustViewBounds="true"
                                android:scaleType="fitCenter"
                                android:contentDescription="@string/app_name"
                                android:src="@drawable/ic_landmark_monument" />

                            <LinearLayout
                                android:orientation="horizontal"
                                android:layout_width="match_parent"
                                android:gravity="center"
                                android:layout_weight="2"
                                android:layout_height="0dp">

                                <TextView
                                    android:id="@+id/new_states_name"
                                    android:layout_width="match_parent"
                                    android:textStyle="normal"
                                    android:layout_marginLeft="@dimen/ten"
                                    android:textSize="@dimen/_18sdp"
                                    android:text="XXXXXXXXXXXXXX"
                                    android:gravity="center"
                                    android:textColor="@color/chip_text_color"
                                    android:layout_height="match_parent">

                                </TextView>



                            </LinearLayout>


                        </LinearLayout>



                    </LinearLayout>




                </LinearLayout>

            </com.anyNews.anynews.Ui.NeomorphFrameLayout>

        </LinearLayout>

    </com.anyNews.anynews.Ui.NeomorphFrameLayout>

    <com.anyNews.anynews.Ui.NeomorphFrameLayout
        android:id="@+id/second_states_neomorphFrameLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/five"
        android:clickable="true"
        android:focusable="true"
        app:neomorph_shadow_type="outer"
        app:neomorph_layer_type="hardware"
        app:neomorph_background_color="@color/brand_orange"
        app:neomorph_corner_radius="20dp"
        app:neomorph_elevation="5dp"
        app:neomorph_view_type="rectangular"
        app:neomorph_shadow_color="#D0D2D5"
        app:neomorph_highlight_color="@color/neomorph_highlight_color"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:gravity="center"
            android:layout_height="match_parent">

            <com.anyNews.anynews.Ui.NeomorphFrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="2dp"
                app:neomorph_shadow_type="outer"
                app:neomorph_layer_type="hardware"
                app:neomorph_background_color="@color/brand_orange"
                app:neomorph_corner_radius="20dp"
                app:neomorph_elevation="0dp"
                app:neomorph_view_type="rectangular"
                app:neomorph_shadow_color="@color/brand_orange"
                app:neomorph_highlight_color="#ffffff"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent">


                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:gravity="center"
                    android:layout_height="match_parent">





                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="0dp"
                        android:layout_weight="5"
                        android:gravity="center"
                        android:layout_height="match_parent">

                        <LinearLayout
                            android:orientation="vertical"
                            android:layout_width="match_parent"
                            android:gravity="center"
                            android:layout_height="match_parent">

                            <ImageView
                                android:id="@+id/second_state_landmark"
                                android:layout_width="match_parent"
                                android:layout_height="0dp"
                                android:layout_weight="3"
                                android:layout_marginTop="@dimen/ten"
                                android:adjustViewBounds="true"
                                android:scaleType="fitCenter"
                                android:contentDescription="@string/app_name"
                                android:src="@drawable/ic_landmark_monument" />

                            <LinearLayout
                                android:orientation="horizontal"
                                android:layout_width="match_parent"
                                android:gravity="center"
                                android:layout_weight="2"
                                android:layout_height="0dp">

                                <TextView
                                    android:id="@+id/second_new_states_name"
                                    android:layout_width="match_parent"
                                    android:textStyle="normal"
                                    android:layout_marginLeft="@dimen/ten"
                                    android:textSize="@dimen/_18sdp"
                                    android:text="XXXXXXXXXXXXXX"
                                    android:gravity="center"
                                    android:textColor="@color/white"
                                    android:layout_height="match_parent">

                                </TextView>



                            </LinearLayout>


                        </LinearLayout>



                    </LinearLayout>




                </LinearLayout>

            </com.anyNews.anynews.Ui.NeomorphFrameLayout>

        </LinearLayout>

    </com.anyNews.anynews.Ui.NeomorphFrameLayout>
