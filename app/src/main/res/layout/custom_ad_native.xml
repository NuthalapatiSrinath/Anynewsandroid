<?xml version="1.0" encoding="utf-8"?>
<com.google.android.gms.ads.nativead.NativeAdView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:background="#121212"
      android:orientation="vertical">

    <FrameLayout
        android:id="@+id/rl_top"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="120dp">

      <ImageView
          android:id="@+id/iv_ad_view_blur"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:background="#121212"
          android:contentDescription="@null"
          android:scaleType="fitCenter"
          android:visibility="gone" />

      <com.google.android.gms.ads.nativead.MediaView
          android:id="@+id/ad_media"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:layout_gravity="center"
          android:background="#121212"
          android:minHeight="120dp"
          android:visibility="visible" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/rl_btm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/_10sdp"
        android:layout_marginRight="@dimen/_10sdp"
        android:layout_marginBottom="@dimen/_3sdp"
        android:orientation="vertical"
        android:paddingTop="@dimen/_3sdp">

      <RelativeLayout
          android:layout_width="wrap_content"
          android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/adImage_log"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_centerVertical="true" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/_5sdp"
            android:layout_toRightOf="@+id/adImage_log"
            android:orientation="vertical">

          <TextView
              android:id="@+id/textView17_main"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:ellipsize="end"
              android:gravity="center"
              android:maxLength="25"
              android:maxLines="1"
              android:textColor="@color/text_color_primary"
              android:textSize="12dp" />

          <TextView
              android:id="@+id/textView17"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:ellipsize="end"
              android:gravity="center"
              android:maxLength="25"
              android:maxLines="1"
              android:text=" Advertisement "
              android:textColor="@color/content_desc_color"
              android:textSize="10dp" />
        </LinearLayout>

        <RatingBar
            android:id="@+id/ratingBar_google"
            style="?android:attr/ratingBarStyleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:isIndicator="true"
            android:numStars="5"
            android:stepSize="0.5"
            android:visibility="gone" />
      </RelativeLayout>

      <TextView
          android:id="@+id/textView_title_googleads"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="4dp"
          android:ellipsize="end"
          android:fontFamily="@font/roboto_regular"
          android:maxLines="2"
          android:textColor="@color/black"
          android:textSize="@dimen/_14sdp" />

      <TextView
          android:id="@+id/textView_body_googleads"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="2dp"
          android:ellipsize="end"
          android:fontFamily="@font/roboto_regular"
          android:lineSpacingExtra="1dp"
          android:maxLines="2"
          android:textColor="@color/content_desc_color"
          android:textSize="@dimen/_12sdp" />

      <TextView
          android:id="@+id/button_googlead"
          android:layout_width="wrap_content"
          android:layout_height="@dimen/_34sdp"
          android:layout_gravity="center"
          android:layout_marginTop="@dimen/_6sdp"
          android:layout_marginBottom="@dimen/_2sdp"
          android:background="@drawable/bg_grey_border6"
          android:gravity="center"
          android:minHeight="@dimen/_34sdp"
          android:paddingLeft="@dimen/_25sdp"
          android:paddingRight="@dimen/_25sdp"
          android:text="Visit Site"
          android:textColor="@color/text_color_primary"
          android:textSize="@dimen/_13sdp"
          android:visibility="visible" />
    </LinearLayout>
  </LinearLayout>
</com.google.android.gms.ads.nativead.NativeAdView>