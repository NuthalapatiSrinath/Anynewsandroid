<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="@dimen/_90sdp">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/_90sdp">


        <soup.neumorphism.NeumorphCardView
            style="@style/Two_Widget.Neumorph.ImageButton"
            android:layout_below="@+id/basin_image_view"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            app:neumorph_shadowElevation="5dp"
            app:neumorph_shadowColorLight="@color/white"
            app:neumorph_shadowColorDark="#4DDFDDDD"
            android:scaleType="centerInside"
            app:neumorph_strokeWidth="1dp"
            app:neumorph_shapeAppearance="@style/ShapeAppearance_profile"
            app:neumorph_strokeColor="@color/design_default_color_on_primary"
            app:layout_constraintEnd_toEndOf="parent"
            app:neumorph_shapeType="flat">

            <soup.neumorphism.NeumorphCardView
                style="@style/Profile_In_Widget.Neumorph.ImageButton"
                android:layout_below="@+id/basin_image_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:neumorph_shadowElevation="0dp"
                app:neumorph_shadowColorLight="#4DDFDDDD"
                app:neumorph_shadowColorDark="@color/white"
                android:scaleType="centerInside"
                app:neumorph_strokeWidth="1dp"
                android:layout_margin="1dp"
                app:neumorph_shapeAppearance="@style/ShapeAppearance_profile"
                app:neumorph_strokeColor="@color/profile_border"
                app:layout_constraintEnd_toEndOf="parent"
                app:neumorph_shapeType="flat" >



                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:gravity="center"
                    android:background="@color/profile_background"
                    android:layout_height="match_parent">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="2"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:layout_height="match_parent">


                        <androidx.cardview.widget.CardView
                            app:cardCornerRadius="@dimen/eight"
                            android:layout_margin="@dimen/eight"
                            app:cardElevation="@dimen/five"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <ImageView
                                android:id="@+id/follower_images"
                                android:src="@drawable/ic_user_profile"
                                android:scaleType="fitXY"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent">

                            </ImageView>

                        </androidx.cardview.widget.CardView>

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="3"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:layout_height="match_parent">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:gravity="center"
                            android:layout_marginTop="@dimen/_10sdp"
                            android:orientation="vertical"
                            android:layout_height="match_parent">

                            <TextView
                                android:id="@+id/follower_menber_name"
                                android:textSize="@dimen/_10sdp"
                                android:layout_gravity="left|center"
                                android:textStyle="bold"
                                android:gravity="left|center"
                                android:textColor="@color/black"
                                android:layout_width="match_parent"
                                android:layout_height="40dp"
                                android:text="Akkisetty Narasimha rao" />


                            <LinearLayout
                                android:layout_width="match_parent"
                                android:gravity="top|center"
                                android:layout_height="30dp">

                                <TextView
                                    android:id="@+id/follower_menber_designation"
                                    android:textSize="@dimen/_6sdp"
                                    android:textStyle="bold"
                                    android:gravity="left|top"
                                    android:textColor="@color/black"
                                    android:layout_width="wrap_content"
                                    android:layout_height="match_parent"
                                    android:text="Sr Reportor "
                                    android:layout_marginRight="@dimen/_5sdp"
                                    />

                                <ImageView
                                    android:layout_marginTop="-5dp"
                                    android:layout_width="15dp"
                                    android:gravity="left|top"
                                    android:hint="#434433"
                                    android:src="@drawable/ic_location_icons"
                                    android:layout_height="wrap_content">

                                </ImageView>

                                <TextView
                                    android:id="@+id/follower_menber_location"
                                    android:textSize="@dimen/_6sdp"
                                    android:textStyle="bold"
                                    android:gravity="left|top"
                                    android:textColor="@color/black"
                                    android:layout_width="0dp"
                                    android:layout_weight="1"
                                    android:layout_height="wrap_content"
                                    android:text="Hyderabad"
                                    />

                            </LinearLayout>

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="0dp"
                                android:layout_weight="1">

                            </View>
                        </LinearLayout>

                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="2"
                        android:orientation="vertical"
                        android:gravity="left|center"
                        android:layout_height="match_parent">


                            <soup.neumorphism.NeumorphCardView
                                android:id="@+id/neumorph_follow"
                                style="@style/Widget.Neumorph.ImageButton"
                                android:layout_below="@+id/basin_image_view"
                                android:layout_width="match_parent"
                                android:layout_height="50dp"
                                android:gravity="center"
                                android:textSize="@dimen/_15sdp"
                                app:neumorph_shadowElevation="4dp"
                                app:neumorph_shadowColorLight="#FFFFFF"
                                app:neumorph_shadowColorDark="#F2DFDFDF"
                                android:scaleType="centerInside"
                                app:neumorph_strokeWidth="2dp"
                                app:neumorph_strokeColor="#FF2401"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:neumorph_shapeType="flat" >




                                    <TextView
                                        android:id="@+id/follower_menber_follow"
                                        android:text="Follow"
                                        android:gravity="center"
                                        android:textStyle="bold"
                                        android:textColor="@color/white"
                                        android:textSize="@dimen/_8sdp"
                                        android:background="#FF4027"
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent">

                                    </TextView>



                            </soup.neumorphism.NeumorphCardView>

                           <soup.neumorphism.NeumorphCardView
                            android:id="@+id/neumorph_follower"
                            style="@style/Widget.Neumorph.ImageButton"
                            android:layout_below="@+id/basin_image_view"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:gravity="center"
                            android:textSize="@dimen/_15sdp"
                            app:neumorph_shadowElevation="4dp"
                            app:neumorph_shadowColorLight="#FFFFFF"
                            app:neumorph_shadowColorDark="@color/white"
                            android:scaleType="centerInside"
                            app:neumorph_strokeWidth="2dp"
                            app:neumorph_strokeColor="#FF2401"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:neumorph_shapeType="flat" >




                            <TextView
                                android:id="@+id/follower_menber_follow_er"
                                android:text="Following"
                                android:gravity="center"
                                android:textStyle="bold"
                                android:textColor="@color/red"
                                android:textSize="@dimen/_8sdp"
                                android:background="@color/white"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent">

                            </TextView>



                        </soup.neumorphism.NeumorphCardView>
                    </LinearLayout>



                </LinearLayout>


            </soup.neumorphism.NeumorphCardView>


        </soup.neumorphism.NeumorphCardView>


    </LinearLayout>
</LinearLayout>