<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/app_bg_color"
    android:layout_height="match_parent">
    <androidx.cardview.widget.CardView
        xmlns:flip="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintTop_toTopOf="parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <RelativeLayout
            android:id="@+id/yes_internet"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/transparent_white"
                android:orientation="vertical">

                <!--  Top Menu -->
                <LinearLayout
                    android:id="@+id/top_item_layout"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="0.4"
                    android:visibility="gone"
                    android:background="@color/background_color"
                    android:gravity="center|bottom"
                    android:orientation="horizontal">


                    <LinearLayout
                        android:id="@+id/selected_my_feed"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="0.5"
                        android:gravity="center|bottom"
                        android:orientation="horizontal">


                        <TextView
                            android:id="@+id/my_feed"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center|bottom"
                            android:background="@drawable/underline_feed"
                            android:paddingLeft="@dimen/_3sdp"
                            android:paddingRight="@dimen/_3sdp"
                            android:paddingBottom="@dimen/_2sdp"
                            android:text="@string/my_feed"
                            android:textColor="@color/selected_feed_color"
                            android:textStyle="bold"
                            android:textAllCaps="true"
                            android:fontFamily="@font/roboto_bold"/>


                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/un_selected_my_feed"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="0.5"
                        android:background="@color/background_color"
                        android:gravity="center|bottom"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/my_feed_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_15sdp"
                            android:text=" "
                            android:paddingBottom="@dimen/_2sdp"
                            android:textColor="@color/black"
                            android:textStyle="bold"
                            app:layout_constraintBottom_toBottomOf="@+id/button"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="@+id/button"
                            android:textAllCaps="true"
                            android:fontFamily="@font/roboto_bold"/>
                    </LinearLayout>

                    <!-- local -->
                    <LinearLayout
                        android:id="@+id/un_selected_local"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="0.5"
                        android:background="@color/background_color"
                        android:clickable="false"
                        android:gravity="center|bottom"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/local_distic_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_15sdp"
                            android:text="@string/india"
                            android:textColor="@color/black"
                            android:textStyle="bold"
                            android:paddingBottom="@dimen/_2sdp"
                            android:gravity="center|bottom"
                            app:layout_constraintBottom_toBottomOf="@+id/button"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="@+id/button"
                            android:textAllCaps="true"
                            android:fontFamily="@font/roboto_bold"/>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/selected_local"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="0.5"
                        android:clickable="false"
                        android:gravity="center|bottom"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/selelcted_local_distic_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center|bottom"
                            android:gravity="center|bottom"
                            android:paddingLeft="@dimen/_3sdp"
                            android:paddingRight="@dimen/_3sdp"
                            android:paddingBottom="@dimen/_2sdp"
                            android:text=" "
                            android:textColor="@color/selected_feed_color"
                            android:textStyle="bold"
                            android:textAllCaps="true"
                            android:fontFamily="@font/roboto_bold"
                            android:background="@drawable/underline_feed"/>

                        <!--   <soup.neumorphism.NeumorphCardView
                               android:layout_width="140dp"
                               android:layout_height="50dp"
                               android:text="Button"
                               app:layout_constraintBottom_toBottomOf="@+id/textView6"
                               app:layout_constraintStart_toEndOf="@+id/textView6"
                               app:layout_constraintTop_toTopOf="@+id/textView6"
                               app:neumorph_backgroundColor="@color/red_one">

                               <TextView
                                   android:layout_width="wrap_content"
                                   android:layout_height="wrap_content"
                                   android:layout_gravity="center"
                                   android:text="MY FEED "
                                   android:textStyle="bold"
                                   android:textColor="@color/on_brand_text" />
                           </soup.neumorphism.NeumorphCardView>-->

                    </LinearLayout>

                </LinearLayout>


                <!-- Feed + loading stacked so L→R reveal overlays without weight split -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="9">

                <LinearLayout
                    android:id="@+id/layout_with_data"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/data_finding_value"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@color/transparent_white"
                        android:gravity="bottom"
                        android:orientation="vertical">

                        <com.anyNews.anynews.flipview.FlipView
                            android:id="@+id/flip_view"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@color/transparent_white"
                            android:visibility="gone"/>

                        <androidx.percentlayout.widget.PercentRelativeLayout
                            android:id="@+id/post_news_scrren"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="9"
                            android:background="@drawable/transparent"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="bottom"
                            android:visibility="gone">

                            <LinearLayout
                                android:id="@+id/floating_action_button"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:clickable="true"
                                android:focusable="true"
                                android:gravity="bottom"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/fab_article"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:paddingLeft="16dp"
                                    android:paddingRight="16dp"
                                    android:text="Article"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />


                                <ImageView
                                    android:id="@+id/fab4"
                                    android:layout_width="65dp"
                                    android:layout_height="75dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/article_fab_button"
                                    android:visibility="visible" />


                                <com.google.android.material.floatingactionbutton.FloatingActionButton
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_artical_image"
                                    android:visibility="gone">


                                </com.google.android.material.floatingactionbutton.FloatingActionButton>


                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="@dimen/_50sdp"
                                    android:gravity="center"
                                    android:orientation="horizontal">

                                    <LinearLayout
                                        android:layout_width="0dp"
                                        android:layout_height="match_parent"
                                        android:layout_weight="1"
                                        android:gravity="right">

                                        <TextView
                                            android:id="@+id/fab_video"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_gravity="center"
                                            android:paddingTop="16dp"
                                            android:paddingBottom="16dp"
                                            android:text="Video Post"
                                            android:textSize="@dimen/_9sdp"
                                            android:textStyle="bold" />

                                        <ImageView
                                            android:id="@+id/fab1"
                                            android:layout_width="65dp"
                                            android:layout_height="75dp"
                                            android:layout_gravity="center"
                                            android:src="@drawable/video_post_fab"
                                            android:visibility="visible" />


                                        <com.google.android.material.floatingactionbutton.FloatingActionButton

                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_gravity="center"
                                            android:src="@drawable/ic_video_icons_value"
                                            android:visibility="gone">

                                        </com.google.android.material.floatingactionbutton.FloatingActionButton>

                                    </LinearLayout>

                                    <View
                                        android:layout_width="0dp"
                                        android:layout_height="match_parent"
                                        android:layout_weight="0.5">

                                    </View>

                                    <LinearLayout
                                        android:layout_width="0dp"
                                        android:layout_height="match_parent"
                                        android:layout_weight="1">


                                        <ImageView
                                            android:id="@+id/fab2"
                                            android:layout_width="65dp"
                                            android:layout_height="75dp"
                                            android:layout_gravity="center"
                                            android:src="@drawable/full_image_fab"
                                            android:visibility="visible" />

                                        <com.google.android.material.floatingactionbutton.FloatingActionButton
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_gravity="center"
                                            android:src="@drawable/ic_scoop_icon"
                                            android:visibility="gone">

                                        </com.google.android.material.floatingactionbutton.FloatingActionButton>

                                        <TextView
                                            android:id="@+id/fab_fullpost"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_gravity="center"
                                            android:paddingTop="16dp"
                                            android:paddingBottom="16dp"
                                            android:text="Full Post"
                                            android:textSize="@dimen/_9sdp"
                                            android:textStyle="bold" />
                                    </LinearLayout>


                                </LinearLayout>


                            </LinearLayout>

                        </androidx.percentlayout.widget.PercentRelativeLayout>

                        <LinearLayout
                            android:id="@+id/txtNoData"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:visibility="gone">
                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent">

                                <ImageView
                                    android:id="@+id/goHomePage"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:src="@drawable/ic_close"
                                    android:padding="@dimen/_10sdp"
                                    android:layout_alignParentLeft="true"
                                    android:layout_marginTop="@dimen/_10sdp"
                                    android:layout_marginRight="@dimen/_10sdp"/>

                                <ImageView
                                    android:id="@+id/imageViewNoData"
                                    android:layout_width="100dp"
                                    android:layout_height="100dp"
                                    android:layout_centerInParent="true"
                                    android:layout_gravity="center"
                                    android:src="@drawable/nodata">

                                </ImageView>

                                <TextView
                                    android:id="@+id/nodatascreen"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/ten"
                                    android:text="No data"
                                    android:layout_centerInParent="true"
                                    android:gravity="center"
                                    android:layout_below="@+id/imageViewNoData"
                                    android:textColor="@color/colorTextSecondary"
                                    android:textSize="@dimen/fiveteen">

                                </TextView>
                            </RelativeLayout>

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

                <!-- Park for the stable feed Exo surface PlayerView (reparented into
                     card exo_play_layout while playing). Not an overlay chrome host. -->
                <FrameLayout
                    android:id="@+id/feed_exo_surface_park"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone">

                    <androidx.media3.ui.PlayerView
                        android:id="@+id/feed_exo_surface_player"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@color/anynews_black"
                        app:keep_content_on_player_reset="true"
                        app:resize_mode="fit"
                        app:shutter_background_color="@android:color/transparent"
                        app:surface_type="texture_view"
                        app:use_artwork="false"
                        app:use_controller="false" />
                </FrameLayout>

                <LinearLayout
                    android:id="@+id/layout_with_out_data"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/feed_shimmer_surface"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <com.anyNews.anynews.Ui.HomeFeedRevealView
                        android:id="@+id/home_feed_reveal"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                </LinearLayout>

                <!-- In-place Bookmarks list (top toggle right segment). Above feed. -->
                <include
                    android:id="@+id/include_home_bookmarks_panel"
                    layout="@layout/layout_home_bookmarks_panel"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <!-- Footer Calendar mode: Telugu calendar FlipView (2 pages) above bottom nav. -->
                <FrameLayout
                    android:id="@+id/home_calendar_host"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#000000"
                    android:clickable="true"
                    android:focusable="true"
                    android:visibility="gone" />

                <!-- Footer Daily Updates mode: dark mock page above bottom nav. -->
                <FrameLayout
                    android:id="@+id/home_daily_updates_host"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#FF0B0F1A"
                    android:clickable="true"
                    android:focusable="true"
                    android:visibility="gone" />

                <!-- Panchangam | Raasi top chrome retired — separate Daily Updates tiles open each page. -->
                <include
                    android:id="@+id/include_home_calendar_ttd_toggle"
                    layout="@layout/layout_calendar_ttd_toggle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top"
                    android:visibility="gone" />

                <!-- Offline-only Offline News | Bookmarks toggle (hidden online). -->
                <include
                    android:id="@+id/include_home_news_bookmarks_toggle"
                    layout="@layout/layout_home_news_bookmarks_toggle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top" />

                <!-- Local Varthalu | district chrome (Mana Zilla → local-only path). -->
                <include
                    android:id="@+id/include_local_feed_chrome"
                    layout="@layout/layout_local_feed_chrome"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top"
                    android:visibility="gone" />

                <!-- Legacy Calendar|Reload overlay — permanently GONE; Calendar is footer center. -->
                <include
                    android:id="@+id/include_home_action_chrome"
                    layout="@layout/layout_home_action_chrome"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:visibility="gone" />

                </FrameLayout>

                <!--  Cricket footer tab (admin-controlled, APK 3.40.79+). GONE by
                      default so the footer is EXACTLY as before until enabled AND
                      a live match exists. Sits just above the bottom nav; adds no
                      space when hidden. -->
                <LinearLayout
                    android:id="@+id/layoutCricketFooterBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0.5dp"
                        android:background="#22000000" />

                    <LinearLayout
                        android:id="@+id/layoutCricketFooter"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@color/bottom_navigation_view_color"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingTop="7dp"
                        android:paddingBottom="7dp">

                        <ImageView
                            android:id="@+id/ivCricketFooter"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:contentDescription="@string/cricket"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_cricket_footer"
                            app:tint="@color/selector_item_primary_color" />

                        <TextView
                            android:id="@+id/tvCricketFooter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/cricket"
                            android:textAppearance="@style/BottomNavLabelActive"
                            android:textColor="@color/selector_item_primary_color" />
                    </LinearLayout>
                </LinearLayout>

                <!-- App update banner (admin soft/force). Above bottom nav; does not block flip. -->
                <include
                    android:id="@+id/includeAppUpdateBanner"
                    layout="@layout/layout_app_update_banner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <!--  Bottom Menu — fixed 50dp so magazine Share overlay cannot grow the bar -->
                <androidx.coordinatorlayout.widget.CoordinatorLayout
                    android:id="@+id/home_page_navigation"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:animateLayoutChanges="true">


                    <com.google.android.material.bottomnavigation.BottomNavigationView
                        android:id="@+id/nav_view"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_gravity="bottom"
                        android:background="@drawable/bg_bottom_nav_glass"
                        app:itemIconTint="@color/selector_item_primary_color"
                        app:itemTextColor="@color/selector_item_primary_color"
                        app:itemTextAppearanceActive="@style/BottomNavLabelActive"
                        app:itemTextAppearanceInactive="@style/BottomNavLabelInactive"
                        app:labelVisibilityMode="labeled"
                        app:itemHorizontalTranslationEnabled="false"
                        app:elevation="0dp"
                        app:menu="@menu/menu_navigation_center_fab"
                        app:theme="@style/Theme.MaterialComponents"/>

                    <!--For tab remove max dp
                    app:maxImageSize="@dimen/_40sdp"-->
                    <!-- Must share the same anchor as fab so magazine Share sits exactly on the + slot -->
                    <ImageView
                        android:id="@+id/imageVIewShareWhatsapp"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_gravity="center"
                        android:elevation="10dp"
                        android:visibility="gone"
                        app:layout_anchor="@+id/nav_view"
                        app:layout_anchorGravity="center" />

                    <!-- Magazine Share: tuck into the same 50dp nav slot (do not expand footer) -->
                    <LinearLayout
                        android:id="@+id/layoutMagazineShareFooter"
                        android:layout_width="wrap_content"
                        android:layout_height="50dp"
                        android:layout_gravity="center"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:elevation="12dp"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp"
                        android:visibility="gone"
                        app:layout_anchor="@+id/nav_view"
                        app:layout_anchorGravity="center">

                        <ImageView
                            android:id="@+id/ivMagazineShareFooter"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:contentDescription="@string/share"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_share_full" />

                        <TextView
                            android:id="@+id/tvMagazineShareFooter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:ellipsize="end"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:text="@string/share"
                            android:textAppearance="@style/BottomNavLabelInactive"
                            android:textColor="@color/selector_item_primary_color" />
                    </LinearLayout>

                    <!-- Product: center + / WhatsApp always off — start GONE; HomePage keeps it hidden. -->
                    <com.google.android.material.floatingactionbutton.FloatingActionButton
                        android:id="@+id/fab"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:contentDescription="@string/post_selection"
                        app:backgroundTint="@color/bottom_navigation_view_color"
                        app:elevation="0dp"
                        app:borderWidth="0dp"
                        app:fabCustomSize="42dp"
                        android:visibility="gone"
                        app:layout_anchor="@+id/nav_view"
                        app:layout_anchorGravity="center"
                        app:maxImageSize="30dp" />
                </androidx.coordinatorlayout.widget.CoordinatorLayout>


            </LinearLayout>

            <androidx.percentlayout.widget.PercentRelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/transparent">

                <include
                    android:id="@+id/comment_page"
                    layout="@layout/include_comments_page"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_alignParentBottom="true"
                    android:visibility="gone"
                    app:layout_heightPercent="100%" />

                <LinearLayout
                    android:id="@+id/linear_no_recyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="250dp"
                    android:gravity="center|center_horizontal"
                    android:orientation="vertical"

                    android:visibility="gone">

                    <ImageView
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        android:src="@drawable/nodata">

                    </ImageView>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ten"
                        android:text="No data"
                        android:textColor="@color/colorTextSecondary"
                        android:textSize="@dimen/fiveteen">

                    </TextView>
                </LinearLayout>

            </androidx.percentlayout.widget.PercentRelativeLayout>

            <!-- Top-left profile chip (default GONE — use bottom footer Profile tab). -->
            <FrameLayout
                android:id="@+id/layout_home_glass_header"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:layout_alignParentTop="true"
                android:layout_alignParentStart="true"
                android:background="@drawable/bg_home_glass_header"
                android:clickable="false"
                android:elevation="10dp"
                android:paddingStart="8dp"
                android:paddingEnd="12dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/btn_home_profile"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_glass_profile_icon"
                    android:contentDescription="@string/Profile"
                    android:padding="6dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_profile_glass" />
            </FrameLayout>

        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/no_internet"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <include layout="@layout/no_internet_scrren"> </include>

        </RelativeLayout>
    </LinearLayout>


    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>

