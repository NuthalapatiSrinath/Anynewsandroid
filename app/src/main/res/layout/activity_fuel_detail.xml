<?xml version="1.0" encoding="utf-8"?>
<!-- Fuel detail — match admin FuelPreview / Telugu mock (dark + orange). No alert block. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/fuel_detail_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF0A0A0A"
    android:fitsSystemWindows="false">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/fuel_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="32dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="12dp"
                android:paddingTop="10dp"
                android:paddingEnd="12dp"
                android:paddingBottom="4dp">

                <ImageView
                    android:id="@+id/fuel_back"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/cancel"
                    android:padding="8dp"
                    android:src="@drawable/ic_calendar_chevron_left"
                    android:tint="#FFFF6A1A" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingStart="40dp"
                    android:paddingEnd="40dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginEnd="6dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_fuel_pump"
                            android:tint="#FFFF6A1A" />

                        <TextView
                            android:id="@+id/fuel_top_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="@string/fuel_title_default"
                            android:textColor="#FFFF6A1A"
                            android:textSize="17sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/fuel_top_subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:textColor="#FFE2E8F0"
                        android:textSize="10sp"
                        tools:text="నేటి పెట్రోల్ &amp; డీజిల్ ధరలు" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/fuel_share"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/local_update_share"
                    android:padding="9dp"
                    android:src="@drawable/ic_baseline_share_24"
                    android:tint="#FFFF6A1A" />
            </RelativeLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:minHeight="210dp">

                    <ImageView
                        android:id="@+id/fuel_hero_image"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:adjustViewBounds="true"
                        android:minHeight="210dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/fuel_hero_station" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="#C708080A"
                        android:minHeight="210dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingTop="14dp">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentStart="true"
                                android:orientation="vertical">

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <ImageView
                                        android:layout_width="14dp"
                                        android:layout_height="14dp"
                                        android:layout_marginEnd="4dp"
                                        android:contentDescription="@null"
                                        android:src="@drawable/ic_fuel_pin"
                                        android:tint="#FFFFFFFF" />

                                    <TextView
                                        android:id="@+id/fuel_location"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:clickable="true"
                                        android:focusable="true"
                                        android:textColor="#FFFFFFFF"
                                        android:textSize="14sp"
                                        android:textStyle="bold"
                                        tools:text="ఆంధ్రప్రదేశ్" />
                                </LinearLayout>

                                <TextView
                                    android:id="@+id/fuel_region"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:clickable="true"
                                    android:focusable="true"
                                    android:paddingStart="18dp"
                                    android:textColor="#B3FFFFFF"
                                    android:textSize="10sp"
                                    android:visibility="gone"
                                    tools:text="ఆంధ్రప్రదేశ్" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:gravity="end"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/fuel_updated_caption"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textColor="#BFFFFFFF"
                                    android:textSize="9sp"
                                    tools:text="Last updated" />

                                <TextView
                                    android:id="@+id/fuel_updated"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textColor="#E6FFFFFF"
                                    android:textSize="9sp"
                                    android:textStyle="bold"
                                    tools:text="ఈరోజు 06:30 AM" />
                            </LinearLayout>
                        </RelativeLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:orientation="horizontal"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:weightSum="2">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="4dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_local_update_glass"
                                android:orientation="vertical"
                                android:padding="10dp">

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <ImageView
                                        android:layout_width="14dp"
                                        android:layout_height="14dp"
                                        android:layout_marginEnd="4dp"
                                        android:contentDescription="@null"
                                        android:src="@drawable/ic_fuel_pump"
                                        android:tint="#FF34D399" />

                                    <TextView
                                        android:id="@+id/fuel_petrol_caption"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:textColor="#FF34D399"
                                        android:textSize="11sp"
                                        android:textStyle="bold"
                                        tools:text="Petrol" />
                                </LinearLayout>

                                <TextView
                                    android:id="@+id/fuel_petrol_price"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:textColor="#FFFFFFFF"
                                    android:textSize="22sp"
                                    android:textStyle="bold"
                                    tools:text="₹104.20" />

                                <TextView
                                    android:id="@+id/fuel_petrol_change"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:textColor="#FF34D399"
                                    android:textSize="10sp"
                                    tools:text="▼ 0.15 / లీటర్" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_local_update_glass"
                                android:orientation="vertical"
                                android:padding="10dp">

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <ImageView
                                        android:layout_width="14dp"
                                        android:layout_height="14dp"
                                        android:layout_marginEnd="4dp"
                                        android:contentDescription="@null"
                                        android:src="@drawable/ic_fuel_pump"
                                        android:tint="#FF60A5FA" />

                                    <TextView
                                        android:id="@+id/fuel_diesel_caption"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:textColor="#FF60A5FA"
                                        android:textSize="11sp"
                                        android:textStyle="bold"
                                        tools:text="Diesel" />
                                </LinearLayout>

                                <TextView
                                    android:id="@+id/fuel_diesel_price"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:textColor="#FFFFFFFF"
                                    android:textSize="22sp"
                                    android:textStyle="bold"
                                    tools:text="₹92.80" />

                                <TextView
                                    android:id="@+id/fuel_diesel_change"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:textColor="#FF34D399"
                                    android:textSize="10sp"
                                    tools:text="▼ 0.12 / లీటర్" />
                            </LinearLayout>
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/fuel_banner_row"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:background="#FFFF6A1A"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="10dp"
                            android:paddingTop="8dp"
                            android:paddingEnd="10dp"
                            android:paddingBottom="8dp"
                            android:visibility="gone">

                            <ImageView
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:layout_marginEnd="6dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_ttd_megaphone"
                                android:tint="#FFFFFFFF" />

                            <TextView
                                android:id="@+id/fuel_banner"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:textColor="#FFFFFFFF"
                                android:textSize="9sp"
                                tools:text="ధరలు ప్రతిరోజూ ఉదయం 6 గంటలకు నవీకరించబడతాయి" />
                        </LinearLayout>
                    </LinearLayout>
                </FrameLayout>

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:layout_marginEnd="5dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_fuel_book"
                            android:tint="#FFFF6A1A" />

                        <TextView
                            android:id="@+id/fuel_cities_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#FFFFFFFF"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            tools:text="ప్రధాన నగరాల ధరలు" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/fuel_state_filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:background="@drawable/bg_fuel_state_chip"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingStart="8dp"
                        android:paddingTop="2dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="2dp"
                        android:textColor="#FFCBD5E1"
                        android:textSize="10sp"
                        tools:text="ఆంధ్రప్రదేశ్ ▾" />
                </RelativeLayout>

                <TextView
                    android:id="@+id/fuel_district_filter"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_fuel_state_chip"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingStart="10dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="8dp"
                    android:textColor="#FFFFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    tools:text="Hyderabad ▾" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_local_update_card"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingBottom="4dp">

                        <TextView
                            android:id="@+id/fuel_col_city"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.2"
                            android:textColor="#FF94A3B8"
                            android:textSize="9sp"
                            tools:text="City" />

                        <TextView
                            android:id="@+id/fuel_col_petrol"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingStart="4dp"
                            android:paddingEnd="4dp"
                            android:textColor="#FF34D399"
                            android:textSize="9sp"
                            tools:text="Petrol (₹/L)" />

                        <TextView
                            android:id="@+id/fuel_col_diesel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingStart="4dp"
                            android:paddingEnd="4dp"
                            android:textColor="#FF60A5FA"
                            android:textSize="9sp"
                            tools:text="Diesel (₹/L)" />

                        <TextView
                            android:id="@+id/fuel_col_change"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingStart="4dp"
                            android:textColor="#FF94A3B8"
                            android:textSize="9sp"
                            tools:text="Change" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/fuel_cities_list"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </LinearLayout>

                <TextView
                    android:id="@+id/fuel_cities_footnote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="#FF64748B"
                    android:textSize="9sp"
                    android:visibility="gone" />

                <!-- Promo — today's-rate chart removed; alert / Set Alert omitted -->
                <LinearLayout
                    android:id="@+id/fuel_promo_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_local_update_card"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:contentDescription="@null"
                        android:padding="6dp"
                        android:src="@drawable/ic_fuel_pump"
                        android:tint="#FFFF6A1A" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/fuel_promo_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="#FFFF6A1A"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            tools:text="ధరలు తగ్గాయి!" />

                        <TextView
                            android:id="@+id/fuel_promo_text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textColor="#FFCBD5E1"
                            android:textSize="10sp"
                            tools:text="ఈరోజు పెట్రోల్ &amp; డీజిల్ ధరలు తగ్గాయి." />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/fuel_promo_cta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_fuel_promo_cta"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingStart="8dp"
                        android:paddingTop="6dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="6dp"
                        android:textColor="#FFFF6A1A"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        tools:text="ఇతర నగరాలను చూడండి >" />
                </LinearLayout>

                <TextView
                    android:id="@+id/fuel_source"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:textColor="#FF64748B"
                    android:textSize="10sp"
                    android:visibility="gone"
                    tools:text="Source: thecore" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</FrameLayout>
