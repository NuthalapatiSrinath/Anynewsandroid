<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_color"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    tools:context=".Activities.RedeemPageActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="55dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="horizontal">


            <ImageView
                android:id="@+id/back_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/_20sdp"
                android:scaleType="fitXY"
                android:src="@drawable/ic_back_arrow" />

            <TextView
                android:id="@+id/username"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginLeft="@dimen/_10sdp"
                android:layout_marginRight="@dimen/fiveteen"
                android:gravity="left|center"
                android:text="Payment"
                android:textColor="@color/black"
                android:textSize="16dp"
                android:textStyle="normal" />


        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/_80sdp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.4"
            android:orientation="vertical">

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/payment"
                android:gravity="center"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="2"
                        android:gravity="center">

                        <ImageView

                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_marginTop="6dp"
                            android:layout_marginBottom="@dimen/six"
                            android:gravity="center"
                            android:src="@drawable/ic_money_icon" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="3"
                        android:gravity="left|center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/avilable_amount"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="3"
                            android:enabled="false"
                            android:gravity="left|bottom"
                            android:paddingLeft="5dp"
                            android:text="Available Amount "
                            android:textColor="@color/black"
                            android:textSize="@dimen/_10sdp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="5">

                            <TextView
                                android:id="@+id/total_amount"
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:enabled="false"
                                android:gravity="left"
                                android:paddingLeft="5dp"
                                android:text="909"
                                android:textColor="@color/payment_history_border_green"
                                android:textSize="@dimen/_14sdp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:enabled="false"
                                android:gravity="left|bottom"
                                android:paddingLeft="1dp"
                                android:text=".43 "
                                android:textColor="@color/payment_history_border_green"
                                android:textSize="@dimen/_8sdp"
                                android:visibility="gone" />
                        </LinearLayout>


                    </LinearLayout>


                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.4"
            android:orientation="vertical">

        </LinearLayout>


    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/_20sdp"
        android:orientation="vertical">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

      <!--      <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="0.05">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="@dimen/_10sdp"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:gravity="left|center"
                    android:text="Select Payment Method"
                    android:textSize="@dimen/_16sdp"
                    android:visibility="gone">

                </TextView>

            </LinearLayout>-->

            <LinearLayout
                android:layout_width="match_parent"

                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_30sdp"
                android:gravity="center">

                <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
                    xmlns:app="http://schemas.android.com/apk/res-auto"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_70sdp"
                    android:layout_marginLeft="@dimen/fiveteen"
                    android:layout_marginRight="@dimen/fiveteen"
                    android:background="@color/background_color">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/ic_paytm_background_icon"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="0.8"
                                android:gravity="left|center"
                                android:orientation="vertical">


                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="2"
                                android:gravity="center"
                                android:orientation="vertical">


                                <ImageView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:src="@drawable/ic_paytm_icon">

                                </ImageView>


                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="6"
                                android:gravity="center"
                                android:orientation="vertical">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:gravity="center"
                                    android:orientation="vertical">

                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="0dp"
                                        android:layout_weight="2"
                                        android:gravity="center"
                                        android:orientation="horizontal">

                                        <EditText
                                            android:id="@+id/enter_paytm_number"
                                            android:layout_width="match_parent"
                                            android:layout_height="match_parent"
                                            android:layout_marginLeft="@dimen/fiveteen"
                                            android:background="@null"
                                            android:gravity="center"
                                            android:hint="@string/edittext_enter_phone_number_redeem"
                                            android:inputType="textEmailAddress"
                                            android:maxLength="80"
                                            android:maxLines="1"
                                            android:paddingEnd="@dimen/ten"
                                            android:paddingRight="@dimen/ten"
                                            android:textColor="@color/warm_grey"
                                            android:textColorHint="@color/post_new_title_text_color"
                                            android:textSize="@dimen/_10sdp">

                                        </EditText>


                                    </LinearLayout>


                                </LinearLayout>


                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="2"
                                android:gravity="center"
                                android:orientation="vertical">


                                <RadioGroup
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:gravity="center"
                                    android:orientation="vertical">


                                </RadioGroup>

                            </LinearLayout>


                        </LinearLayout>

                    </LinearLayout>


                </LinearLayout>

            </LinearLayout>


            <LinearLayout
                android:id="@+id/pan_card_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_30sdp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="20dp"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/title_pan_card"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="bottom|center"
                        android:text="PAN Card"
                        android:textColor="@color/black"
                        android:textSize="@dimen/_12sdp">

                    </TextView>
                </LinearLayout>

                <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
                    xmlns:app="http://schemas.android.com/apk/res-auto"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_70sdp"
                    android:layout_marginLeft="@dimen/fiveteen"
                    android:layout_marginTop="@dimen/six"
                    android:layout_marginRight="@dimen/fiveteen"
                    android:background="@color/background_color">


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/ic_paytm_background_icon"
                        android:gravity="center"
                        android:orientation="horizontal">


                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="5"
                            android:gravity="center"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:orientation="vertical">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="0dp"
                                    android:layout_weight="2"
                                    android:gravity="center"
                                    android:orientation="horizontal">

                                    <EditText
                                        android:id="@+id/enter_pan_card_number"
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:layout_marginLeft="@dimen/fiveteen"
                                        android:background="@null"
                                        android:gravity="center"
                                        android:hint="@string/edittext_enter_pan_card"
                                        android:inputType="textCapCharacters"
                                        android:maxLength="80"
                                        android:maxLines="3"
                                        android:paddingEnd="@dimen/ten"
                                        android:paddingRight="@dimen/ten"
                                        android:textAllCaps="true"
                                        android:textColor="@color/warm_grey"
                                        android:textColorHint="@color/post_new_title_text_color"
                                        android:textSize="@dimen/_10sdp">

                                    </EditText>


                                </LinearLayout>


                            </LinearLayout>


                        </LinearLayout>


                    </LinearLayout>


                </LinearLayout>

            </LinearLayout>


        </LinearLayout>

        <LinearLayout
            android:layout_marginTop="@dimen/_50sdp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">


            <soup.neumorphism.NeumorphCardView
                android:id="@+id/user_name"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_70sdp"
                android:layout_below="@+id/basin_image_view"
                android:layout_marginLeft="@dimen/_20sdp"
                android:layout_marginTop="8dp"
                android:layout_marginRight="@dimen/_20sdp"
                android:scaleType="centerInside"
                app:layout_constraintEnd_toEndOf="parent"
                app:neumorph_shadowColorDark="@color/neomorph_shadow_color"
                app:neumorph_shadowColorLight="@color/neomorph_highlight_color"
                app:neumorph_shadowElevation="6dp"
                app:neumorph_shapeAppearance="@style/Login_ShapeAppearance"
                app:neumorph_shapeType="pressed"
                app:neumorph_strokeColor="@color/design_default_color_on_primary"
                app:neumorph_strokeWidth="0.01dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center">

                    <EditText
                        android:id="@+id/payment_enter_amount"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginLeft="@dimen/_20sdp"
                        android:background="@null"
                        android:gravity="center"
                        android:hint="@string/edittext_enter_amonut_hint"
                        android:inputType="number"
                        android:maxLength="80"
                        android:maxLines="3"
                        android:textAllCaps="true"
                        android:textColor="@color/warm_grey"
                        android:textColorHint="@color/post_new_title_text_color">

                    </EditText>
                </LinearLayout>


            </soup.neumorphism.NeumorphCardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Note :"
                    android:textColor="@color/red"
                    android:textStyle="bold">

                </TextView>

                <TextView
                    android:id="@+id/payment_charges_detailes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" Payment charges include 1.99% Tax + GST">

                </TextView>
            </LinearLayout>


            <LinearLayout
                android:id="@+id/redeem_send_button"
                android:layout_width="@dimen/_150sdp"
                android:layout_height="70dp"
                android:layout_below="@+id/basin_image_view"
                android:layout_marginTop="@dimen/ten"
                android:background="@drawable/ic_send_icon"
                android:gravity="center"
                android:scaleType="centerInside"
                android:visibility="visible"
                app:layout_constraintEnd_toEndOf="parent">


                <TextView
                    android:id="@+id/redeem_text"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="-4dp"
                    android:gravity="center"
                    android:paddingLeft="@dimen/_30sdp"
                    android:paddingRight="@dimen/_30sdp"
                    android:text="Redeem"
                    android:textAllCaps="false"
                    android:textColor="@color/on_brand_text"
                    android:textSize="@dimen/_15sdp"
                    android:textStyle="bold">

                </TextView>


            </LinearLayout>

            <LinearLayout
                android:id="@+id/redeem_send_progress"
                android:layout_width="@dimen/_130sdp"
                android:layout_height="70dp"
                android:layout_below="@+id/basin_image_view"
                android:layout_marginTop="@dimen/ten"
                android:background="@drawable/ic_send_icon"
                android:gravity="center"
                android:scaleType="centerInside"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_margin="@dimen/six"
                    android:gravity="center">

                    <ProgressBar
                        android:id="@+id/progressBarLarge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/ten"
                        android:indeterminateDrawable="@drawable/progress"
                        android:paddingLeft="@dimen/_25sdp"
                        android:paddingRight="@dimen/_25sdp"
                        android:visibility="visible"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintRight_toRightOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />
                </LinearLayout>


            </LinearLayout>
        </LinearLayout>



    </LinearLayout>


</LinearLayout>