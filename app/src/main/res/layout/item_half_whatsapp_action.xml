<?xml version="1.0" encoding="utf-8"?>
<!-- Inserted before Share on half articles so WhatsApp count matches full posts. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/half_whatsapp"
    android:layout_width="42dp"
    android:layout_height="42dp"
    android:layout_marginEnd="2dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:gravity="center">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false">

        <ImageView
            android:id="@+id/half_whatsapp_icon"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:layout_gravity="center"
            android:background="@drawable/white_oval"
            android:contentDescription="WhatsApp"
            android:padding="7dp"
            android:src="@drawable/ic_whatsapp_original1" />

        <TextView
            android:id="@+id/half_whatsapp_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="-3dp"
            android:layout_marginBottom="-3dp"
            android:elevation="4dp"
            android:fontFamily="@font/roboto_medium"
            android:gravity="center"
            android:minWidth="14dp"
            android:minHeight="14dp"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:textColor="@color/engagement_badge_text"
            android:textSize="9sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
