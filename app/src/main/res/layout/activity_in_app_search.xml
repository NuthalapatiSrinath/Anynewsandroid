<?xml version="1.0" encoding="utf-8"?>
<!-- Mist + teal-rail search chrome: circular back chip, pill field (not Way2, not orange strip). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/in_app_search_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_color"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <RelativeLayout
            android:id="@+id/search_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_search_chrome_header"
            android:elevation="3dp"
            android:paddingTop="10dp"
            android:paddingBottom="14dp">

            <LinearLayout
                android:id="@+id/search_back_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="4dp"
                android:paddingBottom="8dp">

                <FrameLayout
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_search_back_chip">

                    <ImageView
                        android:id="@+id/search_back"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/search_back"
                        app:srcCompat="@drawable/ic_search_chrome_back" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="@string/search_back"
                    android:textColor="@color/search_chrome_title"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.02" />
            </LinearLayout>

            <EditText
                android:id="@+id/search_input"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_below="@id/search_back_row"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="14dp"
                android:background="@drawable/rect_search_box_pill"
                android:drawableEnd="@drawable/ic_action_search"
                android:drawablePadding="8dp"
                android:hint="@string/search_stories_hint"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="@color/search_chrome_title"
                android:textColorHint="@color/search_chrome_muted"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/search_examples"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/search_input"
                android:layout_marginStart="18dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="18dp"
                android:text="@string/search_keyword_examples"
                android:textColor="@color/search_chrome_muted"
                android:textSize="12sp" />
        </RelativeLayout>

        <TextView
            android:id="@+id/search_no_results"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFF9C4"
            android:drawableStart="@android:drawable/ic_delete"
            android:drawablePadding="8dp"
            android:gravity="center_vertical"
            android:padding="12dp"
            android:text="@string/no_stories_found"
            android:textColor="#B71C1C"
            android:textStyle="bold"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/search_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="16dp" />
    </LinearLayout>
</FrameLayout>
