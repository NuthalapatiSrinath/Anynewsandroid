<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rewards_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/rewards_ink"
    android:fitsSystemWindows="false"
    tools:context=".rewards.RewardsHubActivity">

    <View
        android:layout_width="match_parent"
        android:layout_height="280dp"
        android:background="@drawable/bg_rewards_hub_top" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="40dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="8dp"
                android:paddingTop="6dp"
                android:paddingEnd="16dp"
                android:paddingBottom="6dp">

                <ImageView
                    android:id="@+id/rewards_back"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/cancel"
                    android:padding="8dp"
                    android:src="@drawable/ic_calendar_chevron_left"
                    android:tint="@color/rewards_gold" />

                <TextView
                    android:id="@+id/rewards_top_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_toEndOf="@id/rewards_back"
                    android:fontFamily="@font/sreekrushnadevaraya_regular"
                    android:letterSpacing="0.02"
                    android:paddingStart="2dp"
                    android:text="AnyNews Coins"
                    android:textColor="@color/rewards_cream"
                    android:textSize="22sp" />
            </RelativeLayout>

            <TextView
                android:id="@+id/rewards_period_banner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="18dp"
                android:background="@drawable/bg_rewards_card"
                android:paddingStart="14dp"
                android:paddingTop="12dp"
                android:paddingEnd="14dp"
                android:paddingBottom="12dp"
                android:textColor="@color/rewards_cream"
                android:textSize="14sp"
                android:visibility="gone" />

            <!-- 1. Hero balance -->
            <LinearLayout
                android:id="@+id/rewards_hero_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="18dp"
                android:background="@drawable/bg_rewards_hero"
                android:orientation="vertical"
                android:paddingStart="22dp"
                android:paddingTop="20dp"
                android:paddingEnd="18dp"
                android:paddingBottom="20dp">

                <TextView
                    android:id="@+id/rewards_hero_kicker"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.06"
                    android:text="@string/rewards_member_balance"
                    android:textAllCaps="true"
                    android:textColor="@color/rewards_gold"
                    android:textSize="11sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/rewards_coins"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/sreekrushnadevaraya_regular"
                            android:includeFontPadding="false"
                            android:text="0"
                            android:textColor="@color/rewards_gold_bright"
                            android:textSize="64sp" />

                        <TextView
                            android:id="@+id/rewards_coins_caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:letterSpacing="0.08"
                            android:text="coins this week"
                            android:textColor="@color/rewards_cream_muted"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:layout_marginStart="8dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_rewards_crest" />
                </LinearLayout>

                <TextView
                    android:id="@+id/rewards_redeemed_line"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/rewards_cream_muted"
                    android:textSize="12sp"
                    android:visibility="gone"
                    tools:text="(48 redeemed this week)"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/rewards_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:textColor="@color/rewards_cream"
                    android:textSize="14sp"
                    tools:text="Read and earn coins" />

                <TextView
                    android:id="@+id/rewards_rank"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Rank —"
                    android:textColor="@color/rewards_gold"
                    android:textSize="14sp" />

                <!-- Hidden: conversion rate lives on Wallet only -->
                <TextView
                    android:id="@+id/rewards_rate"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/rewards_week"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:letterSpacing="0.06"
                    android:textColor="@color/rewards_cream_muted"
                    android:textSize="12sp"
                    tools:text="7–13 Sep" />
            </LinearLayout>

            <TextView
                android:id="@+id/rewards_join_btn"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginStart="18dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="18dp"
                android:background="@drawable/bg_rewards_btn_primary"
                android:gravity="center"
                android:letterSpacing="0.04"
                android:text="Join Rewards"
                android:textColor="@color/rewards_ink_text"
                android:textSize="15sp"
                android:visibility="gone" />

            <!-- 2. Primary earn — gold-outlined, not an orange button pile -->
            <LinearLayout
                android:id="@+id/rewards_watch_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="18dp"
                android:background="@drawable/bg_rewards_earn_panel"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="16dp"
                android:paddingEnd="18dp"
                android:paddingBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="7dp"
                        android:layout_height="7dp"
                        android:background="@drawable/bg_rewards_garnet_pip" />

                    <TextView
                        android:id="@+id/rewards_watch_kicker"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:letterSpacing="0.06"
                        android:text="@string/rewards_primary_earn"
                        android:textAllCaps="true"
                        android:textColor="@color/rewards_gold"
                        android:textSize="11sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/rewards_watch_ads_btn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@android:color/transparent"
                    android:fontFamily="@font/sreekrushnadevaraya_regular"
                    android:gravity="start|center_vertical"
                    android:minHeight="36dp"
                    android:text="Watch ads"
                    android:textColor="@color/rewards_gold_bright"
                    android:textSize="20sp" />
            </LinearLayout>

            <!-- 3. Secondary earn as a refined list -->
            <LinearLayout
                android:id="@+id/rewards_earn_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:layout_marginTop="18dp"
                android:layout_marginEnd="18dp"
                android:background="@drawable/bg_rewards_card"
                android:orientation="vertical"
                android:paddingTop="14dp"
                android:paddingBottom="6dp">

                <TextView
                    android:id="@+id/rewards_earn_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.04"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="6dp"
                    android:text="@string/rewards_also_earn"
                    android:textAllCaps="true"
                    android:textColor="@color/rewards_gold"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/rewards_checkin_btn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:minHeight="56dp"
                    android:paddingStart="20dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="12dp"
                    android:text="Daily check-in"
                    android:textColor="@color/rewards_cream"
                    android:textSize="15sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp"
                    android:background="@color/rewards_hairline" />

                <TextView
                    android:id="@+id/rewards_rating_btn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:minHeight="56dp"
                    android:paddingStart="20dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="12dp"
                    android:text="Play Store 5★ + screenshot"
                    android:textColor="@color/rewards_cream"
                    android:textSize="15sp" />
            </LinearLayout>

            <!-- Leaderboard -->
            <TextView
                android:id="@+id/rewards_leaderboard_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="22dp"
                android:layout_marginTop="26dp"
                android:layout_marginEnd="18dp"
                android:letterSpacing="0.04"
                android:text="Leaderboard"
                android:textAllCaps="true"
                android:textColor="@color/rewards_gold"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/rewards_leaderboard_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="22dp"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="18dp"
                android:text=""
                android:textColor="@color/rewards_cream_muted"
                android:textSize="12sp" />

            <LinearLayout
                android:id="@+id/rewards_leaderboard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="18dp"
                android:animateLayoutChanges="true"
                android:background="@drawable/bg_rewards_card"
                android:orientation="vertical"
                android:paddingTop="4dp"
                android:paddingBottom="4dp" />

            <!-- 4. History and rules as quiet text links -->
            <LinearLayout
                android:id="@+id/rewards_history_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:layout_marginTop="22dp"
                android:layout_marginEnd="18dp"
                android:background="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="4dp"
                android:paddingTop="8dp"
                android:paddingEnd="4dp"
                android:paddingBottom="8dp">

                <TextView
                    android:id="@+id/rewards_history_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.12"
                    android:text="History"
                    android:textColor="@color/rewards_cream_muted"
                    android:textSize="14sp" />

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="2dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_rewards_chevron" />
            </LinearLayout>

            <!-- Kept for code bind compatibility; not shown on hub -->
            <TextView
                android:id="@+id/rewards_history_hint"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/rewards_history"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:orientation="vertical"
                android:visibility="gone" />

            <TextView
                android:id="@+id/rewards_rules"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="22dp"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="22dp"
                android:lineSpacingExtra="3dp"
                android:textColor="@color/rewards_cream_muted"
                android:textSize="12sp"
                tools:text="Rules summary" />

            <TextView
                android:id="@+id/rewards_go_wallet_btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="18dp"
                android:background="?attr/selectableItemBackground"
                android:letterSpacing="0.08"
                android:paddingStart="4dp"
                android:paddingTop="8dp"
                android:paddingEnd="8dp"
                android:paddingBottom="8dp"
                android:text="Go to Wallet"
                android:textColor="@color/rewards_gold"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/rewards_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="24dp"
                android:text="Loading…"
                android:textColor="@color/rewards_cream_muted"
                android:visibility="gone" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</FrameLayout>
