<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rewards_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFBF7"
    android:fitsSystemWindows="false"
    tools:context=".rewards.RewardsHubActivity">

    <View
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:background="@drawable/bg_rewards_hub_top" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="36dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="10dp"
                android:paddingTop="8dp"
                android:paddingEnd="10dp"
                android:paddingBottom="4dp">

                <ImageView
                    android:id="@+id/rewards_back"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/cancel"
                    android:padding="8dp"
                    android:src="@drawable/ic_calendar_chevron_left"
                    android:tint="#FF1C1917" />

                <TextView
                    android:id="@+id/rewards_top_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_toEndOf="@id/rewards_back"
                    android:fontFamily="@font/sreekrushnadevaraya_regular"
                    android:paddingStart="2dp"
                    android:text="AnyNews Coins"
                    android:textColor="#FF1C1917"
                    android:textSize="22sp"
                    android:textStyle="bold" />
            </RelativeLayout>

            <!-- Hero balance -->
            <LinearLayout
                android:id="@+id/rewards_hero_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="14dp"
                android:background="@drawable/bg_rewards_hero"
                android:elevation="2dp"
                android:orientation="vertical"
                android:paddingStart="18dp"
                android:paddingTop="14dp"
                android:paddingEnd="18dp"
                android:paddingBottom="14dp">

                <TextView
                    android:id="@+id/rewards_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.01"
                    android:textColor="#FF9A3412"
                    android:textSize="13sp"
                    tools:text="Read and earn coins" />

                <TextView
                    android:id="@+id/rewards_coins"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/sreekrushnadevaraya_regular"
                    android:includeFontPadding="false"
                    android:text="0"
                    android:textColor="#FFEA580C"
                    android:textSize="48sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/rewards_redeemed_line"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FFA8A29E"
                    android:textSize="12sp"
                    android:visibility="gone"
                    tools:text="(48 redeemed this week)"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/rewards_coins_caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="coins this week"
                    android:textColor="#FF78716C"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/rewards_rank"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Rank —"
                    android:textColor="#FF44403C"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- Hidden: conversion rate lives on Wallet only -->
                <TextView
                    android:id="@+id/rewards_rate"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/rewards_week"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="#FFA8A29E"
                    android:textSize="12sp"
                    tools:text="7–13 Sep" />
            </LinearLayout>

            <TextView
                android:id="@+id/rewards_join_btn"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginStart="14dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="14dp"
                android:background="@drawable/bg_rewards_btn_primary"
                android:gravity="center"
                android:text="Join Rewards"
                android:textColor="#FFFFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- Earn more -->
            <LinearLayout
                android:id="@+id/rewards_earn_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginTop="14dp"
                android:layout_marginEnd="14dp"
                android:background="@drawable/bg_rewards_card"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:id="@+id/rewards_earn_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Earn more"
                    android:textColor="#FF1C1917"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/rewards_checkin_btn"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_rewards_btn_secondary"
                    android:gravity="center"
                    android:text="Daily check-in"
                    android:textColor="#FFEA580C"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/rewards_watch_ads_btn"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_rewards_btn_secondary"
                    android:gravity="center"
                    android:text="Watch ads"
                    android:textColor="#FFEA580C"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/rewards_rating_btn"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_rewards_btn_secondary"
                    android:gravity="center"
                    android:text="Play Store 5★ + screenshot"
                    android:textColor="#FFEA580C"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Leaderboard -->
            <TextView
                android:id="@+id/rewards_leaderboard_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:layout_marginTop="18dp"
                android:layout_marginEnd="18dp"
                android:text="Leaderboard"
                android:textColor="#FF1C1917"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/rewards_leaderboard_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:layout_marginTop="2dp"
                android:layout_marginEnd="18dp"
                android:text=""
                android:textColor="#FFA8A29E"
                android:textSize="12sp" />

            <LinearLayout
                android:id="@+id/rewards_leaderboard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="14dp"
                android:animateLayoutChanges="true"
                android:background="@drawable/bg_rewards_card"
                android:orientation="vertical"
                android:paddingTop="4dp"
                android:paddingBottom="4dp" />

            <!-- History row → separate activity -->
            <LinearLayout
                android:id="@+id/rewards_history_row"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginStart="14dp"
                android:layout_marginTop="14dp"
                android:layout_marginEnd="14dp"
                android:background="@drawable/bg_rewards_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="12dp">

                <TextView
                    android:id="@+id/rewards_history_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="History"
                    android:textColor="#FF1C1917"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:rotation="180"
                    android:src="@drawable/ic_calendar_chevron_left"
                    android:tint="#FFA8A29E" />
            </LinearLayout>

            <!-- Kept for code bind compatibility; not shown on hub -->
            <TextView
                android:id="@+id/rewards_history_hint"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/rewards_history"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:orientation="vertical"
                android:visibility="gone" />

            <TextView
                android:id="@+id/rewards_rules"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="18dp"
                android:textColor="#FF78716C"
                android:textSize="12sp"
                tools:text="Rules summary" />

            <TextView
                android:id="@+id/rewards_go_wallet_btn"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginStart="14dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="14dp"
                android:background="@drawable/bg_rewards_btn_secondary"
                android:gravity="center"
                android:text="Go to Wallet"
                android:textColor="#FFEA580C"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/rewards_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="24dp"
                android:text="Loading…"
                android:textColor="#FFA8A29E"
                android:visibility="gone" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</FrameLayout>
