<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rewards_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF8F4EC"
    android:fitsSystemWindows="false"
    tools:context=".rewards.RewardsHubActivity">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="32dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="14dp"
                android:paddingTop="10dp"
                android:paddingEnd="10dp"
                android:paddingBottom="8dp">

                <ImageView
                    android:id="@+id/rewards_back"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/cancel"
                    android:padding="8dp"
                    android:src="@drawable/ic_calendar_chevron_left"
                    android:tint="#FF1C1917" />

                <TextView
                    android:id="@+id/rewards_top_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_toEndOf="@id/rewards_back"
                    android:fontFamily="@font/sreekrushnadevaraya_regular"
                    android:paddingStart="4dp"
                    android:text="AnyNews Coins"
                    android:textColor="#FF1C1917"
                    android:textSize="22sp"
                    android:textStyle="bold" />
            </RelativeLayout>

            <!-- (1) Summary / coins -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="14dp"
                android:background="@drawable/bg_rewards_hero"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:id="@+id/rewards_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#FF78716C"
                    android:textSize="13sp"
                    tools:text="Earn coins by reading" />

                <TextView
                    android:id="@+id/rewards_coins"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="@font/sreekrushnadevaraya_regular"
                    android:text="0"
                    android:textColor="#FFB45309"
                    android:textSize="42sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/rewards_coins_caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="coins this week"
                    android:textColor="#FFA8A29E"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/rewards_rank"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Rank —"
                        android:textColor="#FF44403C"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/rewards_rate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="100 coins = ₹1"
                        android:textColor="#FF78716C"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/rewards_week"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="#FFA8A29E"
                    android:textSize="12sp"
                    tools:text="Week W2026-09-01 · open" />
            </LinearLayout>

            <TextView
                android:id="@+id/rewards_join_btn"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginStart="14dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="14dp"
                android:background="@drawable/bg_rewards_btn_primary"
                android:gravity="center"
                android:text="Join Rewards"
                android:textColor="#FFFFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- (2) Earn more -->
            <LinearLayout
                android:id="@+id/rewards_earn_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginTop="14dp"
                android:layout_marginEnd="14dp"
                android:background="@drawable/bg_rewards_card"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:id="@+id/rewards_earn_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Earn more"
                    android:textColor="#FF1C1917"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/rewards_checkin_btn"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_rewards_btn_secondary"
                    android:gravity="center"
                    android:text="Daily check-in"
                    android:textColor="#FFB45309"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/rewards_watch_ads_btn"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_rewards_btn_secondary"
                    android:gravity="center"
                    android:text="Watch ads"
                    android:textColor="#FFB45309"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/rewards_rating_btn"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_rewards_btn_secondary"
                    android:gravity="center"
                    android:text="Play Store 5★ + screenshot"
                    android:textColor="#FFB45309"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- (3) Leaderboard -->
            <TextView
                android:id="@+id/rewards_leaderboard_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:layout_marginTop="18dp"
                android:layout_marginEnd="18dp"
                android:text="Leaderboard"
                android:textColor="#FF1C1917"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/rewards_leaderboard_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:layout_marginTop="2dp"
                android:layout_marginEnd="18dp"
                android:text="Coins &amp; rank only — never rupees"
                android:textColor="#FFA8A29E"
                android:textSize="12sp" />

            <LinearLayout
                android:id="@+id/rewards_leaderboard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="14dp"
                android:background="@drawable/bg_rewards_card"
                android:orientation="vertical"
                android:paddingTop="4dp"
                android:paddingBottom="4dp" />

            <!-- History -->
            <TextView
                android:id="@+id/rewards_history_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:layout_marginTop="18dp"
                android:layout_marginEnd="18dp"
                android:text="History"
                android:textColor="#FF1C1917"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/rewards_history"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="14dp"
                android:background="@drawable/bg_rewards_card"
                android:orientation="vertical"
                android:padding="8dp" />

            <TextView
                android:id="@+id/rewards_rules"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="18dp"
                android:textColor="#FF78716C"
                android:textSize="12sp"
                tools:text="Rules summary" />

            <!-- (4) Rewards wallet at bottom -->
            <LinearLayout
                android:id="@+id/rewards_wallet_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="14dp"
                android:background="@drawable/bg_rewards_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/rewards_wallet_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Rewards wallet"
                    android:textColor="#FF78716C"
                    android:textSize="12sp"
                    android:textAllCaps="true" />

                <TextView
                    android:id="@+id/rewards_wallet"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="₹0"
                    android:textColor="#FF1C1917"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/rewards_withdraw_eta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Credit usually takes 24–48 hours."
                    android:textColor="#FFA8A29E"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/rewards_upi"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_rewards_input"
                    android:hint="yourname@upi"
                    android:inputType="textEmailAddress"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textColor="#FF1C1917"
                    android:textColorHint="#FFA8A29E"
                    android:textSize="14sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/rewards_save_upi"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_rewards_btn_secondary"
                        android:gravity="center"
                        android:text="Save UPI"
                        android:textColor="#FF44403C"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <Space
                        android:layout_width="10dp"
                        android:layout_height="1dp" />

                    <TextView
                        android:id="@+id/rewards_withdraw_btn"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_rewards_btn_primary"
                        android:gravity="center"
                        android:text="Withdraw"
                        android:textColor="#FFFFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <EditText
                    android:id="@+id/rewards_withdraw_amount"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_rewards_input"
                    android:hint="Amount ₹"
                    android:inputType="numberDecimal"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textColor="#FF1C1917"
                    android:textColorHint="#FFA8A29E"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/rewards_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="24dp"
                android:text="Loading…"
                android:textColor="#FFA8A29E"
                android:visibility="gone" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</FrameLayout>
