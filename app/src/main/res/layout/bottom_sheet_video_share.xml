<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet_rounded"
    android:orientation="vertical"
    android:paddingBottom="@dimen/twenty">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/ten"
        android:layout_marginBottom="@dimen/eight"
        android:background="@drawable/bg_bottom_sheet_handle" />

    <TextView
        android:id="@+id/share_sheet_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/twenty"
        android:paddingEnd="@dimen/twenty"
        android:paddingBottom="@dimen/twelve"
        android:text="@string/share"
        android:textColor="@color/title_color"
        android:textSize="18sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="@dimen/twelve"
        android:paddingEnd="@dimen/twelve"
        android:paddingBottom="@dimen/twelve">

        <LinearLayout
            android:id="@+id/option_whatsapp_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/eight"
            android:layout_weight="1"
            android:background="@drawable/bg_share_option_card"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/twelve">

            <FrameLayout
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_whatsapp_icon_circle">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/share_whatsapp_status"
                    android:src="@drawable/ic_whatsapp_status_share" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/eight"
                android:gravity="center"
                android:text="@string/share_whatsapp_status"
                android:textColor="@color/black"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center"
                android:text="@string/share_whatsapp_status_subtitle"
                android:textColor="@color/warm_grey_two"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/option_whatsapp_chat"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/eight"
            android:layout_weight="1"
            android:background="@drawable/bg_share_option_card"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/twelve">

            <FrameLayout
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_whatsapp_icon_circle">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/share_whatsapp_chat"
                    android:src="@drawable/ic_whatsapp_chat_share" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/eight"
                android:gravity="center"
                android:text="@string/share_whatsapp_chat"
                android:textColor="@color/black"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center"
                android:text="@string/share_whatsapp_chat_subtitle"
                android:textColor="@color/warm_grey_two"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="@dimen/twenty"
        android:layout_marginEnd="@dimen/twenty"
        android:background="@color/anynews_outline" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/twenty"
        android:paddingTop="@dimen/twelve"
        android:paddingEnd="@dimen/twenty"
        android:paddingBottom="@dimen/eight"
        android:text="@string/share_more_options"
        android:textAllCaps="true"
        android:textColor="@color/warm_grey_two"
        android:textSize="11sp"
        android:letterSpacing="0.05" />

    <LinearLayout
        android:id="@+id/option_share_article"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/twenty"
        android:paddingTop="@dimen/twelve"
        android:paddingEnd="@dimen/twenty"
        android:paddingBottom="@dimen/twelve">

        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_share_secondary_icon">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="@string/share_article_link"
                android:src="@drawable/ic_share_article_option"
                app:tint="@color/post_profile_red" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/twelve"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/share_article_link"
                android:textColor="@color/black"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/share_article_subtitle"
                android:textColor="@color/warm_grey_two"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/option_other_apps"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/twenty"
        android:paddingTop="@dimen/twelve"
        android:paddingEnd="@dimen/twenty"
        android:paddingBottom="@dimen/twelve">

        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_share_secondary_icon">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="@string/share_other_apps"
                android:src="@drawable/ic_baseline_share_24"
                app:tint="@color/default_color" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/twelve"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/share_other_apps"
                android:textColor="@color/black"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/share_other_apps_subtitle"
                android:textColor="@color/warm_grey_two"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
