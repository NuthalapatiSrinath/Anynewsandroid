<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:id="@+id/parent_layout"
    android:keepScreenOn="true">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <RelativeLayout
            android:id="@+id/layoutYoutubeFullView"
            android:layout_width="match_parent"
            android:layout_height="match_parent">


            <com.pierfrancescosoffritti.androidyoutubeplayer.core.player.views.YouTubePlayerView
                android:id="@+id/youtube_full_video"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="visible"
                app:enableAutomaticInitialization="false"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent">

                <ImageView
                    android:id="@+id/btnMute"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start|bottom"
                    android:layout_marginStart="8sp"
                    android:layout_marginBottom="25sp"
                    android:visibility="gone"
                    app:srcCompat="@drawable/ic__volume_up" />

            </com.pierfrancescosoffritti.androidyoutubeplayer.core.player.views.YouTubePlayerView>


            <ImageView
                android:id="@+id/imageViewItem1"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_centerInParent="true"
                android:adjustViewBounds="true"
                android:scaleType="fitXY" />

            <ImageView
                android:id="@+id/imageViewPlayVideo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:visibility="visible"
                android:src="@drawable/ic_video_play"
                android:layout_centerInParent="true"
                android:focusable="true" />



            <LinearLayout

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:gravity="center_horizontal"
                android:orientation="vertical">


                <LinearLayout
                    android:id="@+id/video_side_menu"
                    android:layout_width="60dp"
                    android:layout_height="@dimen/_280sdp"
                    android:layout_alignParentRight="true"
                    android:layout_marginTop="140dp"
                    android:layout_marginRight="10dp"
                    android:background="@drawable/transparent_strip"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">


                    <RelativeLayout
                        android:layout_width="40dp"
                        android:layout_height="50dp"
                        android:layout_marginBottom="20dp">

                        <de.hdodenhof.circleimageview.CircleImageView
                            android:id="@+id/user_pic"
                            android:layout_width="50dp"
                            android:layout_height="50dp"
                            android:scaleType="centerCrop"
                            app:civ_border_color="#FFFFFF"
                            app:civ_border_overlay="false"
                            app:civ_border_width="2dp" />

                        <ImageView
                            android:id="@+id/full_video_varified_btn"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_alignParentEnd="true"
                            android:layout_alignParentBottom="true"
                            android:layout_marginRight="10dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_add_profile_icon" />

                    </RelativeLayout>

                    <LinearLayout
                        android:id="@+id/like_for_video"
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:gravity="center"
                        android:orientation="vertical">


                        <ImageView
                            android:id="@+id/like_for_video_image"
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:src="@drawable/ic_like_half1" />

                        <TextView
                            android:id="@+id/full_video_like_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/five"
                            android:text="like"
                            android:textColor="@color/full_gallery_text_color"
                            android:textSize="8dp"
                            android:textStyle="bold" />

                    </LinearLayout>
                    <LinearLayout

                        android:id="@+id/comment_for_video"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="15dp"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <ImageView
                            android:id="@+id/iv_comment_for_video"
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:scaleType="fitCenter"/>

                        <TextView
                            android:id="@+id/full_video_comment_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/five"
                            android:text="Comment"
                            android:textColor="@color/full_gallery_text_color"
                            android:textSize="8dp"
                            android:textStyle="bold" />
                    </LinearLayout>


                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/full_icon_download" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/five"
                            android:text="Download"
                            android:textColor="@color/full_gallery_text_color"
                            android:textSize="9dp"
                            android:textStyle="bold" />

                    </LinearLayout>


                    <LinearLayout
                        android:id="@+id/dislike_for_video"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="15dp"
                        android:visibility="gone"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <ImageView
                            android:id="@+id/dislike_for_video_image"
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_new_dislike_icon" />

                        <TextView

                            android:id="@+id/full_video_dislike_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/five"
                            android:textColor="@color/full_gallery_text_color"
                            android:textSize="8dp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/full_image_whatsapp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:visibility="gone"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <ImageView
                            android:id="@+id/full_image_whatsapp_bg"
                            android:layout_width="25dp"
                            android:layout_height="25dp"
                            android:scaleType="fitCenter" />

                        <TextView
                            android:id="@+id/full_img_whtsapp_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/five"
                            android:text="WhatsApp"
                            android:textColor="@color/full_gallery_text_color"
                            android:textSize="9dp"
                            android:textStyle="bold" />
                    </LinearLayout>



                    <LinearLayout

                        android:id="@+id/share_for_video"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:layout_marginTop="@dimen/_10sdp"
                        android:orientation="vertical">

                        <ImageView
                            android:id="@+id/iv_share_for_video"
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_share_full" />

                        <TextView
                            android:id="@+id/full_video_share_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/five"
                            android:text="Share"
                            android:textColor="@color/full_gallery_text_color"
                            android:textSize="8dp"
                            android:textStyle="bold" />
                    </LinearLayout>



                </LinearLayout>


            </LinearLayout>

            <include layout="@layout/share_download_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"/>

        </RelativeLayout>

    </androidx.cardview.widget.CardView>


</RelativeLayout>