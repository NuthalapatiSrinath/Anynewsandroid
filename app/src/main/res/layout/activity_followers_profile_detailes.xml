<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/whitewithblack"
    android:fitsSystemWindows="true"
    tools:context=".Activities.FollowersProfileDetailes">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/_40sdp"
        android:background="@color/whitewithblack"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/fiveteen"
            android:scaleType="fitXY"
            android:src="@drawable/ic_back_arrow" />

        <TextView
            android:id="@+id/username"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="@dimen/_10sdp"
            android:layout_marginRight="@dimen/fiveteen"
            android:gravity="left|center"
            android:text="Payment"
            android:textColor="@color/title_color"
            android:textSize="16dp"
            android:textStyle="normal"
            android:visibility="invisible" />
    </LinearLayout>

    <TextView
        android:id="@+id/discover"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_40sdp"
        android:gravity="center"
        android:text="Discover"
        android:textColor="@color/title_color"
        android:textSize="@dimen/_16sdp"
        android:textStyle="bold" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/follower_profile_post"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/linear_no_recyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:src="@drawable/nodata" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ten"
                android:text="No data"
                android:textColor="#666666"
                android:textSize="@dimen/fiveteen" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/follow_layout_with_out_data"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center">

            <include layout="@layout/layout_loading" />
        </LinearLayout>
    </FrameLayout>

</LinearLayout>
