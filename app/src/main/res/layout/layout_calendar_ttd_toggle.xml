<?xml version="1.0" encoding="utf-8"?>
<!-- Panchangam | Raasi top chrome — retired on HomePage (separate DU tiles).
     Layout kept for standalone TeluguCalendarActivity only. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/calendar_ttd_toggle_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#99000000"
    android:clickable="true"
    android:elevation="48dp"
    android:focusable="true"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:visibility="visible">

    <FrameLayout
        android:id="@+id/calendar_ttd_pill"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_home_mode_pill"
        android:paddingStart="4dp"
        android:paddingTop="3dp"
        android:paddingEnd="4dp"
        android:paddingBottom="3dp">

        <View
            android:id="@+id/calendar_ttd_thumb"
            android:layout_width="110dp"
            android:layout_height="match_parent"
            android:layout_gravity="start|center_vertical"
            android:background="@drawable/bg_home_mode_seg_selected" />

        <LinearLayout
            android:id="@+id/calendar_ttd_segments"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/calendar_seg_calendar"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:minWidth="110dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="@string/calendar_seg_panchangam"
                android:textColor="#FFFFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/calendar_seg_ttd"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:minWidth="110dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="@string/calendar_seg_raasi_phalalu"
                android:textColor="#FFFFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
