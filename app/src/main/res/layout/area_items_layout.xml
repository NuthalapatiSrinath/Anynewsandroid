<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/background_color">

    <com.anyNews.anynews.Ui.NeomorphFrameLayout
        android:id="@+id/neomorphFrameLayout"
        android:layout_width="match_parent"
        android:layout_height="85dp"
        app:neomorph_shadow_type="outer"
        app:neomorph_layer_type="hardware"
        app:neomorph_background_color="@color/chip_background"
        app:neomorph_corner_radius="@dimen/neomorph_view_corner_radius"
        app:neomorph_elevation="@dimen/neomorph_view_elevation"
        app:neomorph_view_type="rectangular"
        app:neomorph_shadow_color="#D0D2D5"
        app:neomorph_highlight_color="@color/neomorph_highlight_color"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:id="@+id/language_name"
            android:text="one"
            android:gravity="center"
            android:layout_margin="@dimen/_3sdp"
            android:textColor="@color/chip_text_color"
            android:background="@color/chip_background"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
        </TextView>
    </com.anyNews.anynews.Ui.NeomorphFrameLayout>
    <com.anyNews.anynews.Ui.NeomorphFrameLayout
        android:id="@+id/second_neomorphFrameLayout"
        android:layout_width="match_parent"
        android:layout_height="85dp"
        android:visibility="gone"
        app:neomorph_shadow_type="outer"
        app:neomorph_layer_type="hardware"
        app:neomorph_background_color="@color/brand_orange"
        app:neomorph_corner_radius="@dimen/neomorph_view_corner_radius"
        app:neomorph_elevation="@dimen/neomorph_view_elevation"
        app:neomorph_view_type="rectangular"
        app:neomorph_shadow_color="#16EF4923"
        app:neomorph_highlight_color="#ffffff"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:id="@+id/second_language_name"
            android:text="one"
            android:layout_margin="3dp"
            android:gravity="center"
            android:textColor="@color/white"
            android:background="@color/brand_orange"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
        </TextView>
    </com.anyNews.anynews.Ui.NeomorphFrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
