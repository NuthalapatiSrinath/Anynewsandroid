<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@null">

    <LinearLayout
        android:id="@+id/parent_layout"
        android:layout_width="match_parent"
        android:orientation="vertical"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:orientation="vertical"
            android:layout_weight="3">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/_40sdp"
                android:orientation="horizontal"
                android:gravity="left|center">

                <ImageView
                    android:id="@+id/back_button"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_close_icon"
                    android:layout_marginLeft="30dp"
                    android:scaleType="fitXY" />

            </LinearLayout>


            <com.goibibo.libs.views.ScratchScrollView
                xmlns:android="http://schemas.android.com/apk/res/android"
                xmlns:app="http://schemas.android.com/apk/res-auto"
                xmlns:tools="http://schemas.android.com/tools"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true">



                <RelativeLayout

                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:gravity="center"
                    tools:context=".RelativeLayoutScratchActivity">

                    <!--CardView added ony for round edges-->

                    <androidx.cardview.widget.CardView
                        android:layout_width="250dp"
                        android:layout_height="250dp"
                        android:layout_gravity="center"
                        android:clipChildren="true"
                        android:gravity="center"
                        app:cardCornerRadius="20dp"
                        tools:context=".RelativeLayoutScratchActivity">

                        <com.goibibo.libs.views.ScratchRelativeLayoutView
                            android:id="@+id/scratch_card"
                            android:layout_width="250dp"
                            android:layout_height="250dp"
                            android:layout_centerInParent="true"
                            android:background="@android:color/white">

                            <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_gravity="center"
                                android:background="@color/form_surface_elevated"
                                android:gravity="center"
                                android:orientation="vertical"
                                >

                                <ImageView
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:scaleType="fitXY"
                                    android:src="@drawable/ic_locked_offer_scratch_card_icon"
                                    />

                                <LinearLayout
                                    android:orientation="vertical"
                                    android:layout_marginTop="-100dp"
                                    android:gravity="center"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content">
                                    <TextView

                                        android:layout_marginTop="@dimen/_4sdp"
                                        android:id="@+id/offer_amount_rupess"
                                        android:text=" Will Be Available on "
                                        android:gravity="center"
                                        android:textColor="#E2323542"
                                        android:textStyle="bold"
                                        android:textSize="@dimen/_14sdp"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content">

                                    </TextView>

                                    <TextView
                                        android:id="@+id/locked_scartch_card_value"
                                        android:textColor="#E2323542"
                                        android:text="  "
                                        android:textStyle="bold"
                                        android:gravity="center"
                                        android:textSize="@dimen/_14sdp"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content">

                                    </TextView>
                                </LinearLayout>

                            </LinearLayout>

                        </com.goibibo.libs.views.ScratchRelativeLayoutView>

                    </androidx.cardview.widget.CardView>




                </RelativeLayout>

            </com.goibibo.libs.views.ScratchScrollView>

        </LinearLayout>

        <LinearLayout
            android:layout_marginTop="-30dp"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:orientation="vertical"
            android:layout_weight="1">

            <TextView
                android:layout_marginTop="@dimen/_10sdp"
                android:text=""
                android:textSize="@dimen/_15sdp"
                android:gravity="center"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

            </TextView>
            <TextView
                android:id="@+id/after_revel_scartch_card"
                android:text=""
                android:textSize="@dimen/_15sdp"
                android:gravity="center"
                android:textStyle="bold"
                android:textColor="@color/on_brand_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

            </TextView>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_weight="2">




            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/btn_upload"
                android:layout_width="@dimen/_120sdp"
                android:layout_height="@dimen/_37sdp">


                <LinearLayout
                    android:id="@+id/scratch_card_refer"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:background="@drawable/ic_button_icon"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/logintext"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="8"
                        android:layout_marginTop="-3dp"
                        android:paddingLeft="@dimen/_20sdp"
                        android:paddingRight="@dimen/_20sdp"
                        android:gravity="center"
                        android:text="Refer More "
                        android:textColor="@color/on_brand_text"
                        android:textSize="@dimen/_12sdp"
                        android:textStyle="bold" />


                </LinearLayout>





            </LinearLayout>


            <TextView
                android:layout_marginTop="@dimen/_10sdp"
                android:id="@+id/refered_user_name"
                android:text="Earned for Refering Suresh"
                android:textSize="@dimen/_10sdp"
                android:layout_marginBottom="@dimen/_30sdp"
                android:gravity="top|center"
                android:textStyle="bold"
                android:textColor="@color/on_brand_text"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

            </TextView>



        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:gravity="top|center"
            android:layout_weight="1">

        </LinearLayout>

    </LinearLayout>




</RelativeLayout>