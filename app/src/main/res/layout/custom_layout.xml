<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="center">
    <soup.neumorphism.NeumorphCardView

        android:id="@+id/search_text"
        style="@style/Widget.Neumorph.ImageButton"
        android:layout_below="@+id/basin_image_view"
        android:layout_width="wrap_content"
        android:layout_height="60dp"
        android:gravity="center"
        android:text="Next"
        android:textSize="@dimen/_15sdp"
        app:neumorph_shadowElevation="4dp"
        app:neumorph_shadowColorLight="#DFFFFFFF"
        app:neumorph_shadowColorDark="@color/neomorph_shadow_color"
        android:scaleType="centerInside"
        app:neumorph_strokeWidth="0.3dp"
        app:neumorph_strokeColor="@color/profile_border"
        app:layout_constraintEnd_toEndOf="parent"
        app:neumorph_shapeType="flat" >
        <TextView
            android:id="@+id/language_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:background="@color/chip_background"
            android:paddingLeft="18dp"
            android:paddingRight="18dp"
            android:text="Nilesh"
            android:textColor="@color/chip_text_color"
            android:textSize="@dimen/_16sdp"
            android:textStyle="normal" />



    </soup.neumorphism.NeumorphCardView>

    <soup.neumorphism.NeumorphCardView
        android:visibility="gone"
        android:id="@+id/selected_search_text"
        style="@style/Widget.Neumorph.ImageButton"
        android:layout_below="@+id/basin_image_view"
        android:layout_width="wrap_content"
        android:layout_height="60dp"
        android:gravity="center"
        android:text="Next"
        android:textSize="@dimen/_15sdp"
        app:neumorph_shadowElevation="4dp"
        app:neumorph_shadowColorLight="#DFFFFFFF"
        app:neumorph_shadowColorDark="@color/neomorph_shadow_color"
        android:scaleType="centerInside"
        app:neumorph_strokeWidth="0.5dp"
        app:neumorph_strokeColor="#F63F05"
        app:layout_constraintEnd_toEndOf="parent"
        app:neumorph_shapeType="flat" >
        <TextView
            android:id="@+id/selected_language_name"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:gravity="center"
            android:background="@color/red_one"
            android:paddingLeft="18dp"
            android:paddingRight="18dp"
            android:text="Nilesh"
            android:drawableLeft="@drawable/ic_white_icon"
            android:textColor="@color/on_brand_text"
            android:textSize="@dimen/_16sdp"
            android:textStyle="normal" />



    </soup.neumorphism.NeumorphCardView>

</LinearLayout>

