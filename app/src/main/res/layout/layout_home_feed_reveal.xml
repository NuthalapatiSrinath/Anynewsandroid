<?xml version="1.0" encoding="utf-8"?>
<!--
  Feed skeleton (matches article half-layout):
  • Top ~45%: full-bleed light-grey media block
  • Below: body-copy text letter-bars (mixed widths)
  L→R shimmer sweeps the bones only (not a full-page white wipe).
-->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:parentTag="android.widget.FrameLayout"
    tools:layout_width="match_parent"
    tools:layout_height="match_parent">

    <!-- Theme surface behind bones (white day / dark night) -->
    <View
        android:id="@+id/feed_reveal_surface"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/feed_shimmer_surface"
        android:importantForAccessibility="no" />

    <!--
      Clip bounds = skeleton bones (media + text). Wipe stays inside this box.
      Reuses feed_reveal_text_clip id so HomeFeedRevealView keeps working.
    -->
    <FrameLayout
        android:id="@+id/feed_reveal_text_clip"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="true"
        android:clipToPadding="true">

        <LinearLayout
            android:id="@+id/feed_reveal_stage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:weightSum="100">

            <!-- Image zone: ~45% solid full-width flat bone (no insets, no radius) -->
            <View
                android:id="@+id/feed_reveal_media"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="45"
                android:background="@drawable/feed_reveal_media_block"
                android:importantForAccessibility="no" />

            <!-- Body text bones: remaining space, article-like margins -->
            <LinearLayout
                android:id="@+id/feed_reveal_text_lines"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="55"
                android:orientation="vertical"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:paddingTop="20dp"
                android:paddingBottom="24dp">

                <!-- Mixed lengths: first shorter, middle full, last couple shorter -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <View
                        android:layout_width="0dp"
                        android:layout_height="10dp"
                        android:layout_weight="75"
                        android:background="@drawable/feed_reveal_text_soft" />
                    <Space
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="25" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="10dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/feed_reveal_text_soft" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="10dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/feed_reveal_text_soft" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="10dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/feed_reveal_text_soft" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="10dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/feed_reveal_text_soft" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="10dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/feed_reveal_text_soft" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="10dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/feed_reveal_text_soft" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="10dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/feed_reveal_text_soft" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="10dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/feed_reveal_text_soft" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="10dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/feed_reveal_text_soft" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="10dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/feed_reveal_text_soft" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">
                    <View
                        android:layout_width="0dp"
                        android:layout_height="10dp"
                        android:layout_weight="95"
                        android:background="@drawable/feed_reveal_text_soft" />
                    <Space
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="5" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">
                    <View
                        android:layout_width="0dp"
                        android:layout_height="10dp"
                        android:layout_weight="85"
                        android:background="@drawable/feed_reveal_text_soft" />
                    <Space
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="15" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Soft L→R beam: height = full bones stage (media + text) -->
        <View
            android:id="@+id/feed_reveal_wipe_band"
            android:layout_width="88dp"
            android:layout_height="match_parent"
            android:background="@drawable/feed_reveal_wipe_edge"
            android:importantForAccessibility="no" />
    </FrameLayout>

    <!-- Legacy IDs kept so older code stays safe -->
    <View
        android:id="@+id/feed_reveal_card_1"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <View
        android:id="@+id/feed_reveal_card_2"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <View
        android:id="@+id/feed_reveal_card_3"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <View
        android:id="@+id/feed_reveal_veil"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />
</merge>
