<?xml version="1.0" encoding="utf-8"?>
<!-- WhatsApp-style full-bleed profile photo viewer -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/profile_photo_viewer_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:clickable="true"
    android:focusable="true">

    <ImageView
        android:id="@+id/profile_photo_viewer_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/profile_change_photo"
        android:scaleType="fitCenter" />

    <ImageButton
        android:id="@+id/profile_photo_viewer_close"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="top|start"
        android:layout_margin="12dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@android:string/cancel"
        android:padding="10dp"
        android:src="@android:drawable/ic_menu_close_clear_cancel"
        android:tint="#FFFFFF" />

    <TextView
        android:id="@+id/profile_photo_viewer_change"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="20dp"
        android:background="@drawable/bg_profile_change_photo_chip"
        android:elevation="4dp"
        android:paddingLeft="20dp"
        android:paddingTop="12dp"
        android:paddingRight="20dp"
        android:paddingBottom="12dp"
        android:text="@string/profile_change_photo"
        android:textColor="@color/on_brand_text"
        android:textSize="14sp"
        android:textStyle="bold" />

</FrameLayout>
