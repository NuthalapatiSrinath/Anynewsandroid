<?xml version="1.0" encoding="utf-8"?>
<!--
  Footer BottomNavigationView icon + label colors.
  Checked/selected = brand orange; default = light inactive gray / dark light-gray
  (see values / values-night bottom_nav_inactive).
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="@color/colorPrimary" android:state_checked="true"/>
    <item android:color="@color/colorPrimary" android:state_selected="true"/>
    <item android:color="@color/colorPrimary" android:state_pressed="true"/>
    <item android:color="@color/bottom_nav_inactive"/>
</selector>