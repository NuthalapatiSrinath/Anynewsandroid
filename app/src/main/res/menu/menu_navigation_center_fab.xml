<?xml version="1.0" encoding="utf-8"?>
<menu
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".Activities.HomePage">

    <!-- Order L→R when the center share slot is hidden:
         News | Special | Daily Updates | Profile.
         navigation_stricker sits between Special and Daily Updates so magazine /
         special galleries can open an empty middle column (blinking Share) without
         covering the Special tab. Panchangam stays product-hidden
         (ProfileHubConfigHelper.isFooterShowCalendar) — open from Daily Updates. -->
    <item
        android:checked="true"
        android:id="@+id/navigation_home"
        android:icon="@drawable/refresh_icon"
        android:title="@string/news_back" />

    <!-- Slot 2: Special. Id stays navigation_catagiries for menu / admin-flag stability. -->
    <item
        android:id="@+id/navigation_catagiries"
        android:icon="@drawable/ic_footer_special"
        android:title="@string/Events" />

    <!-- Middle column between Special and Daily Updates.
         Magazine / special: empty slot under the blinking Share control.
         Every other article: empty slot under the WhatsApp control.
         Id stays navigation_stricker. Not the Special tab. -->
    <item
        android:id="@+id/navigation_stricker"
        android:icon="@drawable/ic_footer_panchangam"
        android:title="@string/calendar_seg_panchangam"
        android:visible="false" />

    <!-- Daily Updates. Id stays navigation_status for menu / admin-flag stability. -->
    <item
        android:id="@+id/navigation_status"
        android:icon="@drawable/ic_footer_daily_updates"
        android:title="@string/daily_updates" />

    <item
        android:id="@+id/navigation_profile"
        android:icon="@drawable/ic_nav_profile"
        android:title="@string/Profile" />
</menu>
