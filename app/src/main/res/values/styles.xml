<resources>

    <!-- Cricket Match Center custom tab -->
    <style name="CmpTab">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/cmp_text_secondary</item>
        <item name="android:background">?attr/selectableItemBackground</item>
    </style>

    <!-- Base application theme — DayNight so values-night colors apply cleanly without Force Dark. -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">

        <item name="android:forceDarkAllowed">false</item>

        <!-- Customize your theme here. -->v
        <item name="colorPrimary">@color/brand_orange</item>
        <item name="colorPrimaryDark">@color/brand_orange</item>
        <item name="colorAccent">@color/brand_orange</item>
        <item name="android:windowContentTransitions">true</item>
        <item name="android:windowBackground">@color/whitewithblack</item>
        <item name="android:textColorPrimary">@color/text_color_primary</item>
        <item name="android:textColorSecondary">@color/colorTextSecondary</item>
        <item name="android:textColorHint">@color/whitesren</item>
        <item name="colorControlNormal">@color/colorTextSecondary</item>
        <item name="colorControlActivated">@color/brand_orange</item>
        <!-- Neumorph shadow tokens (light looks same; night avoids white fringe). -->
        <item name="colorShadowLight">@color/neomorph_highlight_color</item>
        <item name="colorShadowDark">@color/neomorph_shadow_color</item>
        <item name="android:statusBarColor">@color/background_color</item>
        <item name="android:navigationBarColor">@color/background_color</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>

    </style>

    <!-- CanHub CropImageActivity needs an ActionBar for Crop / rotate menu items.
         Do NOT use AppTheme (NoActionBar) here — that breaks the crop toolbar. -->
    <style name="CropImageTheme" parent="Theme.AppCompat.DayNight.DarkActionBar">
        <item name="android:forceDarkAllowed">false</item>
        <item name="colorPrimary">@color/brand_orange</item>
        <item name="colorPrimaryDark">@color/brand_orange</item>
        <item name="colorAccent">@color/brand_orange</item>
        <item name="android:windowBackground">@color/whitewithblack</item>
    </style>

    <style name="AppThemeSplash" parent="Theme.AppCompat.NoActionBar">
        <!-- Customize your theme here. -->v
       <!-- <item name="android:windowBackground">@drawable/splash_bg</item> </style>-->
        <item name="android:background">@drawable/new_bg_sp</item>
        <item name="android:adjustViewBounds">true</item>
    </style>
    <style name="AppThemeBG" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:background">@color/whitewithblack</item>
        <item name="android:backgroundTint">@color/whitewithblack</item>
        <item name="android:windowBackground">@color/whitewithblack</item>
    </style>

    <style name="Theme.AppCompat.Light.NoActionBar.FullScreen" parent="@style/Theme.AppCompat.Light.NoActionBar">

        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowBackground">@drawable/app_bg_splash</item>
    </style>


    <style name="New.Widget.Neumorph.FloatingActionButton" parent="android:Widget">
        <item name="android:padding">@dimen/design_default_padding</item>
        <item name="android:stateListAnimator">@animator/button_state_list_anim_neumorph</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
        <item name="neumorph_inset">@dimen/design_default_inset</item>
        <item name="neumorph_shadowElevation">3dp</item>
        <item name="neumorph_shadowColorLight">?colorShadowLight</item>
        <item name="neumorph_shadowColorDark">?colorShadowDark</item>
        <item name="neumorph_shapeType">flat</item>
        <item name="neumorph_shapeAppearance">@style/ShapeAppearance.Neumorph.FloatingActionButton</item>
    </style>

    <style name="New.Widget.Neumorph.CardView" parent="android:Widget">
        <item name="android:padding">@dimen/two</item>
        <item name="neumorph_inset">@dimen/two</item>
        <item name="neumorph_shadowElevation">3dp</item>
        <item name="neumorph_shadowColorLight">?colorShadowLight</item>
        <item name="neumorph_shadowColorDark">?colorShadowDark</item>
        <item name="neumorph_shapeType">flat</item>
        <item name="neumorph_shapeAppearance">@style/ShapeAppearance.Neumorph.CardView</item>
    </style>

    <style name="TextStyle18">
        <item name="android:textSize">18sp</item>
        <item name="android:fontFamily">@font/montserrat</item>
        <item name="android:textStyle">normal</item>
        <item name="android:lineSpacingExtra">6sp</item>
        <item name="android:textColor">@color/pale_grey</item>
    </style>

    <style name="TextStyle13">
        <item name="android:textSize">18dp</item>
        <item name="android:fontFamily">@font/montserrat</item>
        <item name="android:textStyle">bold</item>
        <item name="android:lineSpacingExtra">2sp</item>
        <item name="android:textColor">@color/color42</item>
    </style>

    <style name="TextStyle23">
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@font/montserrat</item>
        <item name="android:lineSpacingExtra">2sp</item>
        <item name="android:textColor">@color/black</item>
    </style>

    <style name="TextStyle16">
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@font/montserrat</item>
        <item name="android:textStyle">normal</item>
        <item name="android:lineSpacingExtra">3sp</item>
        <item name="android:textColor">@color/post_new_title_text_color</item>
    </style>

    <style name="TextStyle4">
        <item name="android:textSize">11sp</item>
        <item name="android:fontFamily">@font/montserrat</item>
        <item name="android:textStyle">normal</item>
        <item name="android:lineSpacingExtra">4sp</item>
        <item name="android:textColor">@color/red</item>
    </style>

    <style name="TextStyle28">
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">@font/montserrat</item>
        <item name="android:textStyle">normal</item>
        <item name="android:lineSpacingExtra">4sp</item>
        <item name="android:textColor">@color/warm_grey_three</item>
    </style>
    <style name="TextStyle21">
        <item name="android:gravity">center_horizontal</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">@font/montserrat</item>
        <item name="android:textStyle">normal</item>
        <item name="android:lineSpacingExtra">4sp</item>
        <item name="android:textColor">@color/black</item>
    </style>

    <style name="TextStyle20">

        <item name="android:fontFamily">@font/montserrat</item>
        <item name="android:textStyle">normal</item>
        <item name="android:letterSpacing">-0.05</item>
        <item name="android:lineSpacingExtra">3dp</item>
        <item name="android:textColor">#0076ff</item>
    </style>

    <style name="TextStyle25">
        <item name="android:gravity">center_horizontal</item>
        <item name="android:textSize">10sp</item>
        <item name="android:fontFamily">@font/montserrat</item>
        <item name="android:textStyle">normal</item>
        <item name="android:lineSpacingExtra">3sp</item>
        <item name="android:textColor">@color/warm_grey_two</item>
    </style>


    <style name="TextStyle100">
    <item name="android:textSize">18sp</item>
    <item name="android:fontFamily">@font/mallannaregular</item>
    <item name="android:textStyle">bold</item>
    <item name="android:lineSpacingExtra">3sp</item>
    <item name="android:textColor">@color/black</item>

    </style>

    <style name="SwitchTheme" parent="Theme.AppCompat.Light">
        <item name="android:colorControlActivated">@color/red</item>
    </style>
    <style name="ShapeAppearance_profile">
        <item name="neumorph_cornerFamily">rounded</item>
        <item name="neumorph_cornerSize">14dp</item>
    </style>

    <style name="ShapeAppearance">
        <item name="neumorph_cornerFamily">rounded</item>
        <item name="neumorph_cornerSize">4dp</item>
    </style>


    <!-- profile scrren design detailes  -->
    <style name="New_ShapeAppearance.Neumorph.ImageButton" parent="">
        <item name="neumorph_cornerFamily">rounded</item>
        <item name="neumorph_cornerSize">@dimen/_1sdp</item>
    </style>

    <style name="Two_Widget.Neumorph.ImageButton" parent="android:Widget">
        <item name="android:padding">0.5dp</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
        <item name="android:scaleType">center</item>
        <item name="neumorph_inset">@dimen/design_default_inset</item>
        <item name="neumorph_shadowElevation">0dp</item>
        <item name="neumorph_shadowColorLight">?colorShadowLight</item>
        <item name="neumorph_shadowColorDark">?colorShadowDark</item>
        <item name="neumorph_shapeType">flat</item>
        <item name="neumorph_shapeAppearance">@style/New_ShapeAppearance.Neumorph.ImageButton</item>
    </style>

    <style name="Profile_In_Widget.Neumorph.ImageButton" parent="android:Widget">
        <item name="android:padding">@dimen/design_default_padding</item>
        <item name="android:stateListAnimator">@animator/button_state_list_anim_neumorph</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
        <item name="android:scaleType">center</item>
        <item name="neumorph_inset">@dimen/design_default_inset</item>
        <item name="neumorph_shadowElevation">6dp</item>
        <item name="neumorph_shadowColorLight">?colorShadowDark</item>
        <item name="neumorph_shadowColorDark">?colorShadowDark</item>
        <item name="neumorph_shapeType">flat</item>
        <item name="neumorph_shapeAppearance">@style/ShapeAppearance.Neumorph.ImageButton</item>
    </style>

    <style name="ShapeAppearance.Neumorph.ImageButton" parent="">
        <item name="neumorph_cornerFamily">rounded</item>
        <item name="neumorph_cornerSize">@dimen/design_default_corner_radius</item>
    </style>


    <!-- login page-->
    <style name="Login_ShapeAppearance">
        <item name="neumorph_cornerFamily">rounded</item>
        <item name="neumorph_cornerSize">20dp</item>
    </style>


    <style name="Full_Imageview_CustomShapeAppearance">
        <item name="neumorph_cornerFamily">rounded</item>
        <item name="neumorph_cornerSize">2dp</item>
        <item name="neumorph_cornerSizeTopLeft">0dp</item>
        <item name="neumorph_cornerSizeTopRight">0dp</item>
        <item name="neumorph_cornerSizeBottomRight">28dp</item>
        <item name="neumorph_cornerSizeBottomLeft">28dp</item>
    </style>

    <style name="Full_Image_Widget.Neumorph.FloatingActionButton" parent="android:Widget">
        <item name="android:padding">0dp</item>
        <item name="android:focusable">false</item>
        <item name="android:clickable">false</item>
        <item name="neumorph_inset">0dp</item>
        <item name="neumorph_shadowElevation">0dp</item>
        <item name="neumorph_shadowColorLight">@color/neomorph_highlight_color</item>
        <item name="neumorph_shadowColorDark">@color/neomorph_highlight_color</item>
        <item name="neumorph_shapeType">flat</item>
        <item name="neumorph_shapeAppearance">@style/ShapeAppearance.Neumorph.FloatingActionButton</item>
    </style>

    <style name="RatingBar" parent="Theme.AppCompat">
        <item name="colorControlNormal">@color/colorGray</item>
        <item name="colorControlActivated">@color/red</item>
    </style>

    <style name="AppTheme.AdAttribution">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">right</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">12sp</item>
        <item name="android:text">AD</item>
        <item name="android:background">#FFCC66</item>
    </style>


    <style name="AdAttribution">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">left</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">12sp</item>
        <item name="android:text">@string/ad_attribution</item>
        <item name="android:background">#FFCC66</item>
        <item name="android:width">15dp</item>
        <item name="android:height">15dp</item>
    </style>


    <style name="BottomNavLabelActive" parent="TextAppearance.AppCompat.Caption">
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="BottomNavLabelInactive" parent="TextAppearance.AppCompat.Caption">
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">11sp</item>
    </style>

    <style name="AppStarting" parent="Theme.SplashScreen">
        <!-- Set the splash screen background, animated icon, and animation
        duration. -->
        <item name="windowSplashScreenBackground">@color/white</item>

        <!-- Use windowSplashScreenAnimatedIcon to add a drawable or an animated
             drawable. One of these is required. -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_bg</item>
        <!-- Required for animated icons. -->
        <item name="windowSplashScreenAnimationDuration">200</item>

        <!-- Set the theme of the Activity that directly follows your splash
        screen. This is required. -->
        <item name="postSplashScreenTheme">@style/AppThemeSplash</item>
    </style>
</resources>
