<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer glow — stronger / brighter than previous so selection reads clearly -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:centerColor="#CCFFB020"
                android:endColor="#00FF8A00"
                android:gradientRadius="50%"
                android:startColor="#FFFFE08A"
                android:type="radial" />
        </shape>
    </item>
    <!-- Soft fill behind icon -->
    <item
        android:bottom="5dp"
        android:left="5dp"
        android:right="5dp"
        android:top="5dp">
        <shape android:shape="oval">
            <solid android:color="#55FF9800" />
        </shape>
    </item>
    <!-- High-contrast ring -->
    <item
        android:bottom="4dp"
        android:left="4dp"
        android:right="4dp"
        android:top="4dp">
        <shape android:shape="oval">
            <stroke
                android:width="3.5dp"
                android:color="#FFFFC857" />
            <solid android:color="#00000000" />
        </shape>
    </item>
</layer-list>
