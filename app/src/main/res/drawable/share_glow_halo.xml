<?xml version="1.0" encoding="utf-8"?>
<!--
  Soft glowing orange aura placed BEHIND the Share icon.
  Radial gradient that fades to fully transparent at the edges — a breathing
  halo, NOT a hard ring / stroke outline. Pulsed (scale + alpha) from code.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <gradient
        android:type="radial"
        android:gradientRadius="50%"
        android:startColor="#E6FF8A1F"
        android:centerColor="#66FF6A00"
        android:endColor="#00FF6A00" />
</shape>
