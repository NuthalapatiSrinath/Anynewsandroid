<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/rewards_ink_raised" />
            <corners android:radius="22dp" />
            <stroke
                android:width="1dp"
                android:color="#73E4C27A" />
        </shape>
    </item>
    <!-- Soft inner glow under the crest, not a loud gradient card. -->
    <item
        android:bottom="1dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:centerX="0.82"
                android:centerY="0.28"
                android:endColor="#0012182B"
                android:gradientRadius="168dp"
                android:startColor="#47E4C27A"
                android:type="radial" />
            <corners android:radius="21dp" />
        </shape>
    </item>
</layer-list>
