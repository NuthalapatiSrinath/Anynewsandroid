<?xml version="1.0" encoding="utf-8"?>
<!-- Language/location icon circle: solid orange (night) / outlined (day). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="@color/profile_way2_icon_circle_fill" />
    <stroke
        android:width="1.5dp"
        android:color="@color/profile_way2_icon_circle_stroke" />
    <size
        android:width="40dp"
        android:height="40dp" />
</shape>
