<?xml version="1.0" encoding="utf-8"?>
<!-- Market index card: layered dark fill + soft top highlight feel via gradient. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:endColor="#FF0A0F1C"
        android:startColor="#FF151C2E" />
    <corners android:radius="14dp" />
    <stroke
        android:width="1dp"
        android:color="#FF3B4566" />
</shape>
