<?xml version="1.0" encoding="utf-8"?>
<!--
  Dark rounded clip for Mana Zilla. Single stroke only — no glow layer.
  (PNG art may still paint interior chrome; stroke here is the sole outer edge.)
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#FF070A14" />
    <stroke
        android:width="1.5dp"
        android:color="#FFE879B9" />
    <corners android:radius="16dp" />
</shape>
