<?xml version="1.0" encoding="utf-8"?>
<!-- Fallback solid orange hero (used when the stadium photo is unavailable).
     The live Match Center header prefers bg_cmp_stadium_photo + overlay. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="@color/cmp_brand_orange_2"
                android:centerColor="@color/cmp_brand_orange"
                android:endColor="#D6390F"
                android:angle="270" />
        </shape>
    </item>
</layer-list>
